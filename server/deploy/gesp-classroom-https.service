[Unit]
Description=GESP classroom HTTPS endpoint
After=network-online.target gesp-classroom.service
Wants=network-online.target

[Service]
DynamicUser=true
StateDirectory=gesp-classroom-https
Environment=XDG_DATA_HOME=/var/lib/gesp-classroom-https
Environment=XDG_CONFIG_HOME=/var/lib/gesp-classroom-https
ExecStart=/opt/gesp-runtime/caddy run --config /opt/gesp-classroom/server/deploy/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=3
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
