{"id":"28.10.1","doc":"T","title":"Channel Mode Control","words":39,"blocks":[{"t":"p","s":[{"n":1,"c":[{"t":"text","v":"ESP32-S3 "},{"t":"block","v":"I2S","id":"i2s"},{"t":"i","c":[{"t":"text","v":"n"}]},{"t":"text","v":" supports both TDM RX mode and PDM RX mode."}]},{"n":2,"c":[{"t":"text","v":"Set "},{"t":"field","v":"I2S_RX_TDM_EN"},{"t":"text","v":" to enable TDM RX mode, or set "},{"t":"field","v":"I2S_RX_PDM_EN"},{"t":"text","v":" to enable PDM RX mode."}]}]},{"t":"p","s":[{"n":3,"c":[{"t":"text","v":"Note: "},{"t":"field","v":"I2S_RX_TDM_EN"},{"t":"text","v":" and "},{"t":"field","v":"I2S_RX_PDM_EN"},{"t":"text","v":" must not be cleared or set simultaneously."}],"warn":true}]}]}