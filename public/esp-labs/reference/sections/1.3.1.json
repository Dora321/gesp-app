{"id":"1.3.1","doc":"T","title":"Bank of Vector Registers","words":56,"blocks":[{"t":"p","s":[{"n":1,"c":[{"t":"text","v":"Bank of vector registers contains 8 vector registers (QR)."}]},{"n":2,"c":[{"t":"text","v":"Each register could be represented as an array of 16 x "},{"t":"num","v":"8-bit","k":"size"},{"t":"text","v":" data words, array of 8 x "},{"t":"num","v":"16-bit","k":"size"},{"t":"text","v":" data words, or array of 4 x "},{"t":"num","v":"32-bit","k":"size"},{"t":"text","v":" data words."}]},{"n":3,"c":[{"t":"text","v":"Depending on the used instructions, 8, 16 or "},{"t":"num","v":"32-bit","k":"size"},{"t":"text","v":" data format will be chosen."}]}]}]}