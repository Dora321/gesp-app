{"id":"30.5.8.1","doc":"T","title":"State Machine","words":410,"blocks":[{"t":"p","s":[{"n":1,"c":[{"t":"text","v":"When "},{"t":"block","v":"GP-SPI","id":"spi"},{"t":"text","v":" works as a master, the state machine controls its various states during data transfer, including configuration (CONF), preparation (PREP), command (CMD), address (ADDR), dummy (DUMMY), data out (DOUT), and data in (DIN) states."}]},{"n":2,"c":[{"t":"text","v":"GP-SPI is mainly used to access 1/2/4/"},{"t":"num","v":"8-bit","k":"size"},{"t":"text","v":" SPI devices, such as flash and external RAM, thus the naming of GP-SPI states keeps consistent with the sequence naming of flash and external RAM."}]},{"n":3,"c":[{"t":"text","v":"The meaning of each state is described as follows and Figure 30.5-5 shows the workflow of GP-SPI state machine."}]}]},{"t":"list","ordered":true,"items":[[{"t":"p","s":[{"n":4,"c":[{"t":"text","v":"IDLE: GP-SPI is not active or is in slave mode."}]}]}],[{"t":"p","s":[{"n":5,"c":[{"t":"text","v":"CONF: only used in DMA-controlled configurable segmented transfer (valid only for GP-SPI2)."}]},{"n":6,"c":[{"t":"text","v":"Set "},{"t":"field","v":"SPI_USR"},{"t":"text","v":" and SPI_USR_CONF to enable this state."}]},{"n":7,"c":[{"t":"text","v":"If this state is not enabled, it means the current transfer is a single transfer."}]}]}],[{"t":"p","s":[{"n":8,"c":[{"t":"text","v":"PREP: prepare an SPI transaction and control SPI CS setup time."}]},{"n":9,"c":[{"t":"text","v":"Set "},{"t":"field","v":"SPI_USR"},{"t":"text","v":" and "},{"t":"field","v":"SPI_CS_SETUP"},{"t":"text","v":" to enable this state."}]}]}],[{"t":"p","s":[{"n":10,"c":[{"t":"text","v":"CMD: send command sequence."}]},{"n":11,"c":[{"t":"text","v":"Set "},{"t":"field","v":"SPI_USR"},{"t":"text","v":" and "},{"t":"field","v":"SPI_USR_COMMAND"},{"t":"text","v":" to enable this state."}]}]}],[{"t":"p","s":[{"n":12,"c":[{"t":"text","v":"ADDR: send address sequence."}]},{"n":13,"c":[{"t":"text","v":"Set "},{"t":"field","v":"SPI_USR"},{"t":"text","v":" and "},{"t":"field","v":"SPI_USR_ADDR"},{"t":"text","v":" to enable this state."}]}]}],[{"t":"p","s":[{"n":14,"c":[{"t":"text","v":"DUMMY (wait cycle): send dummy sequence."}]},{"n":15,"c":[{"t":"text","v":"Set "},{"t":"field","v":"SPI_USR"},{"t":"text","v":" and "},{"t":"field","v":"SPI_USR_DUMMY"},{"t":"text","v":" to enable this state."}]}]}],[{"t":"p","s":[{"n":16,"c":[{"t":"text","v":"DATA: transfer data."}]}]},{"t":"list","ordered":false,"items":[[{"t":"p","s":[{"n":17,"c":[{"t":"text","v":"DOUT: send data sequence."}]},{"n":18,"c":[{"t":"text","v":"Set "},{"t":"field","v":"SPI_USR"},{"t":"text","v":" and "},{"t":"field","v":"SPI_USR_MOSI"},{"t":"text","v":" to enable this state."}]}]}],[{"t":"p","s":[{"n":19,"c":[{"t":"text","v":"DIN: receive data sequence."}]},{"n":20,"c":[{"t":"text","v":"Set "},{"t":"field","v":"SPI_USR"},{"t":"text","v":" and "},{"t":"field","v":"SPI_USR_MISO"},{"t":"text","v":" to enable this state."}]}]}]]}],[{"t":"p","s":[{"n":21,"c":[{"t":"text","v":"DONE: control SPI CS hold time."}]},{"n":22,"c":[{"t":"text","v":"Set "},{"t":"field","v":"SPI_USR"},{"t":"text","v":" to enable this state."}]}]}]]},{"t":"fig","src":"images/trm-fig-30_5-5.png","alt":"Figure 30.5-5. GP-SPI State Machine in Master Mode"},{"t":"p","s":[{"n":23,"c":[{"t":"text","v":"Legend to state flow:"}]}]},{"t":"list","ordered":false,"items":[[{"t":"p","s":[{"n":24,"c":[{"t":"text","v":"Arrow type 1: corresponding state condition is not satisfied; repeats current state."}]}]}],[{"t":"p","s":[{"n":25,"c":[{"t":"text","v":"Arrow type 2: corresponding registers are set and conditions are satisfied; goes to next state."}]}]}],[{"t":"p","s":[{"n":26,"c":[{"t":"text","v":"Arrow type 3: state registers are not set; skips one or more following states, depending on the registers of the following states are set or not."}]}]}]]},{"t":"p","s":[{"n":27,"c":[{"t":"text","v":"Explanation of the conditions listed in the figure above:"}]}]},{"t":"list","ordered":false,"items":[[{"t":"p","s":[{"n":28,"c":[{"t":"text","v":"CONF condition: gpc[17:0] >= SPI_CONF_BITLEN[17:0]"}]}]}],[{"t":"p","s":[{"n":29,"c":[{"t":"text","v":"PREP condition: gpc[4:0] >= "},{"t":"field","v":"SPI_CS_SETUP_TIME"},{"t":"text","v":"[4:0]"}]}]}],[{"t":"p","s":[{"n":30,"c":[{"t":"text","v":"CMD condition: gpc[3:0] >= "},{"t":"field","v":"SPI_USR_COMMAND_BITLEN"},{"t":"text","v":"[3:0]"}]}]}],[{"t":"p","s":[{"n":31,"c":[{"t":"text","v":"ADDR condition: gpc[4:0] >= "},{"t":"field","v":"SPI_USR_ADDR_BITLEN"},{"t":"text","v":"[4:0]"}]}]}],[{"t":"p","s":[{"n":32,"c":[{"t":"text","v":"DUMMY condition: gpc[7:0] >= "},{"t":"field","v":"SPI_USR_DUMMY_CYCLELEN"},{"t":"text","v":"[7:0]"}]}]}],[{"t":"p","s":[{"n":33,"c":[{"t":"text","v":"DOUT condition: gpc[17:0] >= "},{"t":"field","v":"SPI_MS_DATA_BITLEN"},{"t":"text","v":"[17:0]"}]}]}],[{"t":"p","s":[{"n":34,"c":[{"t":"text","v":"DIN condition: gpc[17:0] >= "},{"t":"field","v":"SPI_MS_DATA_BITLEN"},{"t":"text","v":"[17:0]"}]}]}],[{"t":"p","s":[{"n":35,"c":[{"t":"text","v":"DONE condition: (gpc[4:0] >= "},{"t":"field","v":"SPI_CS_HOLD_TIME"},{"t":"text","v":"[4:0] || "},{"t":"field","v":"SPI_CS_HOLD"},{"t":"text","v":" == 1'b0)"}]}]}]]},{"t":"p","s":[{"n":36,"c":[{"t":"text","v":"A counter (gpc[17:0]) is used in the state machine to control the cycle length of each state."}]},{"n":37,"c":[{"t":"text","v":"The states CONF, PREP, CMD, ADDR, DUMMY, DOUT, and DIN can be enabled or disabled independently."}]},{"n":38,"c":[{"t":"text","v":"The cycle length of each state can also be configured independently."}]}]}]}