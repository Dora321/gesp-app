{"id":"1.8.50","doc":"T","title":"EE.SRC.Q.LD.IP","words":175,"blocks":[{"t":"p","s":[{"n":1,"c":[{"t":"b","c":[{"t":"text","v":"Instruction Word"}]},{"t":"text","v":" (bit layout, little-endian bit order)"}]}]},{"t":"table","head":[[{"t":"text","v":"111000"}],[{"t":"text","v":"imm16[7:6]"}],[{"t":"text","v":"imm16[2]"}],[{"t":"text","v":"qs1[2:0]"}],[{"t":"text","v":"imm16[5]"}],[{"t":"text","v":"qu[2:0]"}],[{"t":"text","v":"qs0[1:0]"}],[{"t":"text","v":"imm16[4:3]"}],[{"t":"text","v":"00"}],[{"t":"text","v":"imm16[1:0]"}],[{"t":"text","v":"as[3:0]"}],[{"t":"text","v":"111"}],[{"t":"text","v":"qs0[2]"}]],"rows":[{"n":2,"c":[[{"t":"text","v":"6"}],[{"t":"text","v":"2"}],[{"t":"text","v":"1"}],[{"t":"text","v":"3"}],[{"t":"text","v":"1"}],[{"t":"text","v":"3"}],[{"t":"text","v":"2"}],[{"t":"text","v":"2"}],[{"t":"text","v":"2"}],[{"t":"text","v":"2"}],[{"t":"text","v":"4"}],[{"t":"text","v":"3"}],[{"t":"text","v":"1"}]]}]},{"t":"p","s":[{"n":3,"c":[{"t":"b","c":[{"t":"text","v":"Assembler Syntax"}]}]}]},{"t":"pre","v":"EE.SRC.Q.LD.IP qu, as, -2048..2032, qs0, qs1","lang":"text"},{"t":"p","s":[{"n":4,"c":[{"t":"b","c":[{"t":"text","v":"Description"}]}]}]},{"t":"p","s":[{"n":5,"c":[{"t":"text","v":"This instruction performs an arithmetic right shift on the 32-byte concatenation of registers qs0 and qs1 that hold the loaded data of two consecutive aligned addresses."}]},{"n":6,"c":[{"t":"text","v":"By this way, you can obtain unaligned 16-byte data, which will be written to register qs0."}]},{"n":7,"c":[{"t":"text","v":"The right shift amount is SAR_BYTE multiplied by 8."}]}]},{"t":"p","s":[{"n":8,"c":[{"t":"text","v":"At the same time, the lower 4 bits of the access address in register as are forced to be 0, and then the 16-byte data is loaded from the memory to register qu."}]},{"n":9,"c":[{"t":"text","v":"After the access is completed, the value in register as is incremented by "},{"t":"num","v":"8-bit","k":"size"},{"t":"text","v":" sign-extended constant in the instruction code segment left-shifted by 4."}]}]},{"t":"p","s":[{"n":10,"c":[{"t":"b","c":[{"t":"text","v":"Operation"}]}]}]},{"t":"pre","v":"qs0[127:0] = {qs1[127:0], qs0[127:0]} >> {SAR_BYTE[3:0] << 3}\nqu[127:0] = load128({as[31:4],4{0}})\nas[31:0] = as[31:0] + {20{imm16[7]},imm16[7:0],4{0}}","lang":"text"}]}