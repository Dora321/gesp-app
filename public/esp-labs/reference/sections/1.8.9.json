{"id":"1.8.9","doc":"T","title":"EE.FFT.AMS.S16.LD.R32.DECP","words":282,"blocks":[{"t":"p","s":[{"n":1,"c":[{"t":"b","c":[{"t":"text","v":"Instruction Word"}]},{"t":"text","v":" (bit layout, little-endian bit order)"}]}]},{"t":"table","head":[[{"t":"text","v":"110110"}],[{"t":"text","v":"sel2[0]"}],[{"t":"text","v":"qz1[2]"}],[{"t":"text","v":"qz[0]"}],[{"t":"text","v":"qy[2:0]"}],[{"t":"text","v":"qz1[1]"}],[{"t":"text","v":"qm[2:0]"}],[{"t":"text","v":"qx[1:0]"}],[{"t":"text","v":"qz[2:1]"}],[{"t":"text","v":"qz1[0]"}],[{"t":"text","v":"qu[2:0]"}],[{"t":"text","v":"as[3:0]"}],[{"t":"text","v":"111"}],[{"t":"text","v":"qx[2]"}]],"rows":[{"n":2,"c":[[{"t":"text","v":"6"}],[{"t":"text","v":"1"}],[{"t":"text","v":"1"}],[{"t":"text","v":"1"}],[{"t":"text","v":"3"}],[{"t":"text","v":"1"}],[{"t":"text","v":"3"}],[{"t":"text","v":"2"}],[{"t":"text","v":"2"}],[{"t":"text","v":"1"}],[{"t":"text","v":"3"}],[{"t":"text","v":"4"}],[{"t":"text","v":"3"}],[{"t":"text","v":"1"}]]}]},{"t":"p","s":[{"n":3,"c":[{"t":"b","c":[{"t":"text","v":"Assembler Syntax"}]}]}]},{"t":"pre","v":"EE.FFT.AMS.S16.LD.R32.DECP qu, as, qz, qz1, qx, qy, qm, sel2","lang":"text"},{"t":"p","s":[{"n":4,"c":[{"t":"b","c":[{"t":"text","v":"Description"}]}]}]},{"t":"p","s":[{"n":5,"c":[{"t":"text","v":"It is a dedicated FFT instruction to perform addition, subtraction, multiplication, addition and subtraction, and shift operations on "},{"t":"num","v":"16-bit","k":"size"},{"t":"text","v":" data segments."}]}]},{"t":"p","s":[{"n":6,"c":[{"t":"text","v":"During the operation, the instruction forces the lower 4 bits of the access address in register as to 0 and loads the 16-byte data from the memory to register qu in the big-endian word order, namely, loads the segment [127: 96] of the data to [31:0] of qu."}]},{"n":7,"c":[{"t":"text","v":"After the access is completed, the value in register as is decreased by 16."}]}]},{"t":"p","s":[{"n":8,"c":[{"t":"b","c":[{"t":"text","v":"Operation"}]}]}]},{"t":"pre","v":"  temp0[15:0] = qx[ 79: 64] + qy[ 79: 64]\n  temp1[15:0] = qx[ 95: 80] - qy[ 95: 80]\n\nif sel2==0:\n  temp2[15:0] = ((qx[ 79: 64] - qy[ 79: 64]) * qm[ 79: 64] - (qx[ 95: 80] + qy[ 95: 80]) * qm[ 95: 80]) >> SAR\n  temp3[15:0] = ((qx[ 79: 64] - qy[ 79: 64]) * qm[ 95: 80] + (qx[ 95: 80] + qy[ 95: 80]) * qm[ 79: 64]) >> SAR\nif sel2==1:\n  temp2[15:0] = ((qx[ 95: 80] + qy[ 95: 80]) * qm[ 95: 80] + (qx[ 79: 64] - qy[ 79: 64]) * qm[ 79: 64]) >> SAR\n  temp3[15:0] = ((qx[ 95: 80] + qy[ 95: 80]) * qm[ 79: 64] - (qx[ 79: 64] - qy[ 79: 64]) * qm[ 95: 80]) >> SAR\n\n  qz[79: 64] = temp0[15:0] + temp2[15:0]\n  qz[95: 80] = temp1[15:0] + temp3[15:0]\n  qz1[79:64] = temp0[15:0] - temp2[15:0]\n  qz1[95:80] = temp3[15:0] - temp1[15:0]\n  {qu[31: 0], qu[63: 32], qu[95: 64], qu[127: 96]} = load128({as[31:4],4{0}})\n  as[31:0] = as[31:0] - 16","lang":"text"}]}