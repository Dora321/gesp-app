{"id":"39.3.7.7","doc":"T","title":"ADC Filters","words":139,"blocks":[{"t":"p","s":[{"n":1,"c":[{"t":"text","v":"The DIG "},{"t":"block","v":"ADC1","id":"adc"},{"t":"text","v":" controller provide two filters for automatic filtering of sampled ADC data."}]},{"n":2,"c":[{"t":"text","v":"Both filters can be configured to any two channels of SAR ADC and then filter the sampled data for the target channel."}]},{"n":3,"c":[{"t":"text","v":"The filter's formula is shown below:"}]}]},{"t":"p","s":[{"n":4,"c":[{"t":"text","v":"data"},{"t":"sub","v":"cur"},{"t":"text","v":" = ((k − 1) × data"},{"t":"sub","v":"prev"},{"t":"text","v":") / k + data"},{"t":"sub","v":"in"},{"t":"text","v":" / k + 0.5"}]}]},{"t":"list","ordered":false,"items":[[{"t":"p","s":[{"n":5,"c":[{"t":"text","v":"data"},{"t":"sub","v":"cur"},{"t":"text","v":": the filtered data value."}]}]}],[{"t":"p","s":[{"n":6,"c":[{"t":"text","v":"data"},{"t":"sub","v":"in"},{"t":"text","v":": the sampled data value from the SAR ADC."}]}]}],[{"t":"p","s":[{"n":7,"c":[{"t":"text","v":"data"},{"t":"sub","v":"prev"},{"t":"text","v":": the last filtered data value."}]}]}],[{"t":"p","s":[{"n":8,"c":[{"t":"text","v":"k: the filter coefficient."}]}]}]]},{"t":"p","s":[{"n":9,"c":[{"t":"text","v":"The filters are configured as follows:"}]}]},{"t":"list","ordered":false,"items":[[{"t":"p","s":[{"n":10,"c":[{"t":"text","v":"Configure APB_SARADC_FILTER_CHANNEL"},{"t":"i","c":[{"t":"text","v":"x"}]},{"t":"text","v":" to select the SAR ADC channel for filter "},{"t":"i","c":[{"t":"text","v":"x"}]},{"t":"text","v":";"}]}]}],[{"t":"p","s":[{"n":11,"c":[{"t":"text","v":"Configure APB_SARADC_FILTER_FACTOR"},{"t":"i","c":[{"t":"text","v":"x"}]},{"t":"text","v":" to set the coefficient for filter "},{"t":"i","c":[{"t":"text","v":"x"}]},{"t":"text","v":"."}]}]}]]},{"t":"p","s":[{"n":12,"c":[{"t":"text","v":"Note that "},{"t":"i","c":[{"t":"text","v":"x"}]},{"t":"text","v":" is used here as the placeholder of filter index."}]},{"n":13,"c":[{"t":"text","v":"0: filter 0; 1: filter 1."}]}]}]}