{"id":"28.11.2","doc":"T","title":"Configure I2Sn as RX Mode","words":167,"blocks":[{"t":"p","s":[{"n":1,"c":[{"t":"text","v":"Follow the steps below to configure "},{"t":"block","v":"I2S","id":"i2s"},{"t":"i","c":[{"t":"text","v":"n"}]},{"t":"text","v":" as RX mode via software:"}]}]},{"t":"list","ordered":true,"items":[[{"t":"p","s":[{"n":2,"c":[{"t":"text","v":"Configure the clock as described in "},{"t":"xref","id":"28.6","c":[{"t":"text","v":"Section 28.6"}]},{"t":"text","v":"."}]}]}],[{"t":"p","s":[{"n":3,"c":[{"t":"text","v":"Configure signal pins according to Table 28.4-1."}]}]}],[{"t":"p","s":[{"n":4,"c":[{"t":"text","v":"Select the mode needed by configuring the bit "},{"t":"field","v":"I2S_RX_SLAVE_MOD"},{"t":"text","v":"."}]}]},{"t":"list","ordered":false,"items":[[{"t":"p","s":[{"n":5,"c":[{"t":"text","v":"0: master RX mode"}]}]}],[{"t":"p","s":[{"n":6,"c":[{"t":"text","v":"1: slave RX mode"}]}]}]]}],[{"t":"p","s":[{"n":7,"c":[{"t":"text","v":"Set needed RX data mode and RX channel mode as described in "},{"t":"xref","id":"28.10","c":[{"t":"text","v":"Section 28.10"}]},{"t":"text","v":", and then set the bit "},{"t":"field","v":"I2S_RX_UPDATE"},{"t":"text","v":"."}]}]}],[{"t":"p","s":[{"n":8,"c":[{"t":"text","v":"Reset RX unit and its FIFO according to "},{"t":"xref","id":"28.7","c":[{"t":"text","v":"Section 28.7"}]},{"t":"text","v":"."}]}]}],[{"t":"p","s":[{"n":9,"c":[{"t":"text","v":"Enable corresponding interrupts, see "},{"t":"xref","id":"28.12","c":[{"t":"text","v":"Section 28.12"}]},{"t":"text","v":"."}]}]}],[{"t":"p","s":[{"n":10,"c":[{"t":"text","v":"Configure DMA inlink, and set the length of RX data in "},{"t":"reg","v":"I2S_RXEOF_NUM_REG"},{"t":"text","v":"."}]}]}],[{"t":"p","s":[{"n":11,"c":[{"t":"text","v":"Start receiving data:"}]}]},{"t":"list","ordered":false,"items":[[{"t":"p","s":[{"n":12,"c":[{"t":"text","v":"In master mode, when the slave is ready, set "},{"t":"field","v":"I2S_RX_START"},{"t":"text","v":" to start receiving data."}]}]}],[{"t":"p","s":[{"n":13,"c":[{"t":"text","v":"In slave mode, set "},{"t":"field","v":"I2S_RX_START"},{"t":"text","v":" to start receiving data when get BCK and WS signals from the master."}]}]}]]}],[{"t":"p","s":[{"n":14,"c":[{"t":"text","v":"The received data is then stored to the specified address of ESP32-S3 memory according the configuration of DMA."}]},{"n":15,"c":[{"t":"text","v":"Then the corresponding interrupt set in Step 6 is generated."}]}]}]]}]}