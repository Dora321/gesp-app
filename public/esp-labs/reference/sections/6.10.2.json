{"id":"6.10.2","doc":"T","title":"Power Supply Management","words":130,"blocks":[{"t":"p","s":[{"n":1,"c":[{"t":"text","v":"Each ESP32-S3 pin is connected to one of the three different power domains."}]}]},{"t":"list","ordered":false,"items":[[{"t":"p","s":[{"n":2,"c":[{"t":"field","v":"VDD3P3_RTC"},{"t":"text","v":": the input power supply for both RTC and CPU"}]}]}],[{"t":"p","s":[{"n":3,"c":[{"t":"field","v":"VDD3P3_CPU"},{"t":"text","v":": the input power supply for CPU"}]}]}],[{"t":"p","s":[{"n":4,"c":[{"t":"field","v":"VDD_SPI"},{"t":"text","v":": configurable input/output power supply"}]}]}]]},{"t":"p","s":[{"n":5,"c":[{"t":"field","v":"VDD_SPI"},{"t":"text","v":" can be configured to use an internal LDO."}]},{"n":6,"c":[{"t":"text","v":"The LDO input and output both are "},{"t":"num","v":"1.8 V","k":"voltage"},{"t":"text","v":"."}]},{"n":7,"c":[{"t":"text","v":"If the LDO is not enabled, "},{"t":"field","v":"VDD_SPI"},{"t":"text","v":" is connected directly to the same power supply as "},{"t":"field","v":"VDD3P3_RTC"},{"t":"text","v":"."}]}]},{"t":"p","s":[{"n":8,"c":[{"t":"text","v":"The "},{"t":"field","v":"VDD_SPI"},{"t":"text","v":" configuration is determined by the value of strapping pin "},{"t":"pin","v":"GPIO45","n":45},{"t":"text","v":", or can be overridden by "},{"t":"block","v":"eFuse","id":"efuse"},{"t":"text","v":" and/or register settings."}]},{"n":9,"c":[{"t":"text","v":"See ESP32-S3 Datasheet sections Power Scheme and Strapping Pins for more details (strapping pins: "},{"t":"xref","id":"C3","c":[{"t":"text","v":"C3 Boot Configurations"}]},{"t":"text","v":")."}]}]},{"t":"p","s":[{"n":10,"c":[{"t":"text","v":"Note that "},{"t":"pin","v":"GPIO33","n":33},{"t":"text","v":" ~ "},{"t":"pin","v":"GPIO37","n":37},{"t":"text","v":" and "},{"t":"pin","v":"GPIO47","n":47},{"t":"text","v":" ~ "},{"t":"pin","v":"GPIO48","n":48},{"t":"text","v":" can be powered either by "},{"t":"field","v":"VDD_SPI"},{"t":"text","v":" or "},{"t":"field","v":"VDD3P3_CPU"},{"t":"text","v":"."}]}]}]}