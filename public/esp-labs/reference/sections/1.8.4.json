{"id":"1.8.4","doc":"T","title":"EE.CMUL.S16","words":385,"blocks":[{"t":"p","s":[{"n":1,"c":[{"t":"b","c":[{"t":"text","v":"Instruction Word"}]},{"t":"text","v":" (bit layout, little-endian bit order)"}]}]},{"t":"table","head":[[{"t":"text","v":"10"}],[{"t":"text","v":"qz[2:1]"}],[{"t":"text","v":"1110"}],[{"t":"text","v":"qz[0]"}],[{"t":"text","v":"qy[2]"}],[{"t":"text","v":"0"}],[{"t":"text","v":"qy[1:0]"}],[{"t":"text","v":"qx[2:0]"}],[{"t":"text","v":"00"}],[{"t":"text","v":"sel4[1:0]"}],[{"t":"text","v":"0100"}]],"rows":[{"n":2,"c":[[{"t":"text","v":"2"}],[{"t":"text","v":"2"}],[{"t":"text","v":"4"}],[{"t":"text","v":"1"}],[{"t":"text","v":"1"}],[{"t":"text","v":"1"}],[{"t":"text","v":"2"}],[{"t":"text","v":"3"}],[{"t":"text","v":"2"}],[{"t":"text","v":"2"}],[{"t":"text","v":"4"}]]}]},{"t":"p","s":[{"n":3,"c":[{"t":"b","c":[{"t":"text","v":"Assembler Syntax"}]}]}]},{"t":"pre","v":"EE.CMUL.S16 qz, qx, qy, 0..3","lang":"text"},{"t":"p","s":[{"n":4,"c":[{"t":"b","c":[{"t":"text","v":"Description"}]}]}]},{"t":"p","s":[{"n":5,"c":[{"t":"text","v":"This instruction performs a "},{"t":"num","v":"16-bit","k":"size"},{"t":"text","v":" signed complex multiplication."}]},{"n":6,"c":[{"t":"text","v":"The range of the immediate number sel4 is 0 ~ 3, which specifies the 32 bits in the two QR registers qx and qy for complex multiplication."}]},{"n":7,"c":[{"t":"text","v":"The real and imaginary parts of complex numbers are stored in the upper 16 bits and lower 16 bits of the 32 bits respectively."}]},{"n":8,"c":[{"t":"text","v":"The calculated real part and imaginary part results are stored in the corresponding 32 bits of register qz."}]}]},{"t":"p","s":[{"n":9,"c":[{"t":"b","c":[{"t":"text","v":"Operation"}]}]}]},{"t":"pre","v":"if sel4 == 0:\n  qz[ 15: 0] = (qx[ 15: 0] * qy[ 15: 0] - qx[ 31: 16] * qy[ 31: 16]) >> SAR[5:0]\n  qz[ 31: 16] = (qx[ 15: 0] * qy[ 31: 16] + qx[ 31: 16] * qy[ 15: 0]) >> SAR[5:0]\n  qz[ 47: 32] = (qx[ 47: 32] * qy[ 47: 32] - qx[ 63: 48] * qy[ 63: 48]) >> SAR[5:0]\n  qz[ 63: 48] = (qx[ 47: 32] * qy[ 63: 48] + qx[ 63: 48] * qy[ 47: 32]) >> SAR[5:0]\nif sel4 == 1:\n  qz[ 79: 64] = (qx[ 79: 64] * qy[ 79: 64] - qx[ 95: 80] * qy[ 95: 80]) >> SAR[5:0]\n  qz[ 95: 80] = (qx[ 79: 64] * qy[ 95: 80] + qx[ 95: 80] * qy[ 79: 64]) >> SAR[5:0]\n  qz[111: 96] = (qx[111: 96] * qy[111: 96] - qx[127:112] * qy[127:112]) >> SAR[5:0]\n  qz[127:112] = (qx[111: 96] * qy[127:112] + qx[127:112] * qy[111: 96]) >> SAR[5:0]\nif sel4 == 2:\n  qz[ 15: 0] = (qx[ 15: 0] * qy[ 15: 0] + qx[ 31: 16] * qy[ 31: 16]) >> SAR[5:0]\n  qz[ 31: 16] = (qx[ 15: 0] * qy[ 31: 16] - qx[ 31: 16] * qy[ 15: 0]) >> SAR[5:0]\n  qz[ 47: 32] = (qx[ 47: 32] * qy[ 47: 32] + qx[ 63: 48] * qy[ 63: 48]) >> SAR[5:0]\n  qz[ 63: 48] = (qx[ 47: 32] * qy[ 63: 48] - qx[ 63: 48] * qy[ 47: 32]) >> SAR[5:0]\nif sel4 == 3:\n  qz[ 79: 64] = (qx[ 79: 64] * qy[ 79: 64] + qx[ 95: 80] * qy[ 95: 80]) >> SAR[5:0]\n  qz[ 95: 80] = (qx[ 79: 64] * qy[ 95: 80] - qx[ 95: 80] * qy[ 79: 64]) >> SAR[5:0]\n  qz[111: 96] = (qx[111: 96] * qy[111: 96] + qx[127:112] * qy[127:112]) >> SAR[5:0]\n  qz[127:112] = (qx[111: 96] * qy[127:112] - qx[127:112] * qy[111: 96]) >> SAR[5:0]","lang":"text"}]}