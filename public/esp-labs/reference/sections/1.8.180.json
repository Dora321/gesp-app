{"id":"1.8.180","doc":"T","title":"EE.VMULAS.U8.QACC.LDBC.INCP","words":245,"blocks":[{"t":"p","s":[{"n":1,"c":[{"t":"b","c":[{"t":"text","v":"Instruction Word"}]},{"t":"text","v":" (bit layout, little-endian bit order)"}]}]},{"t":"table","head":[[{"t":"text","v":"111"}],[{"t":"text","v":"qu[2]"}],[{"t":"text","v":"0111"}],[{"t":"text","v":"qu[1]"}],[{"t":"text","v":"qy[2]"}],[{"t":"text","v":"qu[0]"}],[{"t":"text","v":"qy[1:0]"}],[{"t":"text","v":"qx[2:0]"}],[{"t":"text","v":"as[3:0]"}],[{"t":"text","v":"0100"}]],"rows":[{"n":2,"c":[[{"t":"text","v":"3"}],[{"t":"text","v":"1"}],[{"t":"text","v":"4"}],[{"t":"text","v":"1"}],[{"t":"text","v":"1"}],[{"t":"text","v":"1"}],[{"t":"text","v":"2"}],[{"t":"text","v":"3"}],[{"t":"text","v":"4"}],[{"t":"text","v":"4"}]]}]},{"t":"p","s":[{"n":3,"c":[{"t":"b","c":[{"t":"text","v":"Assembler Syntax"}]}]}]},{"t":"pre","v":"EE.VMULAS.U8.QACC.LDBC.INCP qu, as, qx, qy","lang":"text"},{"t":"p","s":[{"n":4,"c":[{"t":"b","c":[{"t":"text","v":"Description"}]}]}]},{"t":"p","s":[{"n":5,"c":[{"t":"text","v":"This instruction divides registers qx and qy into 16 data segments by 8 bits."}]},{"n":6,"c":[{"t":"text","v":"Then, the unsigned multiplication result of the 16 sets of segments is added to the corresponding "},{"t":"num","v":"20-bit","k":"size"},{"t":"text","v":" data segment in special registers QACC_H and QACC_L respectively."}]},{"n":7,"c":[{"t":"text","v":"The calculated result is saturated to a "},{"t":"num","v":"20-bit","k":"size"},{"t":"text","v":" unsigned number and then stored to the corresponding "},{"t":"num","v":"20-bit","k":"size"},{"t":"text","v":" data segment in QACC_H and QACC_L."}]},{"n":8,"c":[{"t":"text","v":"At the same time, this instruction loads "},{"t":"num","v":"8-bit","k":"size"},{"t":"text","v":" data from memory at the address given by the access register as and broadcasts it to the 16 "},{"t":"num","v":"8-bit","k":"size"},{"t":"text","v":" data segments in register qu."}]},{"n":9,"c":[{"t":"text","v":"After the access, the value in register as is incremented by 1."}]}]},{"t":"p","s":[{"n":10,"c":[{"t":"b","c":[{"t":"text","v":"Operation"}]}]}]},{"t":"pre","v":"QACC_L[ 19: 0] = min(QACC_L[ 19: 0] + qx[ 7: 0] * qy[ 7: 0], 2^{20}-1)\nQACC_L[ 39: 20] = min(QACC_L[ 39: 20] + qx[ 15: 8] * qy[ 15: 8], 2^{w0}-1)\n...\nQACC_L[159:140] = min(QACC_L[159:140] + qx[ 63: 56] * qy[ 63: 56], 2^{20}-1)\nQACC_H[ 19: 0] = min(QACC_H[ 19: 0] + qx[ 71: 64] * qy[ 71: 64], 2^{20}-1)\nQACC_H[ 39: 20] = min(QACC_H[ 39: 20] + qx[ 79: 72] * qy[ 79: 72], 2^{20}-1)\n...\nQACC_H[159:140] = min(QACC_H[159:140] + qx[127:120] * qy[127:120], 2^{20}-1)\n\nqu[127:0] = {16{load8(as[31:0])}}\nas[31:0] = as[31:0] + 1","lang":"text"}]}