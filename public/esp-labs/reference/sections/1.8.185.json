{"id":"1.8.185","doc":"T","title":"EE.VRELU.S8","words":151,"blocks":[{"t":"p","s":[{"n":1,"c":[{"t":"b","c":[{"t":"text","v":"Instruction Word"}]},{"t":"text","v":" (bit layout, little-endian bit order)"}]}]},{"t":"table","head":[[{"t":"text","v":"11"}],[{"t":"text","v":"qs[2:1]"}],[{"t":"text","v":"1101"}],[{"t":"text","v":"qs[0]"}],[{"t":"text","v":"101"}],[{"t":"text","v":"ax[3:0]"}],[{"t":"text","v":"ay[3:0]"}],[{"t":"text","v":"0100"}]],"rows":[{"n":2,"c":[[{"t":"text","v":"2"}],[{"t":"text","v":"2"}],[{"t":"text","v":"4"}],[{"t":"text","v":"1"}],[{"t":"text","v":"3"}],[{"t":"text","v":"4"}],[{"t":"text","v":"4"}],[{"t":"text","v":"4"}]]}]},{"t":"p","s":[{"n":3,"c":[{"t":"b","c":[{"t":"text","v":"Assembler Syntax"}]}]}]},{"t":"pre","v":"EE.VRELU.S8 qs, ax, ay","lang":"text"},{"t":"p","s":[{"n":4,"c":[{"t":"b","c":[{"t":"text","v":"Description"}]}]}]},{"t":"p","s":[{"n":5,"c":[{"t":"text","v":"This instruction divides register qs into 16 data segments by 8 bits."}]},{"n":6,"c":[{"t":"text","v":"If the value of the segment is not greater than 0, it will be multiplied by the value of the lower 8 bits in register ax and right-shifted by the value of the lower 5 bits in register ay, and then the result obtained will overwrite the value of the segment."}]},{"n":7,"c":[{"t":"text","v":"Otherwise, the value of the segment will remain unchanged."}]}]},{"t":"p","s":[{"n":8,"c":[{"t":"b","c":[{"t":"text","v":"Operation"}]}]}]},{"t":"pre","v":"qs[ 7: 0] = (qs[ 7: 0]<=0) ? (qs[ 7: 0] * ax[7:0]) >> ay[4:0] : qs[ 7: 0]\nqs[ 15: 8] = (qs[ 15: 8]<=0) ? (qs[ 15: 8] * ax[7:0]) >> ay[4:0] : qs[ 15: 8]\n...\nqs[127:120] = (qs[127:120]<=0) ? (qs[127:120] * ax[7:0]) >> ay[4:0] : qs[127:120]","lang":"text"}]}