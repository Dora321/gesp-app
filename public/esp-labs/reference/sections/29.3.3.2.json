{"id":"29.3.3.2","doc":"T","title":"Camera Clock","words":192,"blocks":[{"t":"p","s":[{"n":1,"c":[{"t":"text","v":"The clocks used in camera module are generated by CAM_Clock Generator from clock sources, see Figure 29.3-3."}]}]},{"t":"p","s":[{"n":2,"c":[{"t":"text","v":"The clocks include:"}]}]},{"t":"list","ordered":false,"items":[[{"t":"p","s":[{"n":3,"c":[{"t":"text","v":"master clock: CAM_CLK, master clock output from camera module, divided from clock sources."}]}]}],[{"t":"p","s":[{"n":4,"c":[{"t":"text","v":"pixel clock: CAM_CLK, clock input from camera slave."}]}]}]]},{"t":"p","s":[{"n":5,"c":[{"t":"field","v":"LCD_CAM_CAM_CLK_SEL"},{"t":"text","v":" in register "},{"t":"reg","v":"LCD_CAM_CAM_CTRL_REG"},{"t":"text","v":" is used to select one of the following clock sources for camera module:"}]}]},{"t":"list","ordered":false,"items":[[{"t":"p","s":[{"n":6,"c":[{"t":"text","v":"0: disable camera clock source"}]}]}],[{"t":"p","s":[{"n":7,"c":[{"t":"text","v":"1: "},{"t":"field","v":"XTAL_CLK"}]}]}],[{"t":"p","s":[{"n":8,"c":[{"t":"text","v":"2: PLL_D2_CLK"}]}]}],[{"t":"p","s":[{"n":9,"c":[{"t":"text","v":"3: PLL_F160M_CLK"}]}]}]]},{"t":"fig","src":"images/trm-fig-29_3-3.png","alt":"Figure 29.3-3. Camera Clock","caption":"Figure 29.3-3. Camera Clock"},{"t":"p","s":[{"n":10,"c":[{"t":"text","v":"The following formula shows the relation between the frequencies of CAM_CLK (f_CAM_CLK) and the divider clock source (f_CAM_CLK_S):"}]}]},{"t":"p","s":[{"n":11,"c":[{"t":"text","v":"f_CAM_CLK = f_CAM_CLK_S / (N + b/a)"}]}]},{"t":"p","s":[{"n":12,"c":[{"t":"text","v":"N is an integer value between 2 and 256."}]},{"n":13,"c":[{"t":"text","v":"The value of N corresponds to the value of "},{"t":"field","v":"LCD_CAM_CAM_CLKM_DIV_NUM"},{"t":"text","v":" in register "},{"t":"reg","v":"LCD_CAM_CAM_CTRL_REG"},{"t":"text","v":" as follows:"}]}]},{"t":"list","ordered":false,"items":[[{"t":"p","s":[{"n":14,"c":[{"t":"text","v":"When "},{"t":"field","v":"LCD_CAM_CAM_CLKM_DIV_NUM"},{"t":"text","v":" = 0, N = 256."}]}]}],[{"t":"p","s":[{"n":15,"c":[{"t":"text","v":"When "},{"t":"field","v":"LCD_CAM_CAM_CLKM_DIV_NUM"},{"t":"text","v":" = 1, N = 2."}]}]}],[{"t":"p","s":[{"n":16,"c":[{"t":"text","v":"When "},{"t":"field","v":"LCD_CAM_CAM_CLKM_DIV_NUM"},{"t":"text","v":" has any other value, N = "},{"t":"field","v":"LCD_CAM_CAM_CLKM_DIV_NUM"},{"t":"text","v":"."}]}]}]]},{"t":"p","s":[{"n":17,"c":[{"t":"text","v":"\"b\" corresponds to the value of "},{"t":"field","v":"LCD_CAM_CAM_CLKM_DIV_B"},{"t":"text","v":", and \"a\" to the value of "},{"t":"field","v":"LCD_CAM_CAM_CLKM_DIV_A"},{"t":"text","v":"."}]},{"n":18,"c":[{"t":"text","v":"For integer divider, "},{"t":"field","v":"LCD_CAM_CAM_CLKM_DIV_A"},{"t":"text","v":" and "},{"t":"field","v":"LCD_CAM_CAM_CLKM_DIV_B"},{"t":"text","v":" are cleared."}]},{"n":19,"c":[{"t":"text","v":"For fractional divider, the value of "},{"t":"field","v":"LCD_CAM_CAM_CLKM_DIV_B"},{"t":"text","v":" should be less than the value of "},{"t":"field","v":"LCD_CAM_CAM_CLKM_DIV_A"},{"t":"text","v":"."}]}]}]}