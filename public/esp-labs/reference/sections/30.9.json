{"id":"30.9","doc":"T","title":"Differences Between GP-SPI2 and GP-SPI3","words":208,"blocks":[{"t":"p","s":[{"n":1,"c":[{"t":"text","v":"The feature differences between "},{"t":"block","v":"GP-SPI2","id":"spi"},{"t":"text","v":" and GP-SPI3 are as follows:"}]}]},{"t":"list","ordered":false,"items":[[{"t":"p","s":[{"n":2,"c":[{"t":"text","v":"The communication mode for each GP-SPI2 state (CMD, ADDR, DOUT or DIN) can be configured independently."}]},{"n":3,"c":[{"t":"text","v":"Data can either be in 1/2/4/"},{"t":"num","v":"8-bit","k":"size"},{"t":"text","v":" master mode or 1/2/"},{"t":"num","v":"4-bit","k":"size"},{"t":"text","v":" slave mode."}]},{"n":4,"c":[{"t":"text","v":"Whereas GP-SPI3 supports 1/2/"},{"t":"num","v":"4-bit","k":"size"},{"t":"text","v":" master mode or 1/2/"},{"t":"num","v":"4-bit","k":"size"},{"t":"text","v":" slave mode."}]}]}],[{"t":"p","s":[{"n":5,"c":[{"t":"text","v":"DMA-controlled configurable segmented transfer is only supported in GP-SPI2."}]},{"n":6,"c":[{"t":"text","v":"Therefore, CONF state is not used in GP-SPI3."}]}]}],[{"t":"p","s":[{"n":7,"c":[{"t":"text","v":"The I/O lines of GP-SPI2 can be mapped to physical GPIO pins either via GPIO matrix or IO MUX."}]},{"n":8,"c":[{"t":"text","v":"However, GP-SPI3 lines can be configured only via GPIO matrix."}]}]}],[{"t":"p","s":[{"n":9,"c":[{"t":"text","v":"GP-SPI2 has six CS signals in master mode."}]},{"n":10,"c":[{"t":"text","v":"GP-SPI3 only has three CS signals in master mode."}]}]}]]},{"t":"p","s":[{"n":11,"c":[{"t":"text","v":"Apart from that, the functions of GP-SPI2 and GP-SPI3 are the same."}]},{"n":12,"c":[{"t":"text","v":"GP-SPI2 can use all the GP-SPI registers, while GP-SPI3 can only use some of the GP-SPI registers, see Table 30.9-1 for details."}]}]},{"t":"table","caption":"Table 30.9-1. Invalid Registers and Fields for GP-SPI3","head":[[{"t":"text","v":"Invalid Register"}],[{"t":"text","v":"Invalid Field"}]],"rows":[{"n":13,"c":[[{"t":"reg","v":"SPI_USER_REG"}],[{"t":"text","v":"SPI_OPI_MODE, SPI_FWRITE_OCT"}]]},{"n":14,"c":[[{"t":"reg","v":"SPI_CTRL_REG"}],[{"t":"text","v":"SPI_FADDR_OCT, SPI_FCMD_OCT, SPI_FREAD_OCT"}]]},{"n":15,"c":[[{"t":"reg","v":"SPI_MISC_REG"}],[{"t":"field","v":"SPI_CS3_DIS"},{"t":"text","v":", "},{"t":"field","v":"SPI_CS4_DIS"},{"t":"text","v":", "},{"t":"field","v":"SPI_CS5_DIS"},{"t":"text","v":", "},{"t":"field","v":"SPI_MASTER_CS_POL"},{"t":"text","v":"[5:3]"}]]},{"n":16,"c":[[{"t":"reg","v":"SPI_DIN_MODE_REG"}],[{"t":"text","v":"SPI_DIN4_MODE, SPI_DIN5_MODE, SPI_DIN6_MODE, SPI_DIN7_MODE"}]]},{"n":17,"c":[[{"t":"reg","v":"SPI_DIN_NUM_REG"}],[{"t":"text","v":"SPI_DIN4_NUM, SPI_DIN5_NUM, SPI_DIN6_NUM, SPI_DIN7_NUM"}]]},{"n":18,"c":[[{"t":"reg","v":"SPI_DOUT_MODE_REG"}],[{"t":"text","v":"SPI_DOUT4_MODE, SPI_DOUT5_MODE, SPI_DOUT6_MODE, SPI_DOUT7_MODE"}]]}]}]}