{"id":"28.9.2","doc":"T","title":"Channel Mode Control","words":59,"blocks":[{"t":"p","s":[{"n":1,"c":[{"t":"text","v":"ESP32-S3 "},{"t":"block","v":"I2S","id":"i2s"},{"t":"i","c":[{"t":"text","v":"n"}]},{"t":"text","v":" supports both TDM TX mode and PDM TX mode."}]},{"n":2,"c":[{"t":"text","v":"Set "},{"t":"field","v":"I2S_TX_TDM_EN"},{"t":"text","v":" to enable TDM TX mode, or set "},{"t":"field","v":"I2S_TX_PDM_EN"},{"t":"text","v":" to enable PDM TX mode."}]}]},{"t":"p","s":[{"n":3,"c":[{"t":"text","v":"Note:"}],"warn":true}]},{"t":"list","ordered":false,"items":[[{"t":"p","s":[{"n":4,"c":[{"t":"field","v":"I2S_TX_TDM_EN"},{"t":"text","v":" and "},{"t":"field","v":"I2S_TX_PDM_EN"},{"t":"text","v":" must not be cleared or set simultaneously."}],"warn":true}]}],[{"t":"p","s":[{"n":5,"c":[{"t":"text","v":"Most stereo I2S codecs can be controlled by setting the I2S"},{"t":"i","c":[{"t":"text","v":"n"}]},{"t":"text","v":" module into 2-channel mode under TDM standard."}]}]}]]}]}