{"id":"30.5.9.4","doc":"T","title":"Configuration of Slave Single Transfer","words":192,"blocks":[{"t":"p","s":[{"n":1,"c":[{"t":"text","v":"In slave mode, "},{"t":"block","v":"GP-SPI","id":"spi"},{"t":"text","v":" supports CPU/DMA-controlled full-duplex/half-duplex single transfers."}]},{"n":2,"c":[{"t":"text","v":"The register configuration procedure is as follows:"}]}]},{"t":"list","ordered":true,"items":[[{"t":"p","s":[{"n":3,"c":[{"t":"text","v":"Configure the IO path via IO MUX or GPIO matrix between GP-SPI and an external SPI device."}]}]}],[{"t":"p","s":[{"n":4,"c":[{"t":"text","v":"Configure APB clock (APB_CLK)."}]}]}],[{"t":"p","s":[{"n":5,"c":[{"t":"text","v":"Set the bit "},{"t":"field","v":"SPI_SLAVE_MODE"},{"t":"text","v":", to enable slave mode."}]}]}],[{"t":"p","s":[{"n":6,"c":[{"t":"text","v":"Configure "},{"t":"field","v":"SPI_DOUTDIN"},{"t":"text","v":":"}]}]},{"t":"list","ordered":false,"items":[[{"t":"p","s":[{"n":7,"c":[{"t":"text","v":"1: enable full-duplex communication."}]}]}],[{"t":"p","s":[{"n":8,"c":[{"t":"text","v":"0: enable half-duplex communication."}]}]}]]}],[{"t":"p","s":[{"n":9,"c":[{"t":"text","v":"Prepare data:"}]}]},{"t":"list","ordered":false,"items":[[{"t":"p","s":[{"n":10,"c":[{"t":"text","v":"if CPU-controlled transfer mode is selected and GP-SPI is used to send data, then prepare data in registers "},{"t":"reg","v":"SPI_W0_REG"},{"t":"text","v":" ~ "},{"t":"reg","v":"SPI_W15_REG"},{"t":"text","v":"."}]}]}],[{"t":"p","s":[{"n":11,"c":[{"t":"text","v":"if DMA-controlled transfer mode is selected,"}]}]},{"t":"list","ordered":false,"items":[[{"t":"p","s":[{"n":12,"c":[{"t":"text","v":"configure "},{"t":"field","v":"SPI_DMA_TX_ENA"},{"t":"text","v":"/"},{"t":"field","v":"SPI_DMA_RX_ENA"},{"t":"text","v":" and "},{"t":"field","v":"SPI_RX_EOF_EN"},{"t":"text","v":"."}]}]}],[{"t":"p","s":[{"n":13,"c":[{"t":"text","v":"configure "},{"t":"block","v":"GDMA","id":"gdma"},{"t":"text","v":" TX/RX link."}]}]}],[{"t":"p","s":[{"n":14,"c":[