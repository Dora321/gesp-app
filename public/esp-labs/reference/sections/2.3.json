{"id":"2.3","doc":"T","title":"Programming Workflow","words":60,"blocks":[{"t":"p","s":[{"n":1,"c":[{"t":"text","v":"The "},{"t":"block","v":"ULP-RISC-V","id":"ulp"},{"t":"text","v":" is intended for programming using C language."}]},{"n":2,"c":[{"t":"text","v":"The program in C is then compiled to "},{"t":"link","href":"https://riscv.org/specifications/","c":[{"t":"text","v":"RV32IMC"}]},{"t":"text","v":" standard instruction code."}]},{"n":3,"c":[{"t":"text","v":"The ULP-FSM is using custom instructions normally not supported by high-level programming language."}]},{"n":4,"c":[{"t":"text","v":"Users develop their programs using ULP-FSM instructions (see "},{"t":"xref","id":"2.5.2","c":[{"t":"text","v":"Section 2.5.2"}]},{"t":"text","v":")."}]}]},{"t":"fig","src":"images/trm-fig-2_3-1.png","alt":"Figure 2.3-1. Programming Workflow"}]}