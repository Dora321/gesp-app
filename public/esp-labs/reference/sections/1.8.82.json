{"id":"1.8.82","doc":"T","title":"EE.VCMP.GT.S16","words":125,"blocks":[{"t":"p","s":[{"n":1,"c":[{"t":"b","c":[{"t":"text","v":"Instruction Word"}]},{"t":"text","v":" (bit layout, little-endian bit order)"}]}]},{"t":"table","head":[[{"t":"text","v":"10"}],[{"t":"text","v":"qa[2:1]"}],[{"t":"text","v":"1110"}],[{"t":"text","v":"qa[0]"}],[{"t":"text","v":"qy[2]"}],[{"t":"text","v":"0"}],[{"t":"text","v":"qy[1:0]"}],[{"t":"text","v":"qx[2:0]"}],[{"t":"text","v":"11000100"}]],"rows":[{"n":2,"c":[[{"t":"text","v":"2"}],[{"t":"text","v":"2"}],[{"t":"text","v":"4"}],[{"t":"text","v":"1"}],[{"t":"text","v":"1"}],[{"t":"text","v":"1"}],[{"t":"text","v":"2"}],[{"t":"text","v":"3"}],[{"t":"text","v":"8"}]]}]},{"t":"p","s":[{"n":3,"c":[{"t":"b","c":[{"t":"text","v":"Assembler Syntax"}]}]}]},{"t":"pre","v":"EE.VCMP.GT.S16 qa, qx, qy","lang":"text"},{"t":"p","s":[{"n":4,"c":[{"t":"b","c":[{"t":"text","v":"Description"}]}]}]},{"t":"p","s":[{"n":5,"c":[{"t":"text","v":"This instruction compares "},{"t":"num","v":"16-bit","k":"size"},{"t":"text","v":" vector data."}]},{"n":6,"c":[{"t":"text","v":"It compares the numerical values of the eight "},{"t":"num","v":"16-bit","k":"size"},{"t":"text","v":" data segments in registers qx and qy."}]},{"n":7,"c":[{"t":"text","v":"If the former is larger than the latter, it writes 0xFFFF into the corresponding "},{"t":"num","v":"16-bit","k":"size"},{"t":"text","v":" data segment in register qa."}]},{"n":8,"c":[{"t":"text","v":"Otherwise, it writes 0 to the segment."}]}]},{"t":"p","s":[{"n":9,"c":[{"t":"b","c":[{"t":"text","v":"Operation"}]}]}]},{"t":"pre","v":"qa[ 15: 0] = (qx[ 15: 0]>qy[ 15: 0]) ? 0x{}FFFF : 0\nqa[ 31: 16] = (qx[ 31: 16]>qy[ 31: 16]) ? 0x{}FFFF : 0\n...\nqa[127:112] = (qx[127:112]>qy[127:112]) ? 0x{}FFFF : 0","lang":"text"}]}