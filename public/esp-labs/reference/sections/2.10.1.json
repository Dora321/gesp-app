{"id":"2.10.1","doc":"T","title":"ULP (ALWAYS_ON) Registers","words":335,"blocks":[{"t":"p","s":[{"n":1,"c":[{"t":"text","v":"The addresses in this section are relative to low-power management base address provided in Table 4.3-3 in "},{"t":"xref","id":"4","c":[{"t":"text","v":"Chapter 4 System and Memory"}]},{"t":"text","v":"."}]}]},{"t":"register","n":2,"num":"2.1","name":"RTC_CNTL_ULP_CP_TIMER_REG","offset":"0x00FC","fields":[{"bits":"31","field":"RTC_CNTL_ULP_CP_SLP_TIMER_EN","access":"R/W","reset":"0","desc":[{"t":"block","v":"ULP","id":"ulp"},{"t":"text","v":" coprocessor timer enable bit. 0: Disable hardware timer; 1: Enable hardware timer."}]},{"bits":"30","field":"RTC_CNTL_ULP_CP_GPIO_WAKEUP_CLR","access":"WO","reset":"0","desc":[{"t":"text","v":"Disable the option of ULP timer woken up by RTC GPIO."}]},{"bits":"29","field":"RTC_CNTL_ULP_CP_GPIO_WAKEUP_ENA","access":"R/W","reset":"0","desc":[{"t":"text","v":"Enable the option of ULP timer woken up by RTC GPIO."}]},{"bits":"28:11","field":"(reserved)","access":"-","reset":"0","desc":[{"t":"text","v":"Reserved."}]},{"bits":"10:0","field":"RTC_CNTL_ULP_CP_PC_INIT","access":"R/W","reset":"0","desc":[{"t":"text","v":"ULP coprocessor PC initial address."}]}]},{"t":"register","n":3,"num":"2.2","name":"RTC_CNTL_ULP_CP_TIMER_1_REG","offset":"0x0134","fields":[{"bits":"31:8","field":"RTC_CNTL_ULP_CP_TIMER_SLP_CYCLE","access":"R/W","reset":"200","desc":[{"t":"text","v":"Set sleep cycles for ULP coprocessor timer."}]},{"bits":"7:0","field":"(reserved)","access":"-","reset":"0","desc":[{"t":"text","v":"Reserved."}]}]},{"t":"register","n":4,"num":"2.3","name":"RTC_CNTL_ULP_CP_CTRL_REG","offset":"0x0100","fields":[{"bits":"31","field":"RTC_CNTL_ULP_CP_START_TOP","access":"R/W","reset":"0","desc":[{"t":"text","v":"Write 1 to start ULP-FSM."}]},{"bits":"30","field":"RTC_CNTL_ULP_CP_FORCE_START_TOP","access":"R/W","reset":"0","desc":[{"t":"text","v":"Write 1 to start ULP-FSM by software."}]},{"bits":"29","field":"RTC_CNTL_ULP_CP_RESET","access":"R/W","reset":"0","desc":[{"t":"text","v":"ULP-FSM clock software reset."}]},{"bits":"28","field":"RTC_CNTL_ULP_CP_CLK_FO","access":"R/W","reset":"0","desc":[{"t":"text","v":"ULP-FSM clock force on."}]},{"bits":"27:0","field":"(reserved)","access":"-","reset":"0","desc":[{"t":"text","v":"Reserved."}]}]},{"t":"register","n":5,"num":"2.4","name":"RTC_CNTL_COCPU_CTRL_REG","offset":"0x0104","fields":[{"bits":"31:28","field":"(reserved)","access":"-","reset":"0","desc":[{"t":"text","v":"Reserved."}]},{"bits":"27","field":"RTC_CNTL_COCPU_CLKGATE_EN","access":"WO","reset":"0","desc":[{"t":"text","v":"Enable ULP-RICS-V clock gate."}]},{"bits":"26","field":"RTC_CNTL_COCPU_SW_INT_TRIGGER","access":"WO","reset":"0","desc":[{"t":"text","v":"Trigger ULP-RISC-V register interrupt."}]},{"bits":"25","field":"RTC_CNTL_COCPU_DONE","access":"R/W","reset":"0","desc":[{"t":"text","v":"DONE signal. Write 1 to this bit, ULP-RISC-V will go to HALT and the timer starts counting."}]},{"bits":"24","field":"RTC_CNTL_COCPU_DONE_FORCE","access":"R/W","reset":"0","desc":[{"t":"text","v":"0: select ULP-FSM DONE signal; 1: select ULP-RISC-V DONE signal."}]},{"bits":"23","field":"RTC_CNTL_COCPU_SEL","access":"R/W","reset":"1","desc":[{"t":"text","v":"0: select ULP-RISC-V; 1: select ULP-FSM."}]},{"bits":"22","field":"RTC_CNTL_COCPU_SHUT_RESET_EN","access":"R/W","reset":"0","desc":[{"t":"text","v":"This bit is used to reset ULP-RISC-V."}]},{"bits":"21:14","field":"RTC_CNTL_COCPU_SHUT_2_CLK_DIS","access":"R/W","reset":"40","desc":[{"t":"text","v":"Time from shut down ULP-RISC-V to disable clock."}]},{"bits":"13","field":"RTC_CNTL_COCPU_SHUT","access":"R/W","reset":"0","desc":[{"t":"text","v":"Shut down ULP-RISC-V."}]},{"bits":"12:7","field":"RTC_CNTL_COCPU_START_2_INTR_EN","access":"R/W","reset":"16","desc":[{"t":"text","v":"Time from ULP-RISC-V startup to send out "},{"t":"field","v":"RISCV_START_INT"},{"t":"text","v":" interrupt."}]},{"bits":"6:1","field":"RTC_CNTL_COCPU_START_2_RESET_DIS","access":"R/W","reset":"8","desc":[{"t":"text","v":"Time from ULP-RISC-V startup to pull down reset."}]},{"bits":"0","field":"RTC_CNTL_COCPU_CLK_FO","access":"R/W","reset":"0","desc":[{"t":"text","v":"ULP-RISC-V clock force on."}]}]}]}