{"id":"1.8.15","doc":"T","title":"EE.FFT.VST.R32.DECP","words":143,"blocks":[{"t":"p","s":[{"n":1,"c":[{"t":"b","c":[{"t":"text","v":"Instruction Word"}]},{"t":"text","v":" (bit layout, little-endian bit order)"}]}]},{"t":"table","head":[[{"t":"text","v":"11"}],[{"t":"text","v":"qv[2:1]"}],[{"t":"text","v":"1101"}],[{"t":"text","v":"qv[0]"}],[{"t":"text","v":"0110"}],[{"t":"text","v":"sar2[0]"}],[{"t":"text","v":"11"}],[{"t":"text","v":"as[3:0]"}],[{"t":"text","v":"0100"}]],"rows":[{"n":2,"c":[[{"t":"text","v":"2"}],[{"t":"text","v":"2"}],[{"t":"text","v":"4"}],[{"t":"text","v":"1"}],[{"t":"text","v":"4"}],[{"t":"text","v":"1"}],[{"t":"text","v":"2"}],[{"t":"text","v":"4"}],[{"t":"text","v":"4"}]]}]},{"t":"p","s":[{"n":3,"c":[{"t":"b","c":[{"t":"text","v":"Assembler Syntax"}]}]}]},{"t":"pre","v":"EE.FFT.VST.R32.DECP qv, as, sar2","lang":"text"},{"t":"p","s":[{"n":4,"c":[{"t":"b","c":[{"t":"text","v":"Description"}]}]}]},{"t":"p","s":[{"n":5,"c":[{"t":"text","v":"It is a dedicated FFT instruction."}]},{"n":6,"c":[{"t":"text","v":"This instruction divides data in register qv into 8 segments of "},{"t":"num","v":"16-bit","k":"size"},{"t":"text","v":" data and performs an arithmetic right shift on them by 0 or 1 depending on the immediate number sar2, and finally writes the result to the memory address indicated by register as in word big-endian order."}]},{"n":7,"c":[{"t":"text","v":"After the access is completed, the value in register as is decreased by 16."}]}]},{"t":"p","s":[{"n":8,"c":[{"t":"b","c":[{"t":"text","v":"Operation"}]}]}]},{"t":"pre","v":"{\nqv[ 31: 16] >> sar2,\nqv[ 15: 0] >> sar2,\nqv[ 63: 48] >> sar2,\nqv[ 47: 32] >> sar2,\nqv[ 95: 80] >> sar2,\nqv[ 79: 64] >> sar2,\nqv[127:112] >> sar2,\nqv[111: 96] >> sar2\n} => store128({as[31:4],4{0}})\n  as[31:0] = as[31:0] - 16","lang":"text"}]}