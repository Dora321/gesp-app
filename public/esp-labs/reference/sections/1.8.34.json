{"id":"1.8.34","doc":"T","title":"EE.LDQA.U16.128.XP","words":116,"blocks":[{"t":"p","s":[{"n":1,"c":[{"t":"b","c":[{"t":"text","v":"Instruction Word"}]},{"t":"text","v":" (bit layout, little-endian bit order)"}]}]},{"t":"table","head":[[{"t":"text","v":"011110100100"}],[{"t":"text","v":"ad[3:0]"}],[{"t":"text","v":"as[3:0]"}],[{"t":"text","v":"0100"}]],"rows":[{"n":2,"c":[[{"t":"text","v":"12"}],[{"t":"text","v":"4"}],[{"t":"text","v":"4"}],[{"t":"text","v":"4"}]]}]},{"t":"p","s":[{"n":3,"c":[{"t":"b","c":[{"t":"text","v":"Assembler Syntax"}]}]}]},{"t":"pre","v":"EE.LDQA.U16.128.XP as, ad","lang":"text"},{"t":"p","s":[{"n":4,"c":[{"t":"b","c":[{"t":"text","v":"Description"}]}]}]},{"t":"p","s":[{"n":5,"c":[{"t":"text","v":"This instruction forces the lower 4 bits of the access address in register as to 0, loads 16-byte data from memory, divides it into 8 segments of 16 bits, zero-extends each segment to 40 bits, and then store the results to the "},{"t":"num","v":"160-bit","k":"size"},{"t":"text","v":" special registers QACC_L and QACC_H respectively."}]},{"n":6,"c":[{"t":"text","v":"After the access is completed, the value in register as is incremented by the value in register ad."}]}]},{"t":"p","s":[{"n":7,"c":[{"t":"b","c":[{"t":"text","v":"Operation"}]}]}]},{"t":"pre","v":"dataIn[127:0] = load128({as[31:4],4{0}})\nQACC_L[ 39: 0] = {24{0}, dataIn[ 15: 0]}\n...\nQACC_H[159:120] = {24{0}, dataIn[127:112]}\nas[31:0] = as[31:0] + ad[31:0]","lang":"text"}]}