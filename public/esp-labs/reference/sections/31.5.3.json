{"id":"31.5.3","doc":"T","title":"Interrupt Management","words":130,"blocks":[{"t":"p","s":[{"n":1,"c":[{"t":"text","v":"The ESP32-S3 "},{"t":"block","v":"TWAI","id":"twai"},{"t":"text","v":" controller provides eight interrupts, each represented by a single bit in the "},{"t":"reg","v":"TWAI_INT_RAW_REG"},{"t":"text","v":"."}]},{"n":2,"c":[{"t":"text","v":"For a particular interrupt to be triggered, the corresponding enable bit in "},{"t":"reg","v":"TWAI_INT_ENA_REG"},{"t":"text","v":" must be set."}],"warn":true}]},{"t":"p","s":[{"n":3,"c":[{"t":"text","v":"The TWAI controller provides the following interrupts:"}]}]},{"t":"list","ordered":false,"items":[[{"t":"p","s":[{"n":4,"c":[{"t":"text","v":"Receive Interrupt"}]}]}],[{"t":"p","s":[{"n":5,"c":[{"t":"text","v":"Transmit Interrupt"}]}]}],[{"t":"p","s":[{"n":6,"c":[{"t":"text","v":"Error Warning Interrupt"}]}]}],[{"t":"p","s":[{"n":7,"c":[{"t":"text","v":"Data Overrun Interrupt"}]}]}],[{"t":"p","s":[{"n":8,"c":[{"t":"text","v":"Error Passive Interrupt"}]}]}],[{"t":"p","s":[{"n":9,"c":[{"t":"text","v":"Arbitration Lost Interrupt"}]}]}],[{"t":"p","s":[{"n":10,"c":[{"t":"text","v":"Bus Error Interrupt"}]}]}],[{"t":"p","s":[{"n":11,"c":[{"t":"text","v":"Bus Status Interrupt"}]}]}]]},{"t":"p","s":[{"n":12,"c":[{"t":"text","v":"The TWAI controller's interrupt signal to the interrupt matrix will be asserted whenever one or more interrupt bits are set in the "},{"t":"reg","v":"TWAI_INT_RAW_REG"},{"t":"text","v":", and deasserted when all bits in "},{"t":"reg","v":"TWAI_INT_RAW_REG"},{"t":"text","v":" are cleared."}]},{"n":13,"c":[{"t":"text","v":"The majority of interrupt bits in "},{"t":"reg","v":"TWAI_INT_RAW_REG"},{"t":"text","v":" are automatically cleared when the register is read, except for the Receive Interrupt which can only be cleared when all the messages are released by setting the "},{"t":"field","v":"TWAI_RELEASE_BUF"},{"t":"text","v":" bit."}]}]}]}