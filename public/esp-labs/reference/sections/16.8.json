ASK_ENABLE_REG","offset":"0x0180","fields":[{"bits":"31:0","field":"WCL_CORE_0_NMI_MASK_ENABLE","access":"WO","reset":"0","desc":[{"t":"text","v":"Write any value to this field to start CPU0 masking any NMI interrupt."}]}]},{"t":"register","n":24,"num":"16.16","name":"WCL_CORE_0_NMI_MASK_TRIGGER_ADDR_REG","offset":"0x0184","fields":[{"bits":"31:0","field":"WCL_CORE_0_NMI_MASK_TRIGGER_ADDR","access":"R/W","reset":"0","desc":[{"t":"text","v":"Configures the address at which the NMI masking stops for CPU0."}]}]},{"t":"register","n":25,"num":"16.17","name":"WCL_CORE_0_NMI_MASK_DISABLE_REG","offset":"0x0188","fields":[{"bits":"31:0","field":"WCL_CORE_0_NMI_MASK_DISABLE","access":"WO","reset":"0","desc":[{"t":"text","v":"Write any value to this field so CPU0 checks NMI masking."}]}]},{"t":"register","n":26,"num":"16.18","name":"WCL_CORE_0_NMI_MASK_CANCLE_REG","offset":"0x018C","fields":[{"bits":"31:0","field":"WCL_CORE_0_NMI_MASK_CANCEL","access":"WO","reset":"0","desc":[{"t":"text","v":"Write any value to this field to cancel CPU0's NMI masking."}]}]},{"t":"register","n":27,"num":"16.19","name":"WCL_CORE_0_NMI_MASK_REG","offset":"0x0190","fields":[{"bits":"31:1","field":"(reserved)","access":"-","reset":"0","desc":[{"t":"text","v":"Reserved."}]},{"bits":"0","field":"WCL_CORE_0_NMI_MASK","access":"R/W","reset":"0","desc":[{"t":"text","v":"Set this bit to mask all the NMI interrupts in CPU0."}]}]},{"t":"register","n":28,"num":"16.20","name":"WCL_CORE_0_NMI_MASK_PHASE_REG","offset":"0x0194","fields":[{"bits":"31:1","field":"(reserved)","access":"-","reset":"0","desc":[{"t":"text","v":"Reserved."}]},{"bits":"0","field":"WCL_CORE_0_NMI_MASK_PHASE","access":"RO","reset":"0","desc":[{"t":"text","v":"Indicates if the NMI interrupt is being masked in CPU0. 1: masked; 0: not masked."}]}]}]}