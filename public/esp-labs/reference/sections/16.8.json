{"id":"16.8","doc":"T","title":"Registers","words":821,"blocks":[{"t":"p","s":[{"n":1,"c":[{"t":"text","v":"The addresses in this section are relative to the World Controller base address provided in Table 4.3-3 in "},{"t":"xref","id":"4","c":[{"t":"text","v":"Chapter 4"}]},{"t":"text","v":" System and Memory."}]}]},{"t":"p","s":[{"n":2,"c":[{"t":"text","v":"Note that, the section below only lists the registers for CPU0."}]},{"n":3,"c":[{"t":"text","v":"CPU1 shares exactly the same set of registers."}]},{"n":4,"c":[{"t":"text","v":"Adding 0x0400 to the offset of the equivalent of CPU0 register gives you address for CPU1 registers."}]},{"n":5,"c":[{"t":"text","v":"For example, the offset for CPU0 register "},{"t":"reg","v":"WCL_CORE_0_ENTRY_CHECK_REG"},{"t":"text","v":" is 0x007C, the offset for CPU1 equivalent "},{"t":"reg","v":"WCL_CORE_1_ENTRY_CHECK_REG"},{"t":"text","v":" should be 0x007C + 0x0400, which is 0x047C."}]}]},{"t":"h","level":4,"c":[{"t":"text","v":"Register 16.1. WCL_CORE_0_ENTRY_n_ADDR_REG (n: 1-13) (0x0000+4*(n-1))"}]},{"t":"table","head":[[{"t":"text","v":"Bits"}],[{"t":"text","v":"Field"}],[{"t":"text","v":"Access"}],[{"t":"text","v":"Reset"}],[{"t":"text","v":"Description"}]],"rows":[{"n":6,"c":[[{"t":"text","v":"31:0"}],[{"t":"text","v":"WCL_CORE_0_ENTRY_n_ADDR"}],[{"t":"text","v":"R/W"}],[{"t":"text","v":"0"}],[{"t":"text","v":"Configures the CPU0 Entry n address from Non-secure World to Secure World."}]]}]},{"t":"register","n":7,"num":"16.2","name":"WCL_CORE_0_ENTRY_CHECK_REG","offset":"0x007C","fields":[{"bits":"31:14","field":"(reserved)","access":"-","reset":"0","desc":[{"t":"text","v":"Reserved."}]},{"bits":"13:1","field":"WCL_CORE_0_ENTRY_CHECK","access":"R/W","reset":"1","desc":[{"t":"text","v":"Set this bit to enable CPU0 switching from Non-secure World to Secure world upon the monitored address."}]},{"bits":"0","field":"(reserved)","access":"-","reset":"0","desc":[{"t":"text","v":"Reserved."}]}]},{"t":"register","n":8,"num":"16.3","name":"WCL_CORE_0_MESSAGE_ADDR_REG","offset":"0x0100","fields":[{"bits":"31:0","field":"WCL_CORE_0_MESSAGE_ADDR","access":"R/W","reset":"0","desc":[{"t":"text","v":"Configures the address to write agreed sequence to clear write_buffer for CPU0."}]}]},{"t":"register","n":9,"num":"16.4","name":"WCL_CORE_0_MESSAGE_MAX_REG","offset":"0x0104","fields":[{"bits":"31:4","field":"(reserved)","access":"-","reset":"0","desc":[{"t":"text","v":"Reserved."}]},{"bits":"3:0","field":"WCL_CORE_0_MESSAGE_MAX","access":"R/W","reset":"0","desc":[{"t":"text","v":"Configures the agreed sequence to write to clear write_buffer for CPU0. It's advised to set this field to no less than 3."}]}]},{"t":"register","n":10,"num":"16.5","name":"WCL_CORE_0_MESSAGE_PHASE_REG","offset":"0x0108","fields":[{"bits":"31:7","field":"(reserved)","access":"-","reset":"0","desc":[{"t":"text","v":"Reserved."}]},{"bits":"6","field":"WCL_CORE_0_MESSAGE_ADDRESSPHASE","access":"RO","reset":"0","desc":[{"t":"text","v":"When 1, indicates CPU0 is checking if any sequence is written to the agreed address to clear write_buffer. This field is only used for debugging."}]},{"bits":"5","field":"WCL_CORE_0_MESSAGE_DATAPHASE","access":"RO","reset":"0","desc":[{"t":"text","v":"When 1, indicates CPU0 is checking if the agreed sequence is written to clear write_buffer. This field is only used for debugging."}]},{"bits":"4:1","field":"WCL_CORE_0_MESSAGE_EXPECT","access":"RO","reset":"0","desc":[{"t":"text","v":"Indicates the number to be written next for CPU0. This field is only used for debugging."}]},{"bits":"0","field":"WCL_CORE_0_MESSAGE_MATCH","access":"RO","reset":"0","desc":[{"t":"text","v":"Indicates if CPU0's world switch is successful. This field is only used for debugging."}]}]},{"t":"h","level":4,"c":[{"t":"text","v":"Register 16.6. WCL_CORE_0_STATUSTABLEn_REG (n: 1-13) (0x0080+4*(n-1))"}]},{"t":"table","head":[[{"t":"text","v":"Bits"}],[{"t":"text","v":"Field"}],[{"t":"text","v":"Access"}],[{"t":"text","v":"Reset"}],[{