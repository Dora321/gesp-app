{"id":"1.8.158","doc":"T","title":"EE.VMULAS.U16.ACCX","words":120,"blocks":[{"t":"p","s":[{"n":1,"c":[{"t":"b","c":[{"t":"text","v":"Instruction Word"}]},{"t":"text","v":" (bit layout, little-endian bit order)"}]}]},{"t":"table","head":[[{"t":"text","v":"000010100"}],[{"t":"text","v":"qy[2]"}],[{"t":"text","v":"0"}],[{"t":"text","v":"qy[1:0]"}],[{"t":"text","v":"qx[2:0]"}],[{"t":"text","v":"10000100"}]],"rows":[{"n":2,"c":[[{"t":"text","v":"9"}],[{"t":"text","v":"1"}],[{"t":"text","v":"1"}],[{"t":"text","v":"2"}],[{"t":"text","v":"3"}],[{"t":"text","v":"8"}]]}]},{"t":"p","s":[{"n":3,"c":[{"t":"b","c":[{"t":"text","v":"Assembler Syntax"}]}]}]},{"t":"pre","v":"EE.VMULAS.U16.ACCX qx, qy","lang":"text"},{"t":"p","s":[{"n":4,"c":[{"t":"b","c":[{"t":"text","v":"Description"}]}]}]},{"t":"p","s":[{"n":5,"c":[{"t":"text","v":"This instruction divides registers qx and qy into 8 data segments by 16 bits."}]},{"n":6,"c":[{"t":"text","v":"Then, it performs an unsigned multiply-accumulate operation on the 8 sets of segments respectively."}]},{"n":7,"c":[{"t":"text","v":"The accumulated result is added to the value in special register ACCX."}]},{"n":8,"c":[{"t":"text","v":"Then, the sum obtained is saturated and then stored in ACCX."}]}]},{"t":"p","s":[{"n":9,"c":[{"t":"b","c":[{"t":"text","v":"Operation"}]}]}]},{"t":"pre","v":"add0[31:0] = qx[ 15: 0] * qy[ 15: 0]\nadd1[31:0] = qx[ 31: 16] * qy[ 31: 16]\n...\nadd7[31:0] = qx[127:112] * qy[127:112]\nsum[40:0] = ACCX[39:0] + ad[31:0]d0[31:0] + ad[31:0]d1[31:0] + ... + ad[31:0]d 7[31:0]\n\nACCX[39:0] = min(max(sum[40:0], 0), 2^{40}-1)","lang":"text"}]}