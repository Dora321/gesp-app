{"id":"1.8.18","doc":"T","title":"EE.LD.128.USAR.XP","words":106,"blocks":[{"t":"p","s":[{"n":1,"c":[{"t":"b","c":[{"t":"text","v":"Instruction Word"}]},{"t":"text","v":" (bit layout, little-endian bit order)"}]}]},{"t":"table","head":[[{"t":"text","v":"10"}],[{"t":"text","v":"qu[2:1]"}],[{"t":"text","v":"1101"}],[{"t":"text","v":"qu[0]"}],[{"t":"text","v":"000"}],[{"t":"text","v":"ad[3:0]"}],[{"t":"text","v":"as[3:0]"}],[{"t":"text","v":"0100"}]],"rows":[{"n":2,"c":[[{"t":"text","v":"2"}],[{"t":"text","v":"2"}],[{"t":"text","v":"4"}],[{"t":"text","v":"1"}],[{"t":"text","v":"3"}],[{"t":"text","v":"4"}],[{"t":"text","v":"4"}],[{"t":"text","v":"4"}]]}]},{"t":"p","s":[{"n":3,"c":[{"t":"b","c":[{"t":"text","v":"Assembler Syntax"}]}]}]},{"t":"pre","v":"EE.LD.128.USAR.XP qu, as, ad","lang":"text"},{"t":"p","s":[{"n":4,"c":[{"t":"b","c":[{"t":"text","v":"Description"}]}]}]},{"t":"p","s":[{"n":5,"c":[{"t":"text","v":"This instruction forces the lower 4 bits of the access address in register as to 0 and loads 16-byte data from memory to register qu."}]},{"n":6,"c":[{"t":"text","v":"Meanwhile, it saves the value of the lower 4 bits in as to the special register SAR_BYTE."}]},{"n":7,"c":[{"t":"text","v":"After the access is completed, the value in register as is incremented by the value in register ad."}]}]},{"t":"p","s":[{"n":8,"c":[{"t":"b","c":[{"t":"text","v":"Operation"}]}]}]},{"t":"pre","v":"qu[127:0] = load128({as[31:4],4{0}})\nSAR_BYTE = as[3:0]\nas[31:0] = as[31:0] + ad[31:0]","lang":"text"}]}