{"id":"1.8.183","doc":"T","title":"EE.VPRELU.S8","words":170,"blocks":[{"t":"p","s":[{"n":1,"c":[{"t":"b","c":[{"t":"text","v":"Instruction Word"}]},{"t":"text","v":" (bit layout, little-endian bit order)"}]}]},{"t":"table","head":[[{"t":"text","v":"10"}],[{"t":"text","v":"qz[2:1]"}],[{"t":"text","v":"1100"}],[{"t":"text","v":"qz[0]"}],[{"t":"text","v":"qy[2]"}],[{"t":"text","v":"1"}],[{"t":"text","v":"qy[1:0]"}],[{"t":"text","v":"qx[2:0]"}],[{"t":"text","v":"ay[3:0]"}],[{"t":"text","v":"0100"}]],"rows":[{"n":2,"c":[[{"t":"text","v":"2"}],[{"t":"text","v":"2"}],[{"t":"text","v":"4"}],[{"t":"text","v":"1"}],[{"t":"text","v":"1"}],[{"t":"text","v":"1"}],[{"t":"text","v":"2"}],[{"t":"text","v":"3"}],[{"t":"text","v":"4"}],[{"t":"text","v":"4"}]]}]},{"t":"p","s":[{"n":3,"c":[{"t":"b","c":[{"t":"text","v":"Assembler Syntax"}]}]}]},{"t":"pre","v":"EE.VPRELU.S8 qz, qx, qy, ay","lang":"text"},{"t":"p","s":[{"n":4,"c":[{"t":"b","c":[{"t":"text","v":"Description"}]}]}]},{"t":"p","s":[{"n":5,"c":[{"t":"text","v":"This instruction divides register qx into 16 data segments by 8 bits."}]},{"n":6,"c":[{"t":"text","v":"If the value of the segment is not greater than 0, it will be multiplied by the value of the corresponding "},{"t":"num","v":"8-bit","k":"size"},{"t":"text","v":" segment in register qy and right-shifted by the lower "},{"t":"num","v":"5-bit","k":"size"},{"t":"text","v":" value in register ay, and then the calculated result will be assigned to the corresponding "},{"t":"num","v":"8-bit","k":"size"},{"t":"text","v":" data segment in register qz."}]},{"n":7,"c":[{"t":"text","v":"Otherwise, the value of the segment in qx will be assigned to qz."}]}]},{"t":"p","s":[{"n":8,"c":[{"t":"b","c":[{"t":"text","v":"Operation"}]}]}]},{"t":"pre","v":"qz[ 7: 0] = (qx[ 7: 0]<=0) ? (qx[ 7: 0] * qy[ 7: 0]) >> ay[4:0] : qx[ 7: 0]\nqz[ 15: 8] = (qx[ 15: 8]<=0) ? (qx[ 15: 8] * qy[ 15: 8]) >> ay[4:0] : qx[ 15: 8]\n...\nqz[127:120] = (qx[127:120]<=0) ? (qx[127:120] * qy[127:120]) >> ay[4:0] : qx [127:120]","lang":"text"}]}