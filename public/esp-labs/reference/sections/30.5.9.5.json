{"id":"30.5.9.5","doc":"T","title":"Configuration of Slave Segmented Transfer in Half-Duplex","words":173,"blocks":[{"t":"p","s":[{"n":1,"c":[{"t":"block","v":"GDMA","id":"gdma"},{"t":"text","v":" must be used in this mode."}],"warn":true},{"n":2,"c":[{"t":"text","v":"The register configuration procedure is as follows:"}]}]},{"t":"list","ordered":true,"items":[[{"t":"p","s":[{"n":3,"c":[{"t":"text","v":"Configure the IO path via IO MUX or GPIO matrix between "},{"t":"block","v":"GP-SPI","id":"spi"},{"t":"text","v":" and an external SPI device."}]}]}],[{"t":"p","s":[{"n":4,"c":[{"t":"text","v":"Configure APB clock (APB_CLK)."}]}]}],[{"t":"p","s":[{"n":5,"c":[{"t":"text","v":"Set "},{"t":"field","v":"SPI_SLAVE_MODE"},{"t":"text","v":" to enable slave mode."}]}]}],[{"t":"p","s":[{"n":6,"c":[{"t":"text","v":"Clear "},{"t":"field","v":"SPI_DOUTDIN"},{"t":"text","v":" to enable half-duplex communication."}]}]}],[{"t":"p","s":[{"n":7,"c":[{"t":"text","v":"Prepare data in registers "},{"t":"reg","v":"SPI_W0_REG"},{"t":"text","v":" ~ "},{"t":"reg","v":"SPI_W15_REG"},{"t":"text","v":", if needed."}]}]}],[{"t":"p","s":[{"n":8,"c":[{"t":"text","v":"Set "},{"t":"field","v":"SPI_DMA_AFIFO_RST"},{"t":"text","v":", "},{"t":"field","v":"SPI_BUF_AFIFO_RST"},{"t":"text","v":" and "},{"t":"field","v":"SPI_RX_AFIFO_RST"},{"t":"text","v":" to reset these buffers."}]}]}],[{"t":"p","s":[{"n":9,"c":[{"t":"text","v":"Set bits "},{"t":"field","v":"SPI_DMA_RX_ENA"},{"t":"text","v":" and "},{"t":"field","v":"SPI_DMA_TX_ENA"},{"t":"text","v":"."}]},{"n":10,"c":[{"t":"text","v":"Clear the bit "},{"t":"field","v":"SPI_RX_EOF_EN"},{"t":"text","v":"."}]},{"n":11,"c":[{"t":"text","v":"Configure GDMA TX/RX link and start GDMA TX/RX engine, as shown in "},{"t":"xref","id":"30.5.6","c":[{"t":"text","v":"Section 30.5.6"}]},{"t":"text","v":" and "},{"t":"xref","id":"30.5.7","c":[{"t":"text","v":"Section 30.5.7"}]},{"t":"text","v":"."}]}]}],[{"t":"p","s":[{"n":12,"c":[{"t":"text","v":"Set "},{"t":"field","