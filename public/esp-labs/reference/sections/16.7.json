{"id":"16.7","doc":"T","title":"Register Summary","words":321,"blocks":[{"t":"p","s":[{"n":1,"c":[{"t":"text","v":"The addresses in this section are relative to the World Controller base address provided in Table 4.3-3 in "},{"t":"xref","id":"4","c":[{"t":"text","v":"Chapter 4"}]},{"t":"text","v":" System and Memory."}]}]},{"t":"p","s":[{"n":2,"c":[{"t":"text","v":"Note that, the table below only lists the registers for CPU0."}]},{"n":3,"c":[{"t":"text","v":"CPU1 shares exactly the same set of registers."}]},{"n":4,"c":[{"t":"text","v":"Adding 0x0400 to the offset of the equivalent of CPU0 register gives you address for CPU1 registers."}]},{"n":5,"c":[{"t":"text","v":"For example, the offset for CPU0 register "},{"t":"reg","v":"WCL_CORE_0_ENTRY_CHECK_REG"},{"t":"text","v":" is 0x007C, the offset for CPU1 equivalent "},{"t":"reg","v":"WCL_CORE_1_ENTRY_CHECK_REG"},{"t":"text","v":" should be 0x007C + 0x0400, which is 0x047C."}]}]},{"t":"p","s":[{"n":6,"c":[{"t":"text","v":"The abbreviations given in Column Access are explained in Section Access Types for Registers."}]}]},{"t":"table","head":[[{"t":"text","v":"Name"}],[{"t":"text","v":"Description"}],[{"t":"text","v":"Address"}],[{"t":"text","v":"Access"}]],"rows":[{"n":7,"c":[[{"t":"b","c":[{"t":"text","v":"Non-secure World to Secure World Configuration Registers"}]}],[],[],[]]},{"n":8,"c":[[{"t":"text","v":"WCL_CORE_0_ENTRYn_ADDR_REG (n: 1-13)"}],[{"t":"text","v":"CPU0 Entry n Address Configuration Register"}],[{"t":"text","v":"0x0000 + 4*(n-1)"}],[{"t":"text","v":"R/W"}]]},{"n":9,"c":[[{"t":"reg","v":"WCL_CORE_0_ENTRY_CHECK_REG"}],[{"t":"text","v":"CPU0 Entry Check Enable Register"}],[{"t":"text","v":"0x007C"}],[{"t":"text","v":"R/W"}]]},{"n":10,"c":[[{"t":"reg","v":"WCL_CORE_0_MESSAGE_ADDR_REG"}],[{"t":"text","v":"CPU0 Clear Writer_buffer Configuration Register - Configures Address"}],[{"t":"text","v":"0x0100"}],[{"t":"text","v":"R/W"}]]},{"n":11,"c":[[{"t":"reg","v":"WCL_CORE_0_MESSAGE_MAX_REG"}],[{"t":"text","v":