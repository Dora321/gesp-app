{"id":"7.2.4.3","doc":"T","title":"Wi-Fi and Bluetooth LE Clock","words":58,"blocks":[{"t":"p","s":[{"n":1,"c":[{"t":"block","v":"Wi-Fi","id":"wifi"},{"t":"text","v":" and "},{"t":"block","v":"Bluetooth LE","id":"ble"},{"t":"text","v":" can work only when CPU_CLK uses "},{"t":"field","v":"PLL_CLK"},{"t":"text","v":" as its clock source."}]},{"n":2,"c":[{"t":"text","v":"Suspending "},{"t":"field","v":"PLL_CLK"},{"t":"text","v":" requires that Wi-Fi and Bluetooth LE has entered low-power mode first."}]}]},{"t":"p","s":[{"n":3,"c":[{"t":"text","v":"LOW_POWER_CLK uses XTAL32K_CLK, "},{"t":"field","v":"XTAL_CLK"},{"t":"text","v":", "},{"t":"field","v":"RC_FAST_CLK"},{"t":"text","v":" or RTC_SLOW_CLK (the low clock selected by RTC) as its clock source for Wi-Fi and Bluetooth LE in low-power mode."}]}]}]}