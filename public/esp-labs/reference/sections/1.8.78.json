{"id":"1.8.78","doc":"T","title":"EE.VADDS.S8.ST.INCP","words":155,"blocks":[{"t":"p","s":[{"n":1,"c":[{"t":"b","c":[{"t":"text","v":"Instruction Word"}]},{"t":"text","v":" (bit layout, little-endian bit order)"}]}]},{"t":"table","head":[[{"t":"text","v":"11100100"}],[{"t":"text","v":"qy[0]"}],[{"t":"text","v":"qv[2:0]"}],[{"t":"text","v":"1"}],[{"t":"text","v":"qa[2:0]"}],[{"t":"text","v":"qx[1:0]"}],[{"t":"text","v":"qy[2:1]"}],[{"t":"text","v":"0010"}],[{"t":"text","v":"as[3:0]"}],[{"t":"text","v":"111"}],[{"t":"text","v":"qx[2]"}]],"rows":[{"n":2,"c":[[{"t":"text","v":"8"}],[{"t":"text","v":"1"}],[{"t":"text","v":"3"}],[{"t":"text","v":"1"}],[{"t":"text","v":"3"}],[{"t":"text","v":"2"}],[{"t":"text","v":"2"}],[{"t":"text","v":"4"}],[{"t":"text","v":"4"}],[{"t":"text","v":"3"}],[{"t":"text","v":"1"}]]}]},{"t":"p","s":[{"n":3,"c":[{"t":"b","c":[{"t":"text","v":"Assembler Syntax"}]}]}]},{"t":"pre","v":"EE.VADDS.S8.ST.INCP qv, as, qa, qx, qy","lang":"text"},{"t":"p","s":[{"n":4,"c":[{"t":"b","c":[{"t":"text","v":"Description"}]}]}]},{"t":"p","s":[{"n":5,"c":[{"t":"text","v":"This instruction performs a vector addition on "},{"t":"num","v":"8-bit","k":"size"},{"t":"text","v":" data in the two registers qx and qy."}]},{"n":6,"c":[{"t":"text","v":"Then, the 16 results obtained from the calculation are saturated, and the saturated results are written to register qa."}]},{"n":7,"c":[{"t":"text","v":"During the operation, the instruction forces the lower 4 bits of the access address in register as to 0 and stores the value in register qv to memory."}]},{"n":8,"c":[{"t":"text","v":"After the access, the value in register as is incremented by 16."}]}]},{"t":"p","s":[{"n":9,"c":[{"t":"b","c":[{"t":"text","v":"Operation"}]}]}]},{"t":"pre","v":"qa[ 7: 0] = min(max(qx[ 7: 0] + qy[ 7: 0], -2^{7}), 2^{7}-1)\nqa[ 15: 8] = min(max(qx[ 15: 8] + qy[ 15: 8], -2^{7}), 2^{7}-1)\n...\n\nqv[127:0] => store128({as[31:4],4{0}})\nas[31:0] = as[31:0] + 16","lang":"text"}]}