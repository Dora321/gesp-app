{"id":"28.10.2.4","doc":"T","title":"Endian Control of Channel Storage Data","words":116,"blocks":[{"t":"p","s":[{"n":1,"c":[{"t":"text","v":"The received data is then converted into storage data (to be stored to memory) after some processing, such as discarding extra bits or filling zeros in missing bits."}]},{"n":2,"c":[{"t":"text","v":"The endian of the storage data is controlled by "},{"t":"field","v":"I2S_RX_BIG_ENDIAN"},{"t":"text","v":" under various data width, see the table below."}]}]},{"t":"table","caption":"Table 28.10-3. Channel Storage Data Endian","head":[[{"t":"text","v":"Channel Storage Data Width"}],[{"t":"text","v":"Origin Data"}],[{"t":"text","v":"Endian of Processed Data"}],[{"t":"text","v":"I2S_RX_BIG_ENDIAN"}]],"rows":[{"n":3,"c":[[{"t":"text","v":"32"}],[{"t":"text","v":"{B3, B2, B1, B0}"}],[{"t":"text","v":"{B3, B2, B1, B0}"}],[{"t":"text","v":"0"}]]},{"n":4,"c":[[{"t":"text","v":"32"}],[{"t":"text","v":"{B3, B2, B1, B0}"}],[{"t":"text","v":"{B0, B1, B2, B3}"}],[{"t":"text","v":"1"}]]},{"n":5,"c":[[{"t":"text","v":"24"}],[{"t":"text","v":"{B2, B1, B0}"}],[{"t":"text","v":"{B2, B1, B0}"}],[{"t":"text","v":"0"}]]},{"n":6,"c":[[{"t":"text","v":"24"}],[{"t":"text","v":"{B2, B1, B0}"}],[{"t":"text","v":"{B0, B1, B2}"}],[{"t":"text","v":"1"}]]},{"n":7,"c":[[{"t":"text","v":"16"}],[{"t":"text","v":"{B1, B0}"}],[{"t":"text","v":"{B1, B0}"}],[{"t":"text","v":"0"}]]},{"n":8,"c":[[{"t":"text","v":"16"}],[{"t":"text","v":"{B1, B0}"}],[{"t":"text","v":"{B0, B1}"}],[{"t":"text","v":"1"}]]},{"n":9,"c":[[{"t":"text","v":"8"}],[{"t":"text","v":"{B0}"}],[{"t":"text","v":"{B0}"}],[{"t":"text","v":"x"}]]}]}]}