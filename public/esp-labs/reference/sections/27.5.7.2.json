{"id":"27.5.7.2","doc":"T","title":"Configuration Example","words":624,"blocks":[{"t":"list","ordered":true,"items":[[{"t":"p","s":[{"n":1,"c":[{"t":"text","v":"Set "},{"t":"field","v":"I2C_MS_MODE"},{"t":"text","v":" (master) to 1, and "},{"t":"field","v":"I2C_MS_MODE"},{"t":"text","v":" (slave) to 0."}]}]}],[{"t":"p","s":[{"n":2,"c":[{"t":"text","v":"We recommend setting "},{"t":"field","v":"I2C_SLAVE_SCL_STRETCH_EN"},{"t":"text","v":" (slave) to 1, so that SCL can be held low for more processing time when "},{"t":"block","v":"I2C","id":"i2c"},{"t":"text","v":"~slave~ needs to send data."}]},{"n":3,"c":[{"t":"text","v":"If this bit is not set, software should write data to be sent to I2C~slave~'s TX RAM before I2C~master~ initiates transfer."}]},{"n":4,"c":[{"t":"text","v":"Configuration below is applicable to scenario where "},{"t":"field","v":"I2C_SLAVE_SCL_STRETCH_EN"},{"t":"text","v":" (slave) is 1."}]}]}],[{"t":"p","s":[{"n":5,"c":[{"t":"text","v":"Set "},{"t":"field","v":"I2C_FIFO_ADDR_CFG_EN"},{"t":"text","v":" (slave) to 1 to enable double addressing mode."}]}]}],[{"t":"p","s":[{"n":6,"c":[{"t":"text","v":"Write 1 to "},{"t":"field","v":"I2C_CONF_UPGATE"},{"t":"text","v":" (master) and "},{"t":"field","v":"I2C_CONF_UPGATE"},{"t":"text","v":" (slave) to synchronize registers."}]}]}],[{"t":"p","s":[{"n":7,"c":[{"t":"text","v":"Configure command registers of I2C~master~."}]}]}]]},{"t":"table","head":[[{"t":"text","v":"Command register"}],[{"t":"text","v":"op_code"}],[{"t":"text","v":"ack_value"}],[{"t":"text","v":"ack_exp"}],[{"t":"text","v":"ack_check_en"}],[{"t":"text","v":"byte_num"}]],"rows":[{"n":8,"c":[[{"t":"field","v":"I2C_COMMAND0"},{"t":"text","v":" (master)"}],[{"t":"text","v":"RSTART"}],[{"t":"text","v":"—"}],[{"t":"text","v":"—"}],[{"t":"text","v":"—"}],[{"t":"text","v":"—"}]]},{"n":9,"c":[[{"t":"field","v":"I2C_COMMAND1"},{"t":"text","v":" (master)"}],[{"t":"text","v":"WRITE"}],[{"t":"text","v":"0"}],[{"t":"text","v":"0"}],[{"t":"text","v":"1"}],[{"t":"text","v":"2"}]]},{"n":10,"c":[[{"t":"field","v":"I2C_COMMAND2"},{"t":"text","v":" (master)"}],[{"t":"text","v":"RSTART"}],[{"t":"text","v":"—"}],[{"t":"text","v":"—"}],[{"t":"text","v":"—"}],[{"t":"text","v":"—"}]]},{"n":11,"c":[[{"t":"field","v":"I2C_COMMAND3"},{"t":"text","v":" (master)"}],[{"t":"text","v":"WRITE"}],[{"t":"text","v":"0"}],[{"t":"text","v":"0"}],[{"t":"text","v":"1"}],[{"t":"text","v":"1"}]]},{"n":12,"c":[[{"t":"field","v":"I2C_COMMAND4"},{"t":"text","v":" (master)"}],[{"t":"text","v":"READ"}],[{"t":"text","v":"0"}],[{"t":"text","v":"0"}],[{"t":"text","v":"1"}],[{"t":"text","v":"N-1"}]]},{"n":13,"c":[[{"t":"field","v":"I2C_COMMAND5"},{"t":"text","v":" (master)"}],[{"t":"text","v":"READ"}],[{"t":"text","v":"1"}],[{"t":"text","v":"0"}],[{"t":"text","v":"1"}],[{"t":"text","v":"1"}]]},{"n":14,"c":[[{"t":"field","v":"I2C_COMMAND6"},{"t":"text","v":" (master)"}],[{"t":"text","v":"STOP"}],[{"t":"text","v":"—"}],[{"t":"text","v":"—"}],[{"t":"text","v":"—"}],[{"t":"text","v":"—"}]]}]},{"t":"list","ordered":true,"start":6,"items":[[{"t":"p","s":[{"n":15,"c":[{"t":"text","v":"Configure "},{"t":"field","v":"I2C_SLAVE_ADDR"},{"t":"text","v":" (slave) in "},{"t":"reg","v":"I2C_SLAVE_ADDR_REG"},{"t":"text","v":" (slave) register as I2C~slave~'s "},{"t":"num","v":"7-bit","k":"size"},{"t":"text","v":" address, and set "},{"t":"field","v":"I2C_ADDR_10BIT_EN"},{"t":"text","v":" (slave) to 0 to enable "},{"t":"num","v":"7-bit","k":"size"},{"t":"text","v":" addressing."}]}]}],[{"t":"p","s":[{"n":16,"c":[{"t":"text","v":"Write the address of I2C~slave~ and data to be sent to TX RAM of I2C~master~ in either FIFO or non-FIFO mode according to "},{"t":"xref","id":"27.4.10","c":[{"t":"text","v":"Section 27.4.10"}]},{"t":"text","v":"."}]},{"n":17,"c":[{"t":"text","v":"The first byte of address comprises ("},{"t":"field","v":"I2C_SLAVE_ADDR"},{"t":"text","v":"[6:0])<<1) and a R/W bit, which is 0 and indicates a WRITE."}]},{"n":18,"c":[{"t":"text","v":"The second byte of address is memory address M of I2C~slave~."}]},{"n":19,"c":[{"t":"text","v":"The third byte is ("},{"t":"field","v":"I2C_SLAVE_ADDR"},{"t":"text","v":"[6:0])<<1) and a R/W bit, which is 1 and indicates a READ."}]}]}],[{"t":"p","s":[{"n":20,"c":[{"t":"text","v":"Write 1 to "},{"t":"field","v":"I2C_CONF_UPGATE"},{"t":"text","v":" (master) and "},{"t":"field","v":"I2C_CONF_UPGATE"},{"t":"text","v":" (slave) to synchronize registers."}]}]}],[{"t":"p","s":[{"n":21,"c":[{"t":"text","v":"Write 1 to "},{"t":"field","v":"I2C_TRANS_START"},{"t":"text","v":" (master) to start I2C~master~'s transfer."}]}]}],[{"t":"p","s":[{"n":22,"c":[{"t":"text","v":"Start I2C~slave~'s transfer according to "},{"t":"xref","id":"27.4.14","c":[{"t":"text","v":"Section 27.4.14"}]},{"t":"text","v":"."}]}]}],[{"t":"p","s":[{"n":23,"c":[{"t":"text","v":"I2C~slave~ compares the slave address sent by I2C~master~ with its own address in "},{"t":"field","v":"I2C_SLAVE_ADDR"},{"t":"text","v":" (slave)."}]},{"n":24,"c":[{"t":"text","v":"When ack_check_en (master) in I2C~master~'s WRITE command is 1, I2C~master~ checks ACK value each time it sends a byte."}]},{"n":25,"c":[{"t":"text","v":"When ack_check_en (master) is 0, I2C~master~ does not check ACK value and take I2C~slave~ as matching slave by default."}]}]},{"t":"list","ordered":false,"items":[[{"t":"p","s":[{"n":26,"c":[{"t":"text","v":"Match: If the received ACK value matches ack_exp (master) (the expected ACK value), I2C~master~ continues data transfer."}]}]}],[{"t":"p","s":[{"n":27,"c":[{"t":"text","v":"Not match: If the received ACK value does not match ack_exp, I2C~master~ generates an I2C_NACK_INT (master) interrupt and stops data transfer."}]}]}]]}],[{"t":"p","s":[{"n":28,"c":[{"t":"text","v":"I2C~slave~ receives memory address sent by I2C~master~ and adds the offset."}]}]}],[{"t":"p","s":[{"n":29,"c":[{"t":"text","v":"I2C~master~ sends a RSTART and the third byte in TX RAM, which is ((0x78 | "},{"t":"field","v":"I2C_SLAVE_ADDR"},{"t":"text","v":"[6:0])<<1) and an R bit."}]}]}],[{"t":"p","s":[{"n":30,"c":[{"t":"text","v":"I2C~slave~ repeats step 11."}]},{"n":31,"c":[{"t":"text","v":"If its address matches the address sent by I2C~master~, I2C~slave~ proceed on to the next steps."}]}]}],[{"t":"p","s":[{"n":32,"c":[{"t":"text","v":"After I2C_SLAVE_STRETCH_INT (slave) is generated, the "},{"t":"field","v":"I2C_STRETCH_CAUSE"},{"t":"text","v":" bit is 0."}]},{"n":33,"c":[{"t":"text","v":"The address of I2C~slave~ matches the address sent over SDA, and I2C~slave~ needs to send data."}]}]}],[{"t":"p","s":[{"n":34,"c":[{"t":"text","v":"Write data to be sent to TX RAM of I2C~slave~ in either FIFO mode or non-FIFO mode according to "},{"t":"xref","id":"27.4.10","c":[{"t":"text","v":"Section 27.4.10"}]},{"t":"text","v":"."}]}]}],[{"t":"p","s":[{"n":35,"c":[{"t":"text","v":"Set "},{"t":"field","v":"I2C_SLAVE_SCL_STRETCH_CLR"},{"t":"text","v":" (slave) to 1 to release SCL."}]}]}],[{"t":"p","s":[{"n":36,"c":[{"t":"text","v":"I2C~slave~ sends data, and I2C~master~ checks ACK value or not according to ack_check_en (master) in the READ command."}]}]}],[{"t":"p","s":[{"n":37,"c":[{"t":"text","v":"If data to be read by I2C~master~ is larger than "},{"t":"num","v":"32 bytes","k":"size"},{"t":"text","v":", an I2C_SLAVE_STRETCH_INT (slave) interrupt will be generated when TX RAM of I2C~slave~ becomes empty."}]},{"n":38,"c":[{"t":"text","v":"In this way, I2C~slave~ can hold SCL low, so that software has more time to pad data in TX RAM of I2C~slave~ and read data in RX RAM of I2C~master~."}]},{"n":39,"c":[{"t":"text","v":"After software has finished reading, you can set "},{"t":"field","v":"I2C_SLAVE_STRETCH_INT_CLR"},{"t":"text","v":" (slave) to 1 to clear interrupt, and set "},{"t":"field","v":"I2C_SLAVE_SCL_STRETCH_CLR"},{"t":"text","v":" (slave) to release the SCL line."}]}]}],[{"t":"p","s":[{"n":40,"c":[{"t":"text","v":"After I2C~master~ has received the last byte of data, set ack_value (master) to 1."}]},{"n":41,"c":[{"t":"text","v":"I2C~slave~ will stop transfer once receiving the I2C_NACK_INT interrupt."}]}]}],[{"t":"p","s":[{"n":42,"c":[{"t":"text","v":"After data transfer completes, I2C~master~ executes the STOP command, and generates an I2C_TRANS_COMPLETE_INT (master) interrupt."}]}]}]]}]}