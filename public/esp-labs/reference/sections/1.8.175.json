{"id":"1.8.175","doc":"T","title":"EE.VMULAS.U8.QACC","words":181,"blocks":[{"t":"p","s":[{"n":1,"c":[{"t":"b","c":[{"t":"text","v":"Instruction Word"}]},{"t":"text","v":" (bit layout, little-endian bit order)"}]}]},{"t":"table","head":[[{"t":"text","v":"000010100"}],[{"t":"text","v":"qy[2]"}],[{"t":"text","v":"1"}],[{"t":"text","v":"qy[1:0]"}],[{"t":"text","v":"qx[2:0]"}],[{"t":"text","v":"11000100"}]],"rows":[{"n":2,"c":[[{"t":"text","v":"9"}],[{"t":"text","v":"1"}],[{"t":"text","v":"1"}],[{"t":"text","v":"2"}],[{"t":"text","v":"3"}],[{"t":"text","v":"8"}]]}]},{"t":"p","s":[{"n":3,"c":[{"t":"b","c":[{"t":"text","v":"Assembler Syntax"}]}]}]},{"t":"pre","v":"EE.VMULAS.U8.QACC qx, qy","lang":"text"},{"t":"p","s":[{"n":4,"c":[{"t":"b","c":[{"t":"text","v":"Description"}]}]}]},{"t":"p","s":[{"n":5,"c":[{"t":"text","v":"This instruction divides registers qx and qy into 16 data segments by 8 bits."}]},{"n":6,"c":[{"t":"text","v":"Then, the unsigned multiplication result of the 16 sets of segments is added to the corresponding "},{"t":"num","v":"20-bit","k":"size"},{"t":"text","v":" data segment in special registers QACC_H and QACC_L respectively."}]},{"n":7,"c":[{"t":"text","v":"The calculated result is saturated to a "},{"t":"num","v":"20-bit","k":"size"},{"t":"text","v":" unsigned number and then stored to the corresponding "},{"t":"num","v":"20-bit","k":"size"},{"t":"text","v":" data segment in QACC_H and QACC_L."}]}]},{"t":"p","s":[{"n":8,"c":[{"t":"b","c":[{"t":"text","v":"Operation"}]}]}]},{"t":"pre","v":"QACC_L[ 19: 0] = min(QACC_L[ 19: 0] + qx[ 7: 0] * qy[ 7: 0], 2^{20}-1)\nQACC_L[ 39: 20] = min(QACC_L[ 39: 20] + qx[ 15: 8] * qy[ 15: 8], 2^{w0}-1)\n...\nQACC_L[159:140] = min(QACC_L[159:140] + qx[ 63: 56] * qy[ 63: 56], 2^{20}-1)\nQACC_H[ 19: 0] = min(QACC_H[ 19: 0] + qx[ 71: 64] * qy[ 71: 64], 2^{20}-1)\nQACC_H[ 39: 20] = min(QACC_H[ 39: 20] + qx[ 79: 72] * qy[ 79: 72], 2^{20}-1)\n...\nQACC_H[159:140] = min(QACC_H[159:140] + qx[127:120] * qy[127:120], 2^{20}-1)","lang":"text"}]}