{"id":"12.3.2","doc":"T","title":"Timer as One-shot Alarm","words":72,"blocks":[{"t":"list","ordered":true,"items":[[{"t":"p","s":[{"n":1,"c":[{"t":"text","v":"Configure the time-base counter following step 1 of "},{"t":"xref","id":"12.3.1","c":[{"t":"text","v":"Section 12.3.1"}]},{"t":"text","v":"."}]}]}],[{"t":"p","s":[{"n":2,"c":[{"t":"text","v":"Configure the alarm."}]}]},{"t":"list","ordered":false,"items":[[{"t":"p","s":[{"n":3,"c":[{"t":"text","v":"Configure the alarm value by setting TIMG_TxALARMLO_REG and TIMG_TxALARMHI_REG."}]}]}],[{"t":"p","s":[{"n":4,"c":[{"t":"text","v":"Enable interrupt by setting TIMG_Tx_INT_ENA."}]}]}]]}],[{"t":"p","s":[{"n":5,"c":[{"t":"text","v":"Disable auto reload by clearing TIMG_Tx_AUTORELOAD."}]}]}],[{"t":"p","s":[{"n":6,"c":[{"t":"text","v":"Start the alarm by setting TIMG_Tx_ALARM_EN."}]}]}],[{"t":"p","s":[{"n":7,"c":[{"t":"text","v":"Handle the alarm interrupt."}]}]},{"t":"list","ordered":false,"items":[[{"t":"p","s":[{"n":8,"c":[{"t":"text","v":"Clear the interrupt by setting the timer's corresponding bit in TIMG_Tx_INT_CLR."}]}]}],[{"t":"p","s":[{"n":9,"c":[{"t":"text","v":"Disable the timer by clearing TIMG_Tx_EN."}]}]}]]}]]}]}