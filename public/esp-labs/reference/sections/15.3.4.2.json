{"id":"15.3.4.2","doc":"T","title":"Access Configuration","words":281,"blocks":[{"t":"p","s":[{"n":1,"c":[{"t":"text","v":"Both ESP32-S3's RTCSlow_0 and RTCSlow_1 can be further split into 2 regions."}]},{"n":2,"c":[{"t":"text","v":"Each split region can be configured independently with different access by configuring respective registers (PMS_CORE_m_PIF_PMS_CONSTRAN_n_REG)."}]},{"n":3,"c":[{"t":"text","v":"Note that split regions can be configured independently for CPU0 and CPU1 and for the Secure World and Non-secure World."}]}]},{"t":"p","s":[{"n":4,"c":[{"t":"text","v":"The registers for splitting RTC SLOW Memory into 4 split regions are described below:"}]}]},{"t":"table","caption":"Table 15.3-15. Split RTCSlow_0 and RTCSlow_1 into Split Regions","head":[[{"t":"text","v":"Memory"}],[{"t":"text","v":"Split Regions"}],[{"t":"text","v":"Configuration Registers (1), Secure World"}],[{"t":"text","v":"Configuration Registers (1), Non-secure World"}]],"rows":[{"n":5,"c":[[{"t":"text","v":"RTCSlow_0"}],[{"t":"text","v":"Higher Region"}],[{"t":"reg","v":"PIF_PMS_CONSTRAN_11_REG"},{"t":"text","v":" [10:0]"}],[{"t":"reg","v":"PIF_PMS_CONSTRAN_9_REG"},{"t":"text","v":" [21:11]"}]]},{"n":6,"c":[[{"t":"text","v":"RTCSlow_0"}],[{"t":"text","v":"Lower Region"}],[{"t":"reg","v":"PIF_PMS_CONSTRAN_11_REG"},{"t":"text","v":" [10:0]"}],[{"t":"reg","v":"PIF_PMS_CONSTRAN_9_REG"},{"t":"text","v":" [21:11]"}]]},{"n":7,"c":[[{"t":"text","v":"RTCSlow_1"}],[{"t":"text","v":"Higher Region"}],[{"t":"reg","v":"PIF_PMS_CONSTRAN_13_REG"},{"t":"text","v":" [10:0]"}],[{"t":"reg","v":"PIF_PMS_CONSTRAN_13_REG"},{"t":"text","v":" [21:11]"}]]},{"n":8,"c":[[{"t":"text","v":"RTCSlow_1"}],[{"t":"text","v":"Lower Region"}],[{"t":"reg","v":"PIF_PMS_CONSTRAN_13_REG"},{"t":"text","v":" [10:0]"}],[{"t":"reg","v":"PIF_PMS_CONSTRAN_13_REG"},{"t":"text","v":" [21:11]"}]]}]},{"t":"p","s":[{"n":9,"c":[{"t":"text","v":"1 The offset from the RTC SLOW Memory base address should be used when configuring the split address."}]},{"n":10,"c":[{"t":"text","v":"For example, if you want to split the RTC SLOW Memory at 0x6002_2000, then write 0x1000 to this register."}]}]},{"t":"p","s":[{"n":11,"c":[{"t":"text","v":"Access configuration to the split regions of RTC SLOW Memory is described below:"}]}]},{"t":"table","caption":"Table 15.3-16. Access Configuration to the RTC SLOW Memory","head":[[{"t":"text","v":"Bus"}],[{"t":"text","v":"Mem"}],[{"t":"text","v":"Split Regions"}],[{"t":"text","v":"Secure World"}],[{"t":"text","v":"Non-secure World"}],[{"t":"text","v":"Access"}]],"rows":[{"n":12,"c":[[{"t":"text","v":"Peri Bus (PIF)"}],[{"t":"text","v":"RTCSlow_0"}],[{"t":"text","v":"Higher (A)"}],[{"t":"reg","v":"PIF_PMS_CONSTRAN_12_REG"},{"t":"text","v":" [5:3] (C)"}],[{"t":"reg","v":"PIF_PMS_CONSTRAN_12_REG"},{"t":"text","v":" [11:9]"}],[{"t":"text","v":"X/W/R"}]]},{"n":13,"c":[[{"t":"text","v":"Peri Bus (PIF)"}],[{"t":"text","v":"RTCSlow_0"}],[{"t":"text","v":"Lower (B)"}],[{"t":"reg","v":"PIF_PMS_CONSTRAN_12_REG"},{"t":"text","v":" [2:0]"}],[{"t":"reg","v":"PIF_PMS_CONSTRAN_12_REG"},{"t":"text","v":" [8:6]"}],[{"t":"text","v":"X/W/R"}]]},{"n":14,"c":[[{"t":"text","v":"Peri Bus (PIF)"}],[{"t":"text","v":"RTCSlow_1"}],[{"t":"text","v":"Higher (A)"}],[{"t":"reg","v":"PIF_PMS_CONSTRAN_14_REG"},{"t":"text","v":" [5:3]"}],[{"t":"reg","v":"PIF_PMS_CONSTRAN_14_REG"},{"t":"text","v":" [11:9]"}],[{"t":"text","v":"X/W/R"}]]},{"n":15,"c":[[{"t":"text","v":"Peri Bus (PIF)"}],[{"t":"text","v":"RTCSlow_1"}],[{"t":"text","v":"Lower (B)"}],[{"t":"reg","v":"PIF_PMS_CONSTRAN_14_REG"},{"t":"text","v":" [2:0]"}],[{"t":"reg","v":"PIF_PMS_CONSTRAN_14_REG"},{"t":"text","v":" [8:6]"}],[{"t":"text","v":"X/W/R"}]]}]},{"t":"p","s":[{"n":16,"c":[{"t":"text","v":"A Higher is short for Higher Region."}]},{"n":17,"c":[{"t":"text","v":"B Lower is short for Lower Region."}]},{"n":18,"c":[{"t":"text","v":"C For example, configuring this field to 0b100 indicates CPU's peripheral (PIF) bus is granted with the instruction execution access but not the write or read accesses from the Secure WORLD to the higher region of RTCSLOW_0."}]}]}]}