{"id":"2.7.3.1","doc":"T","title":"Instruction Format","words":96,"blocks":[{"t":"p","s":[{"n":1,"c":[{"t":"text","v":"The format of RTC "},{"t":"block","v":"I2C","id":"i2c"},{"t":"text","v":" instruction is basically consistent with that of I2C0/I2C1, see Section I2C CMD Controller in "},{"t":"xref","id":"27","c":[{"t":"text","v":"Chapter 27"}]},{"t":"text","v":" I2C Controller (I2C) except the following:"}]}]},{"t":"list","ordered":false,"items":[[{"t":"p","s":[{"n":2,"c":[{"t":"text","v":"RTC I2C has different op_code mapping:"}]}]},{"t":"list","ordered":false,"items":[[{"t":"p","s":[{"n":3,"c":[{"t":"text","v":"RSTART: op_code = 0"}]}]}],[{"t":"p","s":[{"n":4,"c":[{"t":"text","v":"WRITE: op_code = 1"}]}]}],[{"t":"p","s":[{"n":5,"c":[{"t":"text","v":"READ: op_code = 2"}]}]}],[{"t":"p","s":[{"n":6,"c":[{"t":"text","v":"STOP: op_code = 3"}]}]}],[{"t":"p","s":[{"n":7,"c":[{"t":"text","v":"END: op_code = 4"}]}]}]]}],[{"t":"p","s":[{"n":8,"c":[{"t":"text","v":"RTC I2C provides fixed instructions for different operations, as follows:"}]}]},{"t":"list","ordered":false,"items":[[{"t":"p","s":[{"n":9,"c":[{"t":"text","v":"Command 0 ~ Command 1: specifically for I2C write operation"}]}]}],[{"t":"p","s":[{"n":10,"c":[{"t":"text","v":"Command 2 ~ Command 6: specifically for I2C read operation"}]}]}]]}]]},{"t":"p","s":[{"n":11,"c":[{"t":"text","v":"Note: All slave addresses are expressed in 7 bits."}],"warn":true}]}]}