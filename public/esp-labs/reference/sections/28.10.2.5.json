{"id":"28.10.2.5","doc":"T","title":"A-law/µ-law Compression and Decompression","words":93,"blocks":[{"t":"p","s":[{"n":1,"c":[{"t":"text","v":"ESP32-S3 "},{"t":"block","v":"I2S","id":"i2s"},{"t":"i","c":[{"t":"text","v":"n"}]},{"t":"text","v":" compresses/decompresses the data to be stored in "},{"t":"num","v":"32-bit","k":"size"},{"t":"text","v":" by A-law or by µ-law."}]},{"n":2,"c":[{"t":"text","v":"By default, zeros are filled to high bits."}]}]},{"t":"p","s":[{"n":3,"c":[{"t":"text","v":"Configure "},{"t":"field","v":"I2S_RX_PCM_BYPASS"},{"t":"text","v":" to:"}]}]},{"t":"list","ordered":false,"items":[[{"t":"p","s":[{"n":4,"c":[{"t":"text","v":"0: Compress or decompress the data."}]}]}],[{"t":"p","s":[{"n":5,"c":[{"t":"text","v":"1: Do not compress or decompress the data."}],"warn":true}]}]]},{"t":"p","s":[{"n":6,"c":[{"t":"text","v":"Configure "},{"t":"field","v":"I2S_RX_PCM_CONF"},{"t":"text","v":" to:"}]}]},{"t":"list","ordered":false,"items":[[{"t":"p","s":[{"n":7,"c":[{"t":"text","v":"0: Decompress the data using A-law."}]}]}],[{"t":"p","s":[{"n":8,"c":[{"t":"text","v":"1: Compress the data using A-law."}]}]}],[{"t":"p","s":[{"n":9,"c":[{"t":"text","v":"2: Decompress the data using µ-law."}]}]}],[{"t":"p","s":[{"n":10,"c":[{"t":"text","v":"3: Compress the data using µ-law."}]}]}]]},{"t":"p","s":[{"n":11,"c":[{"t":"text","v":"At this point, the data format control is complete."}]},{"n":12,"c":[{"t":"text","v":"Data then is stored into memory via DMA."}]}]}]}