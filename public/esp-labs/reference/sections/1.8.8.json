{"id":"1.8.8","doc":"T","title":"EE.FFT.AMS.S16.LD.INCP.UAUP","words":324,"blocks":[{"t":"p","s":[{"n":1,"c":[{"t":"b","c":[{"t":"text","v":"Instruction Word"}]},{"t":"text","v":" (bit layout, little-endian bit order)"}]}]},{"t":"table","head":[[{"t":"text","v":"110101"}],[{"t":"text","v":"sel2[0]"}],[{"t":"text","v":"qz1[2]"}],[{"t":"text","v":"qz[0]"}],[{"t":"text","v":"qy[2:0]"}],[{"t":"text","v":"qz1[1]"}],[{"t":"text","v":"qm[2:0]"}],[{"t":"text","v":"qx[1:0]"}],[{"t":"text","v":"qz[2:1]"}],[{"t":"text","v":"qz1[0]"}],[{"t":"text","v":"qu[2:0]"}],[{"t":"text","v":"as[3:0]"}],[{"t":"text","v":"111"}],[{"t":"text","v":"qx[2]"}]],"rows":[{"n":2,"c":[[{"t":"text","v":"6"}],[{"t":"text","v":"1"}],[{"t":"text","v":"1"}],[{"t":"text","v":"1"}],[{"t":"text","v":"3"}],[{"t":"text","v":"1"}],[{"t":"text","v":"3"}],[{"t":"text","v":"2"}],[{"t":"text","v":"2"}],[{"t":"text","v":"1"}],[{"t":"text","v":"3"}],[{"t":"text","v":"4"}],[{"t":"text","v":"3"}],[{"t":"text","v":"1"}]]}]},{"t":"p","s":[{"n":3,"c":[{"t":"b","c":[{"t":"text","v":"Assembler Syntax"}]}]}]},{"t":"pre","v":"EE.FFT.AMS.S16.LD.INCP.UAUP qu, as, qz, qz1, qx, qy, qm, sel2","lang":"text"},{"t":"p","s":[{"n":4,"c":[{"t":"b","c":[{"t":"text","v":"Description"}]}]}]},{"t":"p","s":[{"n":5,"c":[{"t":"text","v":"It is a dedicated FFT instruction to perform addition, subtraction, multiplication, addition and subtraction, and shift operations on "},{"t":"num","v":"16-bit","k":"size"},{"t":"text","v":" data segments."}]}]},{"t":"p","s":[{"n":6,"c":[{"t":"text","v":"During the operation, the lower 4 bits of the access address in the register as are forced to be 0, and then the 16-byte data is loaded from the memory."}]},{"n":7,"c":[{"t":"text","v":"The instruction joins the loaded data and the data in special register UA_STATE into 32-byte data, right-shifts the 32-byte data by the result of the SAR_BYTE value multiplied by 8, and assigns the lower 128 bits of the shifted result to register qu."}]},{"n":8,"c":[{"t":"text","v":"Meanwhile, register UA_STATE is updated with the loaded 16-byte data."}]},{"n":9,"c":[{"t":"text","v":"After the access, the value in register as is incremented by 16."}]}]},{"t":"p","s":[{"n":10,"c":[{"t":"b","c":[{"t":"text","v":"Operation"}]}]}]},{"t":"pre","v":"  temp0[15:0] = qx[ 15: 0] + qy[ 15: 0]\n  temp1[15:0] = qx[ 31: 16] - qy[ 31: 16]\n\nif sel2==0:\n  temp2[15:0] = ((qx[ 15: 0] - qy[ 15: 0]) * qm[ 15: 0] - (qx[ 31: 16] + qy[ 31: 16]) * qm[ 31: 16]) >> SAR\n  temp3[15:0] = ((qx[ 15: 0] - qy[ 15: 0]) * qm[ 31: 16] + (qx[ 31: 16] + qy[ 31: 16]) * qm[ 15: 0]) >> SAR\nif sel2==1:\n  temp2[15:0] = ((qx[ 31: 16] + qy[ 31: 16]) * qm[ 31: 16] + (qx[ 15: 0] - qy[ 15: 0]) * qm[ 15: 0]) >> SAR\n  temp3[15:0] = ((qx[ 31: 16] + qy[ 31: 16]) * qm[ 15: 0] - (qx[ 15: 0] - qy[ 15: 0]) * qm[ 31: 16]) >> SAR\n\n  dataIn[127:0] = load128({as[31:4],4{0}})\n  qz[15: 0] = temp0[15:0] + temp2[15:0]\n  qz[31: 16] = temp1[15:0] + temp3[15:0]\n  qz1[15: 0] = temp0[15:0] - temp2[15:0]\n  qz1[31:16] = temp3[15:0] - temp1[15:0]\n  qu[127: 0] = {dataIn[127:0], UA_STATE[127:0]} >> {SAR_BYTE[3:0] << 3}\n  UA_STATE[127:0] = dataIn[127:0]\n  as[31:0] = as[31:0] + 16","lang":"text"}]}