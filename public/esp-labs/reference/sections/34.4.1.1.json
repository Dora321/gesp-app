{"id":"34.4.1.1","doc":"T","title":"Bus Interface Unit (BIU)","words":69,"blocks":[{"t":"p","s":[{"n":1,"c":[{"t":"text","v":"The BIU provides the access to registers and RAM data through the Host Interface Unit (HIU)."}]},{"n":2,"c":[{"t":"text","v":"Additionally, it provides a method to access to memory data through a DMA interface."}]},{"n":3,"c":[{"t":"text","v":"Figure 34.4-1 illustrates the internal components of the BIU."}]},{"n":4,"c":[{"t":"text","v":"Figure 34.10-1 illustrates the clock selection."}]},{"n":5,"c":[{"t":"text","v":"The BIU provides the following functions:"}]}]},{"t":"list","ordered":false,"items":[[{"t":"p","s":[{"n":6,"c":[{"t":"text","v":"Host interface"}]}]}],[{"t":"p","s":[{"n":7,"c":[{"t":"text","v":"DMA interface"}]}]}],[{"t":"p","s":[{"n":8,"c":[{"t":"text","v":"Interrupt control"}]}]}],[{"t":"p","s":[{"n":9,"c":[{"t":"text","v":"Register access"}]}]}],[{"t":"p","s":[{"n":10,"c":[{"t":"text","v":"FIFO access"}]}]}],[{"t":"p","s":[{"n":11,"c":[{"t":"text","v":"Power/pull-up control and card detection"}]}]}]]}]}