{"id":"34.4.2","doc":"T","title":"Command Path","words":68,"blocks":[{"t":"p","s":[{"n":1,"c":[{"t":"text","v":"The command path performs the following functions:"}]}]},{"t":"list","ordered":false,"items":[[{"t":"p","s":[{"n":2,"c":[{"t":"text","v":"Configures clock parameters"}]}]}],[{"t":"p","s":[{"n":3,"c":[{"t":"text","v":"Configures card command parameters"}]}]}],[{"t":"p","s":[{"n":4,"c":[{"t":"text","v":"Sends commands to card bus (sdhost_ccmd_out line)"}]}]}],[{"t":"p","s":[{"n":5,"c":[{"t":"text","v":"Receives responses from card bus (sdhost_ccmd_in line)"}]}]}],[{"t":"p","s":[{"n":6,"c":[{"t":"text","v":"Sends responses to BIU"}]}]}],[{"t":"p","s":[{"n":7,"c":[{"t":"text","v":"Drives the P-bit on the command line"}]}]}]]},{"t":"p","s":[{"n":8,"c":[{"t":"text","v":"The command path State Machine is shown in Figure 34.4-2."}]}]},{"t":"fig","src":"images/trm-fig-34_4-2.png","alt":"Figure 34.4-2. Command Path State Machine","caption":"Figure 34.4-2. Command Path State Machine"}]}