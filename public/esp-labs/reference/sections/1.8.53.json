{"id":"1.8.53","doc":"T","title":"EE.SRCI.2Q","words":109,"blocks":[{"t":"p","s":[{"n":1,"c":[{"t":"b","c":[{"t":"text","v":"Instruction Word"}]},{"t":"text","v":" (bit layout, little-endian bit order)"}]}]},{"t":"table","head":[[{"t":"text","v":"11"}],[{"t":"text","v":"qs1[2:1]"}],[{"t":"text","v":"1100"}],[{"t":"text","v":"qs1[0]"}],[{"t":"text","v":"qs0[2:0]"}],[{"t":"text","v":"1010"}],[{"t":"text","v":"sar16[3:0]"}],[{"t":"text","v":"0100"}]],"rows":[{"n":2,"c":[[{"t":"text","v":"2"}],[{"t":"text","v":"2"}],[{"t":"text","v":"4"}],[{"t":"text","v":"1"}],[{"t":"text","v":"3"}],[{"t":"text","v":"4"}],[{"t":"text","v":"4"}],[{"t":"text","v":"4"}]]}]},{"t":"p","s":[{"n":3,"c":[{"t":"b","c":[{"t":"text","v":"Assembler Syntax"}]}]}]},{"t":"pre","v":"EE.SRCI.2Q qs1, qs0, sar16","lang":"text"},{"t":"p","s":[{"n":4,"c":[{"t":"b","c":[{"t":"text","v":"Description"}]}]}]},{"t":"p","s":[{"n":5,"c":[{"t":"text","v":"This instruction performs a logical right shift on the 32-byte concatenation of registers qs0 and qs1 and pads the higher bits with 0."}]},{"n":6,"c":[{"t":"text","v":"The upper 128 bits of the shift result is written to register qs1 and the lower 128 bits is written to qs0."}]},{"n":7,"c":[{"t":"text","v":"The right shift amount is 8 times the sum of sar16 and 1."}]}]},{"t":"p","s":[{"n":8,"c":[{"t":"b","c":[{"t":"text","v":"Operation"}]}]}]},{"t":"pre","v":"{qs1[127: 0], qs0[127: 0]} = {qs1[127: 0], qs0[127: 0]} >> ((sar16+1)*8)\nqs1[127:127-8*sar16] = 0","lang":"text"}]}