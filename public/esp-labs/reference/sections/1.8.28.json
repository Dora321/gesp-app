{"id":"1.8.28","doc":"T","title":"EE.LDF.64.XP","words":104,"blocks":[{"t":"p","s":[{"n":1,"c":[{"t":"b","c":[{"t":"text","v":"Instruction Word"}]},{"t":"text","v":" (bit layout, little-endian bit order)"}]}]},{"t":"table","head":[[{"t":"text","v":"fu0[3:0]"}],[{"t":"text","v":"0110"}],[{"t":"text","v":"fu1[3:0]"}],[{"t":"text","v":"ad[3:0]"}],[{"t":"text","v":"as[3:0]"}],[{"t":"text","v":"0000"}]],"rows":[{"n":2,"c":[[{"t":"text","v":"4"}],[{"t":"text","v":"4"}],[{"t":"text","v":"4"}],[{"t":"text","v":"4"}],[{"t":"text","v":"4"}],[{"t":"text","v":"4"}]]}]},{"t":"p","s":[{"n":3,"c":[{"t":"b","c":[{"t":"text","v":"Assembler Syntax"}]}]}]},{"t":"pre","v":"EE.LDF.64.XP fu1, fu0, as, ad","lang":"text"},{"t":"p","s":[{"n":4,"c":[{"t":"b","c":[{"t":"text","v":"Description"}]}]}]},{"t":"p","s":[{"n":5,"c":[{"t":"text","v":"This instruction forces the lower 3 bits of the access address in register as to 0, loads "},{"t":"num","v":"64-bit","k":"size"},{"t":"text","v":" data from memory, and stores it in order from low bit to high bit to floating-point registers fu0 and fu1."}]},{"n":6,"c":[{"t":"text","v":"After the access is completed, the value in register as is incremented by the value in register ad."}]}]},{"t":"p","s":[{"n":7,"c":[{"t":"b","c":[{"t":"text","v":"Operation"}]}]}]},{"t":"pre","v":"dataIn[63:0] = load64({as[31:3],3{0}})\nfu1 = dataIn[63:32]\nfu0 = dataIn[31: 0]\nas[31:0] = as[31:0] + ad[31:0]","lang":"text"}]}