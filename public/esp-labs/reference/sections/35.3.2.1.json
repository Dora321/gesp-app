{"id":"35.3.2.1","doc":"T","title":"Clock Source","words":171,"blocks":[{"t":"p","s":[{"n":1,"c":[{"t":"block","v":"LED PWM","id":"ledc"},{"t":"text","v":" registers configured by software are clocked by APB_CLK."}]},{"n":2,"c":[{"t":"text","v":"For more information about APB_CLK, see "},{"t":"xref","id":"7","c":[{"t":"text","v":"Chapter 7"}]},{"t":"text","v":" Reset and Clock."}]},{"n":3,"c":[{"t":"text","v":"To use the LED PWM peripheral, the APB_CLK signal to the LED PWM has to be enabled."}]},{"n":4,"c":[{"t":"text","v":"The APB_CLK signal to LED PWM can be enabled by setting the "},{"t":"field","v":"SYSTEM_LEDC_CLK_EN"},{"t":"text","v":" field in the register "},{"t":"reg","v":"SYSTEM_PERIP_CLK_EN0_REG"},{"t":"text","v":" and be reset via software by setting the "},{"t":"field","v":"SYSTEM_LEDC_RST"},{"t":"text","v":" field in the register "},{"t":"reg","v":"SYSTEM_PERIP_RST_EN0_REG"},{"t":"text","v":"."}]},{"n":5,"c":[{"t":"text","v":"For more information, please refer to Table 17.3-1 in "},{"t":"xref","id":"17","c":[{"t":"text","v":"Chapter 17"}]},{"t":"text","v":" System Registers (SYSTEM)."}]}]},{"t":"p","s":[{"n":6,"c":[{"t":"text","v":"Timers in the LED PWM Controller choose their common clock source from one of the following clock signals: APB_CLK, "},{"t":"field","v":"RC_FAST_CLK"},{"t":"text","v":" and "},{"t":"field","v":"XTAL_CLK"},{"t":"text","v":" (see "},{"t":"xref","id":"7","c":[{"t":"text","v":"Chapter 7"}]},{"t":"text","v":" Reset and Clock for more details about each clock signal)."}]},{"n":7,"c":[{"t":"text","v":"The procedure for selecting a clock source signal for LEDC_CLK_x is described below:"}]}]},{"t":"list","ordered":false,"items":[[{"t":"p","s":[{"n":8,"c":[{"t":"text","v":"APB_CLK: Set "},{"t":"field","v":"LEDC_APB_CLK_SEL"},{"t":"text","v":"[1:0] to 1"}]}]}],[{"t":"p","s":[{"n":9,"c":[{"t":"field","v":"RC_FAST_CLK"},{"t":"text","v":": Set "},{"t":"field","v":"LEDC_APB_CLK_SEL"},{"t":"text","v":"[1:0] to 2"}]}]}],[{"t":"p","s":[{"n":10,"c":[{"t":"field","v":"XTAL_CLK"},{"t":"text","v":": Set "},{"t":"field","v":"LEDC_APB_CLK_SEL"},{"t":"text","v":"[1:0] to 3"}]}]}]]},{"t":"p","s":[{"n":11,"c":[{"t":"text","v":"The LEDC_CLK_x signal will then be passed through the clock divider."}]}]}]}