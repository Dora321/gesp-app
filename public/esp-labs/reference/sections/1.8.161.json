{"id":"1.8.161","doc":"T","title":"EE.VMULAS.U16.ACCX.LD.XP","words":194,"blocks":[{"t":"p","s":[{"n":1,"c":[{"t":"b","c":[{"t":"text","v":"Instruction Word"}]},{"t":"text","v":" (bit layout, little-endian bit order)"}]}]},{"t":"table","head":[[{"t":"text","v":"111100"}],[{"t":"text","v":"qu[2:1]"}],[{"t":"text","v":"qy[0]"}],[{"t":"text","v":"001"}],[{"t":"text","v":"qu[0]"}],[{"t":"text","v":"100"}],[{"t":"text","v":"qx[1:0]"}],[{"t":"text","v":"qy[2:1]"}],[{"t":"text","v":"ad[3:0]"}],[{"t":"text","v":"as[3:0]"}],[{"t":"text","v":"111"}],[{"t":"text","v":"qx[2]"}]],"rows":[{"n":2,"c":[[{"t":"text","v":"6"}],[{"t":"text","v":"2"}],[{"t":"text","v":"1"}],[{"t":"text","v":"3"}],[{"t":"text","v":"1"}],[{"t":"text","v":"3"}],[{"t":"text","v":"2"}],[{"t":"text","v":"2"}],[{"t":"text","v":"4"}],[{"t":"text","v":"4"}],[{"t":"text","v":"3"}],[{"t":"text","v":"1"}]]}]},{"t":"p","s":[{"n":3,"c":[{"t":"b","c":[{"t":"text","v":"Assembler Syntax"}]}]}]},{"t":"pre","v":"EE.VMULAS.U16.ACCX.LD.XP qu, as, ad, qx, qy","lang":"text"},{"t":"p","s":[{"n":4,"c":[{"t":"b","c":[{"t":"text","v":"Description"}]}]}]},{"t":"p","s":[{"n":5,"c":[{"t":"text","v":"This instruction divides registers qx and qy into 8 data segments by 16 bits."}]},{"n":6,"c":[{"t":"text","v":"Then, it performs an unsigned multiply-accumulate operation on the 8 sets of segments respectively."}]},{"n":7,"c":[{"t":"text","v":"The accumulated result is added to the value in special register ACCX."}]},{"n":8,"c":[{"t":"text","v":"Then, the sum obtained is saturated and then stored in ACCX."}]},{"n":9,"c":[{"t":"text","v":"During the operation, the lower 4 bits of the access address in register as are forced to be 0, and then the 16-byte data is loaded from the memory to register qu."}]},{"n":10,"c":[{"t":"text","v":"After the access is completed, the value in register as is incremented by the value in register ad."}]}]},{"t":"p","s":[{"n":11,"c":[{"t":"b","c":[{"t":"text","v":"Operation"}]}]}]},{"t":"pre","v":"add0[31:0] = qx[ 15: 0] * qy[ 15: 0]\nadd1[31:0] = qx[ 31: 16] * qy[ 31: 16]\n...\nadd7[31:0] = qx[127:112] * qy[127:112]\nsum[40:0] = ACCX[39:0] + ad[31:0]d0[31:0] + ad[31:0]d1[31:0] + ... + ad[31:0]d 7[31:0]\nACCX[40:0] = min(max(sum[40:0], 0), 2^{40}-1)\n\nqu[127:0] = load128({as[31:4],4{0}})\nas[31:0] = as[31:0] + ad[31:0]","lang":"text"}]}