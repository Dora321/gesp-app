{"id":"7.1.3","doc":"T","title":"Features","words":116,"blocks":[{"t":"list","ordered":false,"items":[[{"t":"p","s":[{"n":1,"c":[{"t":"text","v":"Support four reset levels:"}]}]},{"t":"list","ordered":false,"items":[[{"t":"p","s":[{"n":2,"c":[{"t":"text","v":"CPU Reset: only resets CPU"},{"t":"i","c":[{"t":"text","v":"x"}]},{"t":"text","v":" core."}]},{"n":3,"c":[{"t":"text","v":"CPU"},{"t":"i","c":[{"t":"text","v":"x"}]},{"t":"text","v":" can be CPU0 or CPU1 here."}]},{"n":4,"c":[{"t":"text","v":"Once such reset is released, programs will be executed from CPU"},{"t":"i","c":[{"t":"text","v":"x"}]},{"t":"text","v":" reset vector."}]},{"n":5,"c":[{"t":"text","v":"Each CPU core has its own reset logic."}]}]}],[{"t":"p","s":[{"n":6,"c":[{"t":"text","v":"Core Reset: resets the whole digital system except RTC, including CPU0, CPU1, peripherals, "},{"t":"block","v":"Wi-Fi","id":"wifi"},{"t":"text","v":", Bluetooth(R) LE ("},{"t":"block","v":"BLE","id":"ble"},{"t":"text","v":"), and digital GPIOs."}]}]}],[{"t":"p","s":[{"n":7,"c":[{"t":"text","v":"System Reset: resets the whole digital system, including RTC."}]}]}],[{"t":"p","s":[{"n":8,"c":[{"t":"text","v":"Chip Reset: resets the whole chip."}]}]}]]}],[{"t":"p","s":[{"n":9,"c":[{"t":"text","v":"Support software reset and hardware reset:"}]}]},{"t":"list","ordered":false,"items":[[{"t":"p","s":[{"n":10,"c":[{"t":"text","v":"Software reset is triggered by CPU"},{"t":"i","c":[{"t":"text","v":"x"}]},{"t":"text","v":" configuring its corresponding registers."}]}]}],[{"t":"p","s":[{"n":11,"c":[{"t":"text","v":"Hardware reset is directly triggered by the circuit."}]}]}]]}]]},{"t":"p","s":[{"n":12,"c":[{"t":"text","v":"Note:"}],"warn":true}]},{"t":"p","s":[{"n":13,"c":[{"t":"text","v":"If CPU Reset is from CPU0, the PMS registers will be reset, too."}]}]}]}