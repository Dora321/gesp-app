{"id":"1.8.163","doc":"T","title":"EE.VMULAS.U16.QACC","words":181,"blocks":[{"t":"p","s":[{"n":1,"c":[{"t":"b","c":[{"t":"text","v":"Instruction Word"}]},{"t":"text","v":" (bit layout, little-endian bit order)"}]}]},{"t":"table","head":[[{"t":"text","v":"000010100"}],[{"t":"text","v":"qy[2]"}],[{"t":"text","v":"1"}],[{"t":"text","v":"qy[1:0]"}],[{"t":"text","v":"qx[2:0]"}],[{"t":"text","v":"10000100"}]],"rows":[{"n":2,"c":[[{"t":"text","v":"9"}],[{"t":"text","v":"1"}],[{"t":"text","v":"1"}],[{"t":"text","v":"2"}],[{"t":"text","v":"3"}],[{"t":"text","v":"8"}]]}]},{"t":"p","s":[{"n":3,"c":[{"t":"b","c":[{"t":"text","v":"Assembler Syntax"}]}]}]},{"t":"pre","v":"EE.VMULAS.U16.QACC qx, qy","lang":"text"},{"t":"p","s":[{"n":4,"c":[{"t":"b","c":[{"t":"text","v":"Description"}]}]}]},{"t":"p","s":[{"n":5,"c":[{"t":"text","v":"This instruction divides registers qx and qy into 8 data segments by 16 bits."}]},{"n":6,"c":[{"t":"text","v":"Then, the unsigned multiplication result of the 8 sets of segments is added to the corresponding "},{"t":"num","v":"40-bit","k":"size"},{"t":"text","v":" data segment in special registers QACC_H and QACC_L respectively."}]},{"n":7,"c":[{"t":"text","v":"The calculated result is saturated to a "},{"t":"num","v":"40-bit","k":"size"},{"t":"text","v":" unsigned number and then stored to the corresponding "},{"t":"num","v":"40-bit","k":"size"},{"t":"text","v":" data segment in QACC_H and QACC_L."}]}]},{"t":"p","s":[{"n":8,"c":[{"t":"b","c":[{"t":"text","v":"Operation"}]}]}]},{"t":"pre","v":"QACC_L[ 39: 0] = min(QACC_L[ 39: 0] + qx[ 15: 0] * qy[ 15: 0], 2^{40}-1)\nQACC_L[ 79: 40] = min(QACC_L[ 79: 40] + qx[ 31: 16] * qy[ 31: 16], 2^{40}-1)\n...\nQACC_L[159:120] = min(QACC_L[159:120] + qx[ 63: 48] * qy[ 63: 48], 2^{40}-1)\nQACC_H[ 39: 0] = min(QACC_H[ 39: 0] + qx[ 79: 64] * qy[ 79: 64], 2^{40}-1)\nQACC_H[ 79: 40] = min(QACC_H[ 79: 40] + qx[ 95: 80] * qy[ 95: 80], 2^{40}-1)\n...\nQACC_H[159:120] = min(QACC_H[159:120] + qx[127:112] * qy[127:112], 2^{40}-1)","lang":"text"}]}