{"id":"26.5.1.2","doc":"T","title":"Static Registers","words":188,"blocks":[{"t":"p","s":[{"n":1,"c":[{"t":"text","v":"Static registers, though also read in Core Clock domain, would not change dynamically when "},{"t":"block","v":"UART","id":"uart"},{"t":"text","v":" controllers are at work, so they do not implement the clock domain crossing design."}],"warn":true},{"n":2,"c":[{"t":"text","v":"These registers must be configured when the UART transmitter or receiver is not at work."}],"warn":true},{"n":3,"c":[{"t":"text","v":"In this case, software can turn off the clock for the UART transmitter or receiver, so that static registers are not sampled in their metastable state."}]},{"n":4,"c":[{"t":"text","v":"When software turns on the clock, the configured values are stable to be correctly sampled."}]},{"n":5,"c":[{"t":"text","v":"Static registers as listed in Table 26.5-2 are configured as follows:"}]}]},{"t":"list","ordered":false,"items":[[{"t":"p","s":[{"n":6,"c":[{"t":"text","v":"Turn off the clock for the UART transmitter by clearing "},{"t":"field","v":"UART_TX_SCLK_EN"},{"t":"text","v":", or the clock for the UART receiver by clearing "},{"t":"field","v":"UART_RX_SCLK_EN"},{"t":"text","v":", depending on which one (transmitter or receiver) is not at work;"}]}]}],[{"t":"p","s":[{"n":7,"c":[{"t":"text","v":"Configure static registers;"}]}]}],[{"t":"p","s":[{"n":8,"c":[{"t":"text","v":"Turn on the clock for the UART transmitter by writing 1 to "},{"t":"field","v":"UART_TX_SCLK_EN"},{"t":"text","v":", or the clock for the UART receiver by writing 1 to "},{"t":"field","v":"UART_RX_SCLK_EN"},{"t":"text","v":"."}]}]}]]},{"t":"p","s":[{"n":9,"c":[{"t":"text","v":"**Table 26.5-2."}]},{"n":10,"c":[{"t":"text","v":"UART"},{"t":"i","c":[{"t":"text","v":"n"}]},{"t":"text","v":" Static Registers**"}]}]},{"t":"table","head":[[{"t":"text","v":"Register"}],[{"t":"text","v":"Field"}]],"rows":[{"n":11,"c":[[{"t":"reg","v":"UART_RX_FILT_REG"}],[{"t":"field","v":"UART_GLITCH_FILT_EN"}]]},{"n":12,"c":[[{"t":"reg","v":"UART_RX_FILT_REG"}],[{"t":"field","v":"UART_GLITCH_FILT"},{"t":"text","v":"[7:0]"}]]},{"n":13,"c":[[{"t":"reg","v":"UART_SLEEP_CONF_REG"}],[{"t":"field","v":"UART_ACTIVE_THRESHOLD"},{"t":"text","v":"[9:0]"}]]},{"n":14,"c":[[{"t":"reg","v":"UART_SWFC_CONF0_REG"}],[{"t":"field","v":"UART_XOFF_CHAR"},{"t":"text","v":"[7:0]"}]]},{"n":15,"c":[[{"t":"reg","v":"UART_SWFC_CONF1_REG"}],[{"t":"field","v":"UART_XON_CHAR"},{"t":"text","v":"[7:0]"}]]},{"n":16,"c":[[{"t":"reg","v":"UART_IDLE_CONF_REG"}],[{"t":"field","v":"UART_TX_IDLE_NUM"},{"t":"text","v":"[9:0]"}]]},{"n":17,"c":[[{"t":"reg","v":"UART_AT_CMD_PRECNT_REG"}],[{"t":"field","v":"UART_PRE_IDLE_NUM"},{"t":"text","v":"[15:0]"}]]},{"n":18,"c":[[{"t":"reg","v":"UART_AT_CMD_POSTCNT_REG"}],[{"t":"field","v":"UART_POST_IDLE_NUM"},{"t":"text","v":"[15:0]"}]]},{"n":19,"c":[[{"t":"reg","v":"UART_AT_CMD_GAPTOUT_REG"}],[{"t":"field","v":"UART_RX_GAP_TOUT"},{"t":"text","v":"[15:0]"}]]},{"n":20,"c":[[{"t":"reg","v":"UART_AT_CMD_CHAR_REG"}],[{"t":"field","v":"UART_CHAR_NUM"},{"t":"text","v":"[7:0]"}]]},{"n":21,"c":[[{"t":"reg","v":"UART_AT_CMD_CHAR_REG"}],[{"t":"field","v":"UART_AT_CMD_CHAR"},{"t":"text","v":"[7:0]"}]]}]}]}