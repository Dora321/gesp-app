{"id":"1.8.48","doc":"T","title":"EE.SLCXXP.2Q","words":133,"blocks":[{"t":"p","s":[{"n":1,"c":[{"t":"b","c":[{"t":"text","v":"Instruction Word"}]},{"t":"text","v":" (bit layout, little-endian bit order)"}]}]},{"t":"table","head":[[{"t":"text","v":"10"}],[{"t":"text","v":"qs1[2:1]"}],[{"t":"text","v":"0110"}],[{"t":"text","v":"qs1[0]"}],[{"t":"text","v":"qs0[2:0]"}],[{"t":"text","v":"ad[3:0]"}],[{"t":"text","v":"as[3:0]"}],[{"t":"text","v":"0100"}]],"rows":[{"n":2,"c":[[{"t":"text","v":"2"}],[{"t":"text","v":"2"}],[{"t":"text","v":"4"}],[{"t":"text","v":"1"}],[{"t":"text","v":"3"}],[{"t":"text","v":"4"}],[{"t":"text","v":"4"}],[{"t":"text","v":"4"}]]}]},{"t":"p","s":[{"n":3,"c":[{"t":"b","c":[{"t":"text","v":"Assembler Syntax"}]}]}]},{"t":"pre","v":"EE.SLCXXP.2Q qs1, qs0, as, ad","lang":"text"},{"t":"p","s":[{"n":4,"c":[{"t":"b","c":[{"t":"text","v":"Description"}]}]}]},{"t":"p","s":[{"n":5,"c":[{"t":"text","v":"This instruction performs a left shift on the 32-byte concatenation of registers qs0 and qs1 and pads the lower bits with 0."}]},{"n":6,"c":[{"t":"text","v":"The upper 128 bits of the shift result is written to register qs1 and the lower 128 bits is written to qs0."}]},{"n":7,"c":[{"t":"text","v":"The left shift amount is 8 multiplied by the sum of 1 plus the lower "},{"t":"num","v":"4-bit","k":"size"},{"t":"text","v":" value of register as."}]},{"n":8,"c":[{"t":"text","v":"After the above operations, the value in as is incremented by the value in ad."}]}]},{"t":"p","s":[{"n":9,"c":[{"t":"b","c":[{"t":"text","v":"Operation"}]}]}]},{"t":"pre","v":"{qs1[127: 0], qs0[127: 0]} = {qs1[127: 0], qs0[127: 0]} << ((as[3:0]+1)*8)\nas[31:0] = as[31:0] + ad[31:0]","lang":"text"}]}