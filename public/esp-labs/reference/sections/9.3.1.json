{"id":"9.3.1","doc":"T","title":"Peripheral Interrupt Sources","words":663,"blocks":[{"t":"p","s":[{"n":1,"c":[{"t":"text","v":"ESP32-S3 has 99 peripheral interrupt sources in total."}]},{"n":2,"c":[{"t":"text","v":"For the peripheral interrupt sources and their configuration/status registers, please refer to Table 9.3-1."}]}]},{"t":"list","ordered":false,"items":[[{"t":"p","s":[{"n":3,"c":[{"t":"text","v":"Column \"No.\": the peripheral interrupt source number, can be 0 ~ 98"}]}]}],[{"t":"p","s":[{"n":4,"c":[{"t":"text","v":"Column \"Source\": all peripheral interrupt sources available"}]}]}],[{"t":"p","s":[{"n":5,"c":[{"t":"text","v":"Column \"Configuration Register\": the registers used for routing the peripheral interrupt sources to CPU0/CPU1 peripheral interrupts"}]}]}],[{"t":"p","s":[{"n":6,"c":[{"t":"text","v":"Column \"Status Register\": the registers used for indicating the interrupt status of peripheral interrupt sources"}]}]},{"t":"list","ordered":false,"items":[[{"t":"p","s":[{"n":7,"c":[{"t":"text","v":"Column \"Status Register - Bit\": the bit position in status registers"}]}]}],[{"t":"p","s":[{"n":8,"c":[{"t":"text","v":"Column \"Status Register - Name\": the name of status registers"}]}]}]]}]]},{"t":"p","s":[{"n":9,"c":[{"t":"text","v":"The register in column \"Configuration Register\" and the bit in column \"Bit\" correspond to the peripheral interrupt source in column \"Source\"."}]},{"n":10,"c":[{"t":"text","v":"For example, the configuration register for interrupt source "},{"t":"field","v":"MAC_INTR"},{"t":"text","v":" is INTERRUPT_COREx_MAC_INTR_MAP_REG, and its status bit in INTERRUPT_COREx_INTR_STATUS_0_REG is bit0."}]}]},{"t":"p","s":[{"n":11,"c":[{"t":"text","v":"Note that COREx in the table can be CORE0 (CPU0) or CORE1 (CPU1)."}]}]},{"t":"table","caption":"Table 9.3-1. CPU Peripheral Interrupt Configuration/Status Registers and Peripheral Interrupt Sources","head":[[{"t":"text","v":"No."}],[{"t":"text","v":"Source"}],[{"t":"text","v":"Conf