{"id":"15.3.1.2","doc":"T","title":"Access Configuration","words":141,"blocks":[{"t":"p","s":[{"n":1,"c":[{"t":"text","v":"ESP32-S3 uses the registers listed in Table 15.3-2 to configure the instruction execution (X), write (W) and read (R) accesses of CPU's IBUS and DBUS, from the Secure World and Non-secure World, to ROM:"}]}]},{"t":"table","caption":"Table 15.3-2. Access Configuration to ROM","head":[[{"t":"text","v":"Bus"}],[{"t":"text","v":"From World"}],[{"t":"text","v":"Configuration Registers"}],[{"t":"text","v":"Access (A)"}]],"rows":[{"n":2,"c":[[{"t":"text","v":"IBUS"}],[{"t":"text","v":"Secure World"}],[{"t":"reg","v":"PMS_CORE_X_IRAM0_PMS_CONSTRAIN_2_REG"},{"t":"text","v":" [20:18] (B)"}],[{"t":"text","v":"X/W/R"}]]},{"n":3,"c":[[{"t":"text","v":"IBUS"}],[{"t":"text","v":"Non-secure World"}],[{"t":"reg","v":"PMS_CORE_X_IRAM0_PMS_CONSTRAIN_1_REG"},{"t":"text","v":" [20:18]"}],[{"t":"text","v":"X/W/R"}]]},{"n":4,"c":[[{"t":"text","v":"DBUS"}],[{"t":"text","v":"Secure World"}],[{"t":"reg","v":"PMS_CORE_X_DRAM0_PMS_CONSTRAIN_1_REG"},{"t":"text","v":" [25:24] (C)"}],[{"t":"text","v":"W/R"}]]},{"n":5,"c":[[{"t":"text","v":"DBUS"}],[{"t":"text","v":"Non-secure World"}],[{"t":"reg","v":"PMS_CORE_X_DRAM0_PMS_CONSTRAIN_1_REG"},{"t":"text","v":" [27:26]"}],[{"t":"text","v":"W/R"}]]}]},{"t":"p","s":[{"n":6,"c":[{"t":"text","v":"A 1: with access; 0: without access."}]},{"n":7,"c":[{"t":"text","v":"B For example, configuring this field to 0b101 indicates CPU's IBUS is granted with instruction execution and read accesses but not write access to ROM from the Secure World."}]},{"n":8,"c":[{"t":"text","v":"C For example, configuring this field to 0b01 indicates CPU's DBUS is granted with read access but not write access to ROM from the Secure World."}]}]}]}