: 16] : qy[ 31: 16]\n...\nqa[127:112] = (qx[127:112]<=qy[127:112]) ? qx[127:112] : qy[127:112]\n\nqu[127:0] = load128({as[31:4],4{0}})\nas[31:0] = as[31:0] + 16","lang":"text"}]}