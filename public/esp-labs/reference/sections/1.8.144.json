{"id":"1.8.144","doc":"T","title":"EE.VMULAS.S16.QACC.LDBC.INCP","words":281,"blocks":[{"t":"p","s":[{"n":1,"c":[{"t":"b","c":[{"t":"text","v":"Instruction Word"}]},{"t":"text","v":" (bit layout, little-endian bit order)"}]}]},{"t":"table","head":[[{"t":"text","v":"100"}],[{"t":"text","v":"qu[2]"}],[{"t":"text","v":"0111"}],[{"t":"text","v":"qu[1]"}],[{"t":"text","v":"qy[2]"}],[{"t":"text","v":"qu[0]"}],[{"t":"text","v":"qy[1:0]"}],[{"t":"text","v":"qx[2:0]"}],[{"t":"text","v":"as[3:0]"}],[{"t":"text","v":"0100"}]],"rows":[{"n":2,"c":[[{"t":"text","v":"3"}],[{"t":"text","v":"1"}],[{"t":"text","v":"4"}],[{"t":"text","v":"1"}],[{"t":"text","v":"1"}],[{"t":"text","v":"1"}],[{"t":"text","v":"2"}],[{"t":"text","v":"3"}],[{"t":"text","v":"4"}],[{"t":"text","v":"4"}]]}]},{"t":"p","s":[{"n":3,"c":[{"t":"b","c":[{"t":"text","v":"Assembler Syntax"}]}]}]},{"t":"pre","v":"EE.VMULAS.S16.QACC.LDBC.INCP qu, as, qx, qy","lang":"text"},{"t":"p","s":[{"n":4,"c":[{"t":"b","c":[{"t":"text","v":"Description"}]}]}]},{"t":"p","s":[{"n":5,"c":[{"t":"text","v":"This instruction divides registers qx and qy into 8 data segments by 16 bits."}]},{"n":6,"c":[{"t":"text","v":"Then, the signed multiplication result of 8 sets of segments is added to the corresponding "},{"t":"num","v":"40-bit","k":"size"},{"t":"text","v":" data segment in special registers QACC_H and QACC_L respectively."}]},{"n":7,"c":[{"t":"text","v":"The calculated result is saturated to a "},{"t":"num","v":"40-bit","k":"size"},{"t":"text","v":" signed number and then stored to the corresponding "},{"t":"num","v":"40-bit","k":"size"},{"t":"text","v":" data segment in QACC_H and QACC_L."}]},{"n":8,"c":[{"t":"text","v":"At the same time, this instruction forces the lower 1 bit of the access address in register as to 0, loads "},{"t":"num","v":"16-bit","k":"size"},{"t":"text","v":" data from memory, and broadcasts it to the eight "},{"t":"num","v":"16-bit","k":"size"},{"t":"text","v":" data segments in register qu."}]},{"n":9,"c":[{"t":"text","v":"After the access, the value in register as is incremented by 2."}]}]},{"t":"p","s":[{"n":10,"c":[{"t":"b","c":[{"t":"text","v":"Operation"}]}]}]},{"t":"pre","v":"QACC_L[ 39: 0] = min(max(QACC_L[ 39: 0] + qx[ 15: 0] * qy[ 15: 0], -2^{39}), 2^{39}-1)\nQACC_L[ 79: 40] = min(max(QACC_L[ 79: 40] + qx[ 31: 16] * qy[ 31: 16], -2^{39}), 2^{39}-1)\nQACC_L[119: 80] = min(max(QACC_L[119: 80] + qx[ 47: 32] * qy[ 47: 32], -2^{39}), 2^{39}-1)\nQACC_L[159:120] = min(max(QACC_L[159:120] + qx[ 63: 48] * qy[ 63: 48], -2^{39}), 2^{39}-1)\nQACC_H[ 39: 0] = min(max(QACC_H[ 39: 0] + qx[ 79: 64] * qy[ 79: 64], -2^{39}), 2^{39}-1)\nQACC_H[ 79: 40] = min(max(QACC_H[ 79: 40] + qx[ 95: 80] * qy[ 95: 80], -2^{39}), 2^{39}-1)\nQACC_H[119: 80] = min(max(QACC_H[119: 80] + qx[111: 96] * qy[111: 96], -2^{39}), 2^{39}-1)\nQACC_H[159:120] = min(max(QACC_H[159:120] + qx[127:112] * qy[127:112], -2^{39}), 2^{39}-1)\n\nqu[127:0] = {8{load16({as[31:1],1{0}})}}\nas[31:0] = as[31:0] + 2","lang":"text"}]}