{"id":"5.3.2","doc":"T","title":"Programming of Parameters","words":553,"blocks":[{"t":"p","s":[{"n":1,"c":[{"t":"text","v":"The "},{"t":"block","v":"eFuse","id":"efuse"},{"t":"text","v":" controller can only program eFuse parameters of one block at a time."}]},{"n":2,"c":[{"t":"text","v":"BLOCK0 ~ BLOCK10 share the same address range to store the parameters to be programmed."}]},{"n":3,"c":[{"t":"text","v":"Configure parameter "},{"t":"field","v":"EFUSE_BLK_NUM"},{"t":"text","v":" to indicate which block should be programmed."}]}]},{"t":"p","s":[{"n":4,"c":[{"t":"text","v":"Before programming, make sure the eFuse programming voltage VDDQ is configured correctly as described in "},{"t":"xref","id":"5.3.4","c":[{"t":"text","v":"Section 5.3.4"}]},{"t":"text","v":"."}]}]},{"t":"p","s":[{"n":5,"c":[{"t":"b","c":[{"t":"text","v":"Programming BLOCK0"}]}]}]},{"t":"p","s":[{"n":6,"c":[{"t":"text","v":"When "},{"t":"field","v":"EFUSE_BLK_NUM"},{"t":"text","v":" is set to 0, BLOCK0 will be programmed."}]},{"n":7,"c":[{"t":"text","v":"Register "},{"t":"reg","v":"EFUSE_PGM_DATA0_REG"},{"t":"text","v":" stores "},{"t":"field","v":"EFUSE_WR_DIS"},{"t":"text","v":"."}]},{"n":8,"c":[{"t":"text","v":"Registers "},{"t":"reg","v":"EFUSE_PGM_DATA1_REG"},{"t":"text","v":" ~ "},{"t":"reg","v":"EFUSE_PGM_DATA5_REG"},{"t":"text","v":" store the information of parameters to be programmed."}]},{"n":9,"c":[{"t":"text","v":"Note that 25 bits are readable but useless to users and must always be set to 0 in the programming registers."}],"warn":true},{"n":10,"c":[{"t":"text","v":"The specific bits are:"}]}]},{"t":"list","ordered":false,"items":[[{"t":"p","s":[{"n":11,"c":[{"t":"reg","v":"EFUSE_PGM_DATA1_REG"},{"t":"text","v":"[27:31]"}]}]}],[{"t":"p","s":[{"n":12,"c":[{"t":"reg","v":"EFUSE_PGM_DATA1_REG"},{"t":"text","v":"[21:24]"}]}]}],[{"t":"p","s":[{"n":13,"c":[{"t":"reg","v":"EFUSE_PGM_DATA2_REG"},{"t":"text","v":"[7:15]"}]}]}],[{"t":"p","s":[{"n":14,"c":[{"t":"reg","v":"EFUSE_PGM_DATA2_REG"},{"t":"text","v":"[0:3]"}]}]}],[{"t":"p","s":[{"n":15,"c":[{"t":"reg","v":"EFUSE_PGM_DATA3_REG"},{"t":"text","v":"[26:27]"}]}]}],[{"t":"p","s":[{"n":16,"c":[{"t":"reg","v":"EFUSE_PGM_DATA4_REG"},{"t":"text","v":"[30]"}]}]}]]},{"t":"p","s":[{"n":17,"c":[{"t":"text","v":"Data in registers "},{"t":"reg","v":"EFUSE_PGM_DATA6_REG"},{"t":"text","v":" ~ "},{"t":"reg","v":"EFUSE_PGM_DATA7_REG"},{"t":"text","v":" and "},{"t":"reg","v":"EFUSE_PGM_CHECK_VALUE0_REG"},{"t":"text","v":" ~ "},{"t":"reg","v":"EFUSE_PGM_CHECK_VALUE2_REG"},{"t":"text","v":" are ignored when programming BLOCK0."}]}]},{"t":"p","s":[{"n":18,"c":[{"t":"b","c":[{"t":"text","v":"Programming BLOCK1"}]}]}]},{"t":"p","s":[{"n":19,"c":[{"t":"text","v":"When "},{"t":"field","v":"EFUSE_BLK_NUM"},{"t":"text","v":" is set to 1, registers "},{"t":"reg","v":"EFUSE_PGM_DATA0_REG"},{"t":"text","v":" ~ "},{"t":"reg","v":"EFUSE_PGM_DATA5_REG"},{"t":"text","v":" store the BLOCK1 parameters to be programmed."}]},{"n":20,"c":[{"t":"text","v":"Registers "},{"t":"reg","v":"EFUSE_PGM_CHECK_VALUE0_REG"},{"t":"text","v":" ~ "},{"t":"reg","v":"EFUSE_PGM_CHECK_VALUE2_REG"},{"t":"text","v":" store the corresponding RS check codes."}]},{"n":21,"c":[{"t":"text","v":"Data in registers "},{"t":"reg","v":"EFUSE_PGM_DATA6_REG"},{"t":"text","v":" ~ "},{"t":"reg","v":"EFUSE_PGM_DATA7_REG"},{"t":"text","v":" is ignored when programming BLOCK1, and the RS check codes will be calculated with these bits all treated as 0."}]}]},{"t":"p","s":[{"n":22,"c":[{"t":"b","c":[{"t":"text","v":"Programming BLOCK2 ~ 10"}]}]}]},{"t":"p","s":[{"n":23,"c":[{"t":"text","v":"When "},{"t":"field","v":"EFUSE_BLK_NUM"},{"t":"text","v":" is set to 2 ~ 10, registers "},{"t":"reg","v":"EFUSE_PGM_DATA0_REG"},{"t":"text","v":" ~ "},{"t":"reg","v":"EFUSE_PGM_DATA7_REG"},{"t":"text","v":" store the parameters to be programmed to this block."}]},{"n":24,"c":[{"t":"text","v":"Registers "},{"t":"reg","v":"EFUSE_PGM_CHECK_VALUE0_REG"},{"t":"text","v":" ~ "},{"t":"reg","v":"EFUSE_PGM_CHECK_VALUE2_REG"},{"t":"text","v":" store the corresponding RS check codes."}]}]},{"t":"p","s":[{"n":25,"c":[{"t":"b","c":[{"t":"text","v":"Programming process"}]}]}]},{"t":"p","s":[{"n":26,"c":[{"t":"text","v":"The process of programming parameters is as follows:"}]}]},{"t":"list","ordered":true,"items":[[{"t":"p","s":[{"n":27,"c":[{"t":"text","v":"Write the block number to "},{"t":"field","v":"EFUSE_BLK_NUM"},{"t":"text","v":" to determine the block to be programmed."}]}]}],[{"t":"p","s":[{"n":28,"c":[{"t":"text","v":"Write parameters to be programmed to registers "},{"t":"reg","v":"EFUSE_PGM_DATA0_REG"},{"t":"text","v":" ~ "},{"t":"reg","v":"EFUSE_PGM_DATA7_REG"},{"t":"text","v":" and the corresponding checksum values to "},{"t":"reg","v":"EFUSE_PGM_CHECK_VALUE0_REG"},{"t":"text","v":" ~ "},{"t":"reg","v":"EFUSE_PGM_CHECK_VALUE2_REG"},{"t":"text","v":"."}]}]}],[{"t":"p","s":[{"n":29,"c":[{"t":"text","v":"Configure the field "},{"t":"field","v":"EFUSE_OP_CODE"},{"t":"text","v":" of register "},{"t":"reg","v":"EFUSE_CONF_REG"},{"t":"text","v":" to 0x5A5A."}]}]}],[{"t":"p","s":[{"n":30,"c":[{"t":"text","v":"Configure the field "},{"t":"field","v":"EFUSE_PGM_CMD"},{"t":"text","v":" of register "},{"t":"reg","v":"EFUSE_CMD_REG"},{"t":"text","v":" to 1."}]}]}],[{"t":"p","s":[{"n":31,"c":[{"t":"text","v":"Poll register "},{"t":"reg","v":"EFUSE_CMD_REG"},{"t":"text","v":" until it is 0x0, or wait for a PGM_DONE interrupt."}]},{"n":32,"c":[{"t":"text","v":"For more information on how to identify a PGM_DONE interrupt, please see the end of "},{"t":"xref","id":"5.3.3","c":[{"t":"text","v":"Section 5.3.3"}]},{"t":"text","v":"."}]}]}],[{"t":"p","s":[{"n":33,"c":[{"t":"text","v":"In order to avoid programming content leakage, please clear the parameters in "},{"t":"reg","v":"EFUSE_PGM_DATA0_REG"},{"t":"text","v":" ~ "},{"t":"reg","v":"EFUSE_PGM_DATA7_REG"},{"t":"text","v":" and "},{"t":"reg","v":"EFUSE_PGM_CHECK_VALUE0_REG"},{"t":"text","v":" ~ "},{"t":"reg","v":"EFUSE_PGM_CHECK_VALUE2_REG"},{"t":"text","v":"."}]}]}],[{"t":"p","s":[{"n":34,"c":[{"t":"text","v":"Trigger an eFuse read operation (see "},{"t":"xref","id":"5.3.3","c":[{"t":"text","v":"Section 5.3.3"}]},{"t":"text","v":") to update eFuse registers with the new values."}]}]}],[{"t":"p","s":[{"n":35,"c":[{"t":"text","v":"Check error record registers."}]},{"n":36,"c":[{"t":"text","v":"If the values read in error record registers are not 0, the programming process should be performed again following above steps 1 ~ 7."}]},{"n":37,"c":[{"t":"text","v":"Please check the following error record registers for different eFuse blocks:"}]}]},{"t":"list","ordered":false,"items":[[{"t":"p","s":[{"n":38,"c":[{"t":"text","v":"BLOCK0: "},{"t":"reg","v":"EFUSE_RD_REPEAT_ERR0_REG"},{"t":"text","v":" ~ "},{"t":"reg","v":"EFUSE_RD_REPEAT_ERR4_REG"}]}]}],[{"t":"p","s":[{"n":39,"c":[{"t":"text","v":"BLOCK1: "},{"t":"reg","v":"EFUSE_RD_RS_ERR0_REG"},{"t":"text","v":"[2:0], "},{"t":"reg","v":"EFUSE_RD_RS_ERR0_REG"},{"t":"text","v":"[7]"}]}]}],[{"t":"p","s":[{"n":40,"c":[{"t":"text","v":"BLOCK2: "},{"t":"reg","v":"EFUSE_RD_RS_ERR0_REG"},{"t":"text","v":"[6:4], "},{"t":"reg","v":"EFUSE_RD_RS_ERR0_REG"},{"t":"text","v":"[11]"}]}]}],[{"t":"p","s":[{"n":41,"c":[{"t":"text","v":"BLOCK3: "},{"t":"reg","v":"EFUSE_RD_RS_ERR0_REG"},{"t":"text","v":"[10:8], "},{"t":"reg","v":"EFUSE_RD_RS_ERR0_REG"},{"t":"text","v":"[15]"}]}]}],[{"t":"p","s":[{"n":42,"c":[{"t":"text","v":"BLOCK4: "},{"t":"reg","v":"EFUSE_RD_RS_ERR0_REG"},{"t":"text","v":"[14:12], "},{"t":"reg","v":"EFUSE_RD_RS_ERR0_REG"},{"t":"text","v":"[19]"}]}]}],[{"t":"p","s":[{"n":43,"c":[{"t":"text","v":"BLOCK5: "},{"t":"reg","v":"EFUSE_RD_RS_ERR0_REG"},{"t":"text","v":"[18:16], "},{"t":"reg","v":"EFUSE_RD_RS_ERR0_REG"},{"t":"text","v":"[23]"}]}]}],[{"t":"p","s":[{"n":44,"c":[{"t":"text","v":"BLOCK6: "},{"t":"reg","v":"EFUSE_RD_RS_ERR0_REG"},{"t":"text","v":"[22:20], "},{"t":"reg","v":"EFUSE_RD_RS_ERR0_REG"},{"t":"text","v":"[27]"}]}]}],[{"t":"p","s":[{"n":45,"c":[{"t":"text","v":"BLOCK7: "},{"t":"reg","v":"EFUSE_RD_RS_ERR0_REG"},{"t":"text","v":"[26:24], "},{"t":"reg","v":"EFUSE_RD_RS_ERR0_REG"},{"t":"text","v":"[31]"}]}]}],[{"t":"p","s":[{"n":46,"c":[{"t":"text","v":"BLOCK8: "},{"t":"reg","v":"EFUSE_RD_RS_ERR0_REG"},{"t":"text","v":"[30:28], "},{"t":"reg","v":"EFUSE_RD_RS_ERR1_REG"},{"t":"text","v":"[3]"}]}]}],[{"t":"p","s":[{"n":47,"c":[{"t":"text","v":"BLOCK9: "},{"t":"reg","v":"EFUSE_RD_RS_ERR1_REG"},{"t":"text","v":"[2:0], "},{"t":"reg","v":"EFUSE_RD_RS_ERR1_REG"},{"t":"text","v":"[2:0][7]"}]}]}],[{"t":"p","s":[{"n":48,"c":[{"t":"text","v":"BLOCK10: "},{"t":"reg","v":"EFUSE_RD_RS_ERR1_REG"},{"t":"text","v":"[2:0][6:4]"}]}]}]]}]]},{"t":"p","s":[{"n":49,"c":[{"t":"b","c":[{"t":"text","v":"Limitations"}]}]}]},{"t":"p","s":[{"n":50,"c":[{"t":"text","v":"In BLOCK0, each bit can be programmed separately."}]},{"n":51,"c":[{"t":"text","v":"However, we recommend to minimize programming cycles and program all the bits of a parameter in one programming action."}]},{"n":52,"c":[{"t":"text","v":"In addition, after all parameters controlled by a certain bit of "},{"t":"field","v":"EFUSE_WR_DIS"},{"t":"text","v":" are programmed, that bit should be immediately programmed."}]},{"n":53,"c":[{"t":"text","v":"The programming of parameters controlled by a certain bit of "},{"t":"field","v":"EFUSE_WR_DIS"},{"t":"text","v":", and the programming of the bit itself can even be completed at the same time."}]},{"n":54,"c":[{"t":"text","v":"Repeated programming of already programmed bits is strictly forbidden, otherwise, programming errors will occur."}]}]},{"t":"p","s":[{"n":55,"c":[{"t":"text","v":"BLOCK1 cannot be programmed by users as it has been programmed at manufacturing."}],"warn":true}]},{"t":"p","s":[{"n":56,"c":[{"t":"text","v":"BLOCK2 ~ 10 can only be programmed once."}]},{"n":57,"c":[{"t":"text","v":"Repeated programming is not allowed."}]}]}]}