{"id":"19.3","doc":"T","title":"AES Working Modes","words":254,"blocks":[{"t":"p","s":[{"n":1,"c":[{"t":"text","v":"The "},{"t":"block","v":"AES","id":"crypto"},{"t":"text","v":" Accelerator integrated in ESP32-S3 has two working modes, which are Typical AES and DMA-AES."}]}]},{"t":"list","ordered":false,"items":[[{"t":"p","s":[{"n":2,"c":[{"t":"text","v":"Typical AES Working Mode:"}]}]},{"t":"list","ordered":false,"items":[[{"t":"p","s":[{"n":3,"c":[{"t":"text","v":"Supports encryption and decryption using cryptographic keys of 128 and 256 bits, specified in "},{"t":"link","href":"https://nvlpubs.nist.gov/nistpubs/FIPS/NIST.FIPS.197.pdf","c":[{"t":"text","v":"NIST FIPS 197"}]},{"t":"text","v":"."}]}]}]]},{"t":"p","s":[{"n":4,"c":[{"t":"text","v":"In this working mode, the plaintext and ciphertext is written and read via CPU directly."}]}]}],[{"t":"p","s":[{"n":5,"c":[{"t":"text","v":"DMA-AES Working Mode:"}]}]},{"t":"list","ordered":false,"items":[[{"t":"p","s":[{"n":6,"c":[{"t":"text","v":"Supports encryption and decryption using cryptographic keys of 128 and 256 bits, specified in "},{"t":"link","href":"https://nvlpubs.nist.gov/nistpubs/FIPS/NIST.FIPS.197.pdf","c":[{"t":"text","v":"NIST FIPS 197"}]},{"t":"text","v":";"}]}]}],[{"t":"p","s":[{"n":7,"c":[{"t":"text","v":"Supports block cipher modes ECB/CBC/OFB/CTR/CFB8/CFB128 under "},{"t":"link","href":"https://nvlpubs.nist.gov/nistpubs/Legacy/SP/nistspecialpublication800-38a.pdf","c":[{"t":"text","v":"NIST SP 800-38A"}]},{"t":"text","v":"."}]}]}]]},{"t":"p","s":[{"n":8,"c":[{"t":"text","v":"In this working mode, the plaintext and ciphertext is written and read via DMA."}]},{"n":9,"c":[{"t":"text","v":"An interrupt will be generated when operation completes."}]}]}]]},{"t":"p","s":[{"n":10,"c":[{"t":"text","v":"Users can choose the working mode for AES accelerator by configuring the "},{"t":"reg","v":"AES_DMA_ENABLE_REG"},{"t":"text","v":" register according to Table 19.3-1 below."}]}]},{"t":"table","caption":"Table