{"id":"28.10.1.2","doc":"T","title":"I2Sn Channel Control in PDM Mode","words":272,"blocks":[{"t":"p","s":[{"n":1,"c":[{"t":"text","v":"In PDM mode, "},{"t":"block","v":"I2S","id":"i2s"},{"t":"i","c":[{"t":"text","v":"n"}]},{"t":"text","v":" converts the serial data from channels to the data to be entered into memory."}]}]},{"t":"p","s":[{"n":2,"c":[{"t":"text","v":"In PDM master mode, the WS level of I2S"},{"t":"i","c":[{"t":"text","v":"n"}]},{"t":"text","v":" module is controlled by "},{"t":"field","v":"I2S_RX_WS_IDLE_POL"},{"t":"text","v":"."}]},{"n":3,"c":[{"t":"text","v":"WS frequency is half of BCK frequency."}]},{"n":4,"c":[{"t":"text","v":"The configuration of BCK signal is similar to that of WS signal as described in "},{"t":"xref","id":"28.6","c":[{"t":"text","v":"Section 28.6"}]},{"t":"text","v":"."}]},{"n":5,"c":[{"t":"text","v":"Note, in PDM RX mode, the value of "},{"t":"field","v":"I2S_RX_HALF_SAMPLE_BITS"},{"t":"text","v":" must be same as that of "},{"t":"field","v":"I2S_RX_BITS_MOD"},{"t":"text","v":"."}],"warn":true}]},{"t":"p","s":[{"n":6,"c":[{"t":"text","v":"I2S0 supports PDM-to-PCM input mode, in which the received PDM data is converted to PCM data and controlled according to the data mode."}]},{"n":7,"c":[{"t":"text","v":"Configure "},{"t":"field","v":"I2S_RX_PDM2PCM_EN"},{"t":"text","v":" to enable this mode."}]}]},{"t":"p","s":[{"n":8,"c":[{"t":"text","v":"The register configuration for PDM-to-PCM input mode is as follows:"}]}]},{"t":"list","ordered":false,"items":[[{"t":"p","s":[{"n":9,"c":[{"t":"text","v":"Configure sampling frequency and downsampling rate."}]}]},{"t":"p","s":[{"n":10,"c":[{"t":"text","v":"In PDM-to-PCM input mode, PDM clock frequency is:"}]}]},{"t":"list","ordered":false,"items":[[{"t":"p","s":[{"n":11,"c":[{"t":"text","v":"in master mode: PDM clock frequency is equal to BCK frequency."}]}]}],[{"t":"p","s":[{"n":12,"c":[{"t":"text","v":"in slave mode: PDM clock is provided by external device."}]}]}]]},{"t":"p","s":[{"n":13,"c":[{"t":"text","v":"The sampling frequency (f_Sampling) is related to PDM clock frequency as follows:"}]}]},{"t":"p","s":[{"n":14,"c":[{"t":"text","v":"f_Sampling = f_PDM / DSR"}]}]},{"t":"p","s":[{"n":15,"c":[{"t":"text","v":"Downsampling rate (DSR) is related to I2S0_RX_PDM_SINC_DSR_16_EN as follows:"}]}]},{"t":"p","s":[{"n":16,"c":[{"t":"text","v":"DSR = I2S0_RX_PDM_SINC_DSR_16_EN × 64"}]}]},{"t":"p","s":[{"n":17,"c":[{"t":"text","v":"Configure the registers according to needed master/slave mode, sampling frequency, and downsampling rate."}]}]}],[{"t":"p","s":[{"n":18,"c":[{"t":"text","v":"Configure valid channels."}]}]},{"t":"p","s":[{"n":19,"c":[{"t":"text","v":"In PDM-to-PCM mode, input signals from eight channels are supported at most."}]},{"n":20,"c":[{"t":"text","v":"See Table 28.10-1 for the register configuration and related channels."}]}]}]]},{"t":"table","caption":"Table 28.10-1. PDM-to-PCM Input Mode","head":[[{"t":"text","v":"Input Data Signal"}],[{"t":"text","v":"Channel"}],[{"t":"text","v":"Enable Register"}]],"rows":[{"n":21,"c":[[{"t":"text","v":"I2S0I_Data_in"}],[{"t":"text","v":"Left channel"}],[{"t":"text","v":"I2S0_RX_TDM_PDM_CHAN0_EN"}]]},{"n":22,"c":[[{"t":"text","v":"I2S0I_Data_in"}],[{"t":"text","v":"Right channel"}],[{"t":"text","v":"I2S0_RX_TDM_PDM_CHAN1_EN"}]]},{"n":23,"c":[[{"t":"text","v":"I2S0I1_Data_in"}],[{"t":"text","v":"Left channel"}],[{"t":"text","v":"I2S0_RX_TDM_PDM_CHAN2_EN"}]]},{"n":24,"c":[[{"t":"text","v":"I2S0I1_Data_in"}],[{"t":"text","v":"Right channel"}],[{"t":"text","v":"I2S0_RX_TDM_PDM_CHAN3_EN"}]]},{"n":25,"c":[[{"t":"text","v":"I2S0I2_Data_in"}],[{"t":"text","v":"Left channel"}],[{"t":"text","v":"I2S0_RX_TDM_PDM_CHAN4_EN"}]]},{"n":26,"c":[[{"t":"text","v":"I2S0I2_Data_in"}],[{"t":"text","v":"Right channel"}],[{"t":"text","v":"I2S0_RX_TDM_PDM_CHAN5_EN"}]]},{"n":27,"c":[[{"t":"text","v":"I2S0I3_Data_in"}],[{"t":"text","v":"Left channel"}],[{"t":"text","v":"I2S0_RX_TDM_PDM_CHAN6_EN"}]]},{"n":28,"c":[[{"t":"text","v":"I2S0I3_Data_in"}],[{"t":"text","v":"Right channel"}],[{"t":"text","v":"I2S0_RX_TDM_PDM_CHAN7_EN"}]]}]}]}