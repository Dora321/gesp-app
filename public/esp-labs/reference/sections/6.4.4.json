{"id":"6.4.4","doc":"T","title":"Simple GPIO Input","words":60,"blocks":[{"t":"p","s":[{"n":1,"c":[{"t":"reg","v":"GPIO_IN_REG"},{"t":"text","v":"/"},{"t":"reg","v":"GPIO_IN1_REG"},{"t":"text","v":" holds the input values of each GPIO pin."}]},{"n":2,"c":[{"t":"text","v":"The input value of any GPIO pin can be read at any time without configuring GPIO matrix for a particular peripheral signal."}]},{"n":3,"c":[{"t":"text","v":"However, it is necessary to enable pin input by setting "},{"t":"field","v":"IO_MUX_FUN_IE"},{"t":"text","v":" in register IO_MUX_"},{"t":"i","c":[{"t":"text","v":"x"}]},{"t":"text","v":"_REG corresponding to pin "},{"t":"i","c":[{"t":"text","v":"X"}]},{"t":"text","v":", as described in "},{"t":"xref","id":"6.4.2","c":[{"t":"text","v":"Section 6.4.2"}]},{"t":"text","v":"."}]}]}]}