{"id":"28.5","doc":"T","title":"Supported Audio Standards","words":90,"blocks":[{"t":"p","s":[{"n":1,"c":[{"t":"text","v":"ESP32-S3 "},{"t":"block","v":"I2S","id":"i2s"},{"t":"i","c":[{"t":"text","v":"n"}]},{"t":"text","v":" supports multiple audio standards, including TDM Philips standard, TDM MSB alignment standard, TDM PCM standard, and PDM standard."}]}]},{"t":"p","s":[{"n":2,"c":[{"t":"text","v":"Select the standard by configuring the following bits:"}]}]},{"t":"list","ordered":false,"items":[[{"t":"p","s":[{"n":3,"c":[{"t":"text","v":"I2S_TX/RX_TDM_EN"}]}]},{"t":"list","ordered":false,"items":[[{"t":"p","s":[{"n":4,"c":[{"t":"text","v":"0: disable TDM mode."}]}]}],[{"t":"p","s":[{"n":5,"c":[{"t":"text","v":"1: enable TDM mode."}]}]}]]}],[{"t":"p","s":[{"n":6,"c":[{"t":"text","v":"I2S_TX/RX_PDM_EN"}]}]},{"t":"list","ordered":false,"items":[[{"t":"p","s":[{"n":7,"c":[{"t":"text","v":"0: disable PDM mode."}]}]}],[{"t":"p","s":[{"n":8,"c":[{"t":"text","v":"1: enable PDM mode."}]}]}]]}],[{"t":"p","s":[{"n":9,"c":[{"t":"text","v":"I2S_TX/RX_MSB_SHIFT"}]}]},{"t":"list","ordered":false,"items":[[{"t":"p","s":[{"n":10,"c":[{"t":"text","v":"0: WS and SD signals change simultaneously, i.e., enable MSB alignment standard."}]}]}],[{"t":"p","s":[{"n":11,"c":[{"t":"text","v":"1: WS signal changes one BCK clock cycle earlier than SD signal, i.e., enable Philips standard or select PCM standard."}]}]}]]}],[{"t":"p","s":[{"n":12,"c":[{"t":"text","v":"I2S_TX/RX_PCM_BYPASS"}]}]},{"t":"list","ordered":false,"items":[[{"t":"p","s":[{"n":13,"c":[{"t":"text","v":"0: enable PCM standard."}]}]}],[{"t":"p","s":[{"n":14,"c":[{"t":"text","v":"1: disable PCM standard."}]}]}]]}]]}]}