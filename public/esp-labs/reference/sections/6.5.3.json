{"id":"6.5.3","doc":"T","title":"Simple GPIO Output","words":88,"blocks":[{"t":"p","s":[{"n":1,"c":[{"t":"text","v":"GPIO matrix can also be used for simple GPIO output."}]},{"n":2,"c":[{"t":"text","v":"This can be done as below:"}]}]},{"t":"list","ordered":false,"items":[[{"t":"p","s":[{"n":3,"c":[{"t":"text","v":"Set GPIO matrix GPIO_FUNC"},{"t":"i","c":[{"t":"text","v":"n"}]},{"t":"text","v":"_OUT_SEL with a special peripheral index 256 (0x100);"}]}]}],[{"t":"p","s":[{"n":4,"c":[{"t":"text","v":"Set the corresponding bit in "},{"t":"reg","v":"GPIO_OUT_REG"},{"t":"text","v":"[31:0] or "},{"t":"reg","v":"GPIO_OUT1_REG"},{"t":"text","v":"[21:0] to the desired GPIO output value."}]}]}]]},{"t":"p","s":[{"n":5,"c":[{"t":"text","v":"Note:"}],"warn":true}]},{"t":"list","ordered":false,"items":[[{"t":"p","s":[{"n":6,"c":[{"t":"reg","v":"GPIO_OUT_REG"},{"t":"text","v":"[21:0] and "},{"t":"reg","v":"GPIO_OUT_REG"},{"t":"text","v":"[31:26] correspond to "},{"t":"pin","v":"GPIO0","n":0},{"t":"text","v":" ~ 21 and "},{"t":"pin","v":"GPIO26","n":26},{"t":"text","v":" ~ 31, respectively."}]},{"n":7,"c":[{"t":"reg","v":"GPIO_OUT_REG"},{"t":"text","v":"[25:22] are invalid."}]}]}],[{"t":"p","s":[{"n":8,"c":[{"t":"reg","v":"GPIO_OUT1_REG"},{"t":"text","v":"[16:0] correspond to "},{"t":"pin","v":"GPIO32","n":32},{"t":"text","v":" ~ 48, and "},{"t":"reg","v":"GPIO_OUT1_REG"},{"t":"text","v":"[21:17] are invalid."}]}]}],[{"t":"p","s":[{"n":9,"c":[{"t":"text","v":"Recommended operation: use corresponding W1TS and W1TC registers, such as "},{"t":"field","v":"GPIO_OUT_W1TS"},{"t":"text","v":"/"},{"t":"field","v":"GPIO_OUT_W1TC"},{"t":"text","v":" to set or clear the registers "},{"t":"reg","v":"GPIO_OUT_REG"},{"t":"text","v":"/"},{"t":"reg","v":"GPIO_OUT1_REG"},{"t":"text","v":"."}]}]}]]}]}