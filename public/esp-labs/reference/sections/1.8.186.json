{"id":"1.8.186","doc":"T","title":"EE.VSL.32","words":125,"blocks":[{"t":"p","s":[{"n":1,"c":[{"t":"b","c":[{"t":"text","v":"Instruction Word"}]},{"t":"text","v":" (bit layout, little-endian bit order)"}]}]},{"t":"table","head":[[{"t":"text","v":"11"}],[{"t":"text","v":"qs[2:1]"}],[{"t":"text","v":"1101"}],[{"t":"text","v":"qs[0]"}],[{"t":"text","v":"01111110"}],[{"t":"text","v":"qa[2:0]"}],[{"t":"text","v":"0100"}]],"rows":[{"n":2,"c":[[{"t":"text","v":"2"}],[{"t":"text","v":"2"}],[{"t":"text","v":"4"}],[{"t":"text","v":"1"}],[{"t":"text","v":"8"}],[{"t":"text","v":"3"}],[{"t":"text","v":"4"}]]}]},{"t":"p","s":[{"n":3,"c":[{"t":"b","c":[{"t":"text","v":"Assembler Syntax"}]}]}]},{"t":"pre","v":"EE.VSL.32 qa, qs","lang":"text"},{"t":"p","s":[{"n":4,"c":[{"t":"b","c":[{"t":"text","v":"Description"}]}]}]},{"t":"p","s":[{"n":5,"c":[{"t":"text","v":"This instruction performs a left shift on the four "},{"t":"num","v":"32-bit","k":"size"},{"t":"text","v":" data segments in register qs respectively."}]},{"n":6,"c":[{"t":"text","v":"The left shift amount is the value in the "},{"t":"num","v":"6-bit","k":"size"},{"t":"text","v":" special register SAR."}]},{"n":7,"c":[{"t":"text","v":"During the shift process, the lower bits are padded with 0."}]},{"n":8,"c":[{"t":"text","v":"The lower 32 bits of the shift result are stored in the corresponding data segment in register qa."}]}]},{"t":"p","s":[{"n":9,"c":[{"t":"b","c":[{"t":"text","v":"Operation"}]}]}]},{"t":"pre","v":"qa[ 31: 0] = (qs[ 31: 0] << SAR[5:0])\nqa[ 63: 32] = (qs[ 63: 32] << SAR[5:0])\nqa[ 95: 64] = (qs[ 95: 64] << SAR[5:0])\nqa[127: 96] = (qs[127: 96] << SAR[5:0])","lang":"text"}]}