{"id":"19.5.6","doc":"T","title":"Block Operation Process","words":248,"blocks":[{"t":"list","ordered":true,"items":[[{"t":"p","s":[{"n":1,"c":[{"t":"text","v":"Select one of DMA channels to connect with "},{"t":"block","v":"AES","id":"crypto"},{"t":"text","v":", configure the DMA chained list, and then start DMA."}]},{"n":2,"c":[{"t":"text","v":"For details, please refer to "},{"t":"xref","id":"3","c":[{"t":"text","v":"Chapter 3"}]},{"t":"text","v":" "},{"t":"i","c":[{"t":"block","v":"GDMA","id":"gdma"},{"t":"text","v":" Controller (GDMA)"}]},{"t":"text","v":"."}]}]}],[{"t":"p","s":[{"n":3,"c":[{"t":"text","v":"Initialize the AES accelerator-related registers:"}]}]},{"t":"list","ordered":false,"items":[[{"t":"p","s":[{"n":4,"c":[{"t":"text","v":"Write 1 to the "},{"t":"reg","v":"AES_DMA_ENABLE_REG"},{"t":"text","v":" register."}]}]}],[{"t":"p","s":[{"n":5,"c":[{"t":"text","v":"Configure the "},{"t":"reg","v":"AES_INT_ENA_REG"},{"t":"text","v":" register to enable or disable the interrupt function."}]}]}],[{"t":"p","s":[{"n":6,"c":[{"t":"text","v":"Initialize registers "},{"t":"reg","v":"AES_MODE_REG"},{"t":"text","v":" and AES_KEY_n_REG."}]}]}],[{"t":"p","s":[{"n":7,"c":[{"t":"text","v":"Select block cipher mode by configuring the "},{"t":"reg","v":"AES_BLOCK_MODE_REG"},{"t":"text","v":" register."}]},{"n":8,"c":[{"t":"text","v":"For details, see Table 19.5-1."}]}]}],[{"t":"p","s":[{"n":9,"c":[{"t":"text","v":"Initialize the "},{"t":"reg","v":"AES_BLOCK_NUM_REG"},{"t":"text","v":" register."}]},{"n":10,"c":[{"t":"text","v":"For details, see Section "},{"t":"xref","id":"19.5.4","c":[{"t":"text","v":"19.5.4"}]},{"t":"text","v":"."}]}]}],[{"t":"p","s":[{"n":11,"c":[{"t":"text","v":"Initialize the "},{"t":"reg","v":"AES_INC_SEL_REG"},{"t":"text","v":" register (only needed when AES Accelerator is working under CTR block operation)."}]}]}],[{"t":"p","s":[{"n":12,"c":[{"t":"text","v":"Initialize the AES_IV_MEM memory (This is always needed except for ECB block operation)."}]}]}]]}],[{"t":"p","s":[{"n":13,"c":[{"t":"text","v":"Start operation by writing 1 to the "},{"t":"reg","v":"AES_TRIGGER_REG"},{"t":"text","v":" register."}]}]}],[{"t":"p","s":[{"n":14,"c":[{"t":"text","v":"Wait for the completion of computation, which happens when the content of "},{"t":"reg","v":"AES_STATE_REG"},{"t":"text","v":" becomes 2 or the AES interrupt occurs."}]}]}],[{"t":"p","s":[{"n":15,"c":[{"t":"text","v":"Check if DMA completes data transmission from AES to memory."}]},{"n":16,"c":[{"t":"text","v":"At this time, DMA had already written the result data in memory, which can be accessed directly."}]},{"n":17,"c":[{"t":"text","v":"For details on DMA, please refer to "},{"t":"xref","id":"3","c":[{"t":"text","v":"Chapter 3"}]},{"t":"text","v":" "},{"t":"i","c":[{"t":"text","v":"GDMA Controller (GDMA)"}]},{"t":"text","v":"."}]}]}],[{"t":"p","s":[{"n":18,"c":[{"t":"text","v":"Clear interrupt by writing 1 to the "},{"t":"reg","v":"AES_INT_CLR_REG"},{"t":"text","v":" register, if any AES interrupt occurred during the computation."}]}]}],[{"t":"p","s":[{"n":19,"c":[{"t":"text","v":"Release the AES Accelerator by writing 0 to the "},{"t":"reg","v":"AES_DMA_EXIT_REG"},{"t":"text","v":" register."}]},{"n":20,"c":[{"t":"text","v":"After this, the content of the "},{"t":"reg","v":"AES_STATE_REG"},{"t":"text","v":" register becomes 0."}]},{"n":21,"c":[{"t":"text","v":"Note that, you can release DMA earlier, but only after Step 4 is completed."}]}]}]]}]}