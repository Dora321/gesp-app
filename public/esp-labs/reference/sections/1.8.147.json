{"id":"1.8.147","doc":"T","title":"EE.VMULAS.S8.ACCX.LD.IP","words":199,"blocks":[{"t":"p","s":[{"n":1,"c":[{"t":"b","c":[{"t":"text","v":"Instruction Word"}]},{"t":"text","v":" (bit layout, little-endian bit order)"}]}]},{"t":"table","head":[[{"t":"text","v":"1111"}],[{"t":"text","v":"imm16[5:4]"}],[{"t":"text","v":"qu[2:1]"}],[{"t":"text","v":"qy[0]"}],[{"t":"text","v":"000"}],[{"t":"text","v":"qu[0]"}],[{"t":"text","v":"010"}],[{"t":"text","v":"qx[1:0]"}],[{"t":"text","v":"qy[2:1]"}],[{"t":"text","v":"imm16[3:0]"}],[{"t":"text","v":"as[3:0]"}],[{"t":"text","v":"111"}],[{"t":"text","v":"qx[2]"}]],"rows":[{"n":2,"c":[[{"t":"text","v":"4"}],[{"t":"text","v":"2"}],[{"t":"text","v":"2"}],[{"t":"text","v":"1"}],[{"t":"text","v":"3"}],[{"t":"text","v":"1"}],[{"t":"text","v":"3"}],[{"t":"text","v":"2"}],[{"t":"text","v":"2"}],[{"t":"text","v":"4"}],[{"t":"text","v":"4"}],[{"t":"text","v":"3"}],[{"t":"text","v":"1"}]]}]},{"t":"p","s":[{"n":3,"c":[{"t":"b","c":[{"t":"text","v":"Assembler Syntax"}]}]}]},{"t":"pre","v":"EE.VMULAS.S8.ACCX.LD.IP qu, as, -512..496, qx, qy","lang":"text"},{"t":"p","s":[{"n":4,"c":[{"t":"b","c":[{"t":"text","v":"Description"}]}]}]},{"t":"p","s":[{"n":5,"c":[{"t":"text","v":"This instruction divides registers qx and qy into 16 data segments by 8 bits."}]},{"n":6,"c":[{"t":"text","v":"Then, it performs a signed multiply-accumulate operation on the 16 sets of segments respectively."}]},{"n":7,"c":[{"t":"text","v":"The accumulated result is added to the value in special register ACCX."}]},{"n":8,"c":[{"t":"text","v":"Then, the sum obtained is saturated and then stored in ACCX."}]},{"n":9,"c":[{"t":"text","v":"During the operation, the lower 4 bits of the access address in register as are forced to be 0, and then the 16-byte data is loaded from the memory to register qu."}]},{"n":10,"c":[{"t":"text","v":"After the access is completed, the value in register as is incremented by "},{"t":"num","v":"6-bit","k":"size"},{"t":"text","v":" sign-extended constant in the instruction code segment left-shifted by 4."}]}]},{"t":"p","s":[{"n":11,"c":[{"t":"b","c":[{"t":"text","v":"Operation"}]}]}]},{"t":"pre","v":"add0[15:0] = qx[ 7: 0] * qy[ 7: 0]\nadd1[15:0] = qx[ 15: 8] * qy[ 15: 8]\n...\nadd15[15:0] = qx[127:120] * qy[127:120]\nsum[40:0] = ACCX[39:0] + ad[31:0]d0[15:0] + ad[31:0]d1[15:0] + ... + ad[31:0]d 15[15:0]\n\nqu[127:0] = load128({as[31:4],4{0}})\nas[31:0] = as[31:0] + {20{imm16[7]},imm16[7:0],4{0}}","lang":"text"}]}