{"id":"1.8.190","doc":"T","title":"EE.VSMULAS.S8.QACC.LD.INCP","words":396,"blocks":[{"t":"p","s":[{"n":1,"c":[{"t":"b","c":[{"t":"text","v":"Instruction Word"}]},{"t":"text","v":" (bit layout, little-endian bit order)"}]}]},{"t":"table","head":[[{"t":"text","v":"111000"}],[{"t":"text","v":"qu[2:1]"}],[{"t":"text","v":"qy[0]"}],[{"t":"text","v":"01"}],[{"t":"text","v":"sel16[0]"}],[{"t":"text","v":"qu[0]"}],[{"t":"text","v":"sel16[3:1]"}],[{"t":"text","v":"qx[1:0]"}],[{"t":"text","v":"qy[2:1]"}],[{"t":"text","v":"1100"}],[{"t":"text","v":"as[3:0]"}],[{"t":"text","v":"111"}],[{"t":"text","v":"qx[2]"}]],"rows":[{"n":2,"c":[[{"t":"text","v":"6"}],[{"t":"text","v":"2"}],[{"t":"text","v":"1"}],[{"t":"text","v":"2"}],[{"t":"text","v":"1"}],[{"t":"text","v":"1"}],[{"t":"text","v":"3"}],[{"t":"text","v":"2"}],[{"t":"text","v":"2"}],[{"t":"text","v":"4"}],[{"t":"text","v":"4"}],[{"t":"text","v":"3"}],[{"t":"text","v":"1"}]]}]},{"t":"p","s":[{"n":3,"c":[{"t":"b","c":[{"t":"text","v":"Assembler Syntax"}]}]}]},{"t":"pre","v":"EE.VSMULAS.S8.QACC.LD.INCP qu, as, qx, qy, sel16","lang":"text"},{"t":"p","s":[{"n":4,"c":[{"t":"b","c":[{"t":"text","v":"Description"}]}]}]},{"t":"p","s":[{"n":5,"c":[{"t":"text","v":"This instruction selects one out of the 16 "},{"t":"num","v":"8-bit","k":"size"},{"t":"text","v":" data segments in register qy according to immediate number sel16 and performs a signed multiplication on it and the 16 "},{"t":"num","v":"8-bit","k":"size"},{"t":"text","v":" data segments in register qx respectively."}]},{"n":6,"c":[{"t":"text","v":"The 16 results obtained are added to the corresponding "},{"t":"num","v":"20-bit","k":"size"},{"t":"text","v":" data segment in special registers QACC_H and QACC_L respectively."}]},{"n":7,"c":[{"t":"text","v":"Then, the result is saturated to a "},{"t":"num","v":"20-bit","k":"size"},{"t":"text","v":" signed number and then stored to the corresponding "},{"t":"num","v":"20-bit","k":"size"},{"t":"text","v":" data segment in QACC_H and QACC_L."}]},{"n":8,"c":[{"t":"text","v":"During the operation, the lower 4 bits of the access address in register as are forced to be 0, and then the 16-byte data is loaded from the memory to register qu."}]},{"n":9,"c":[{"t":"text","v":"After the access, the value in register as is incremented by 16."}]}]},{"t":"p","s":[{"n":10,"c":[{"t":"b","c":[{"t":"text","v":"Operation"}]}]}]},{"t":"pre","v":"temp[7:0] = qy[sel16*8+7:sel16*8]\nQACC_L[ 19: 0] = min(max(QACC_L[ 19: 0] + qx[ 7: 0] * temp[7:0], -2^{19}), 2^{19}-1)\nQACC_L[ 39: 20] = min(max(QACC_L[ 39: 20] + qx[ 15: 8] * temp[7:0], -2^{19}), 2^{19}-1)\nQACC_L[ 59: 40] = min(max(QACC_L[ 59: 40] + qx[ 23: 16] * temp[7:0], -2^{19}), 2^{19}-1)\nQACC_L[ 79: 60] = min(max(QACC_L[ 79: 60] + qx[ 31: 24] * temp[7:0], -2^{19}), 2^{19}-1)\nQACC_L[ 99: 80] = min(max(QACC_L[ 99: 80] + qx[ 39: 32] * temp[7:0], -2^{19}), 2^{19}-1)\nQACC_L[119:100] = min(max(QACC_L[119:100] + qx[ 47: 40] * temp[7:0], -2^{19}), 2^{19}-1)\nQACC_L[139:120] = min(max(QACC_L[139:120] + qx[ 55: 48] * temp[7:0], -2^{19}), 2^{19}-1)\nQACC_L[159:140] = min(max(QACC_L[159:140] + qx[ 63: 56] * temp[7:0], -2^{19}), 2^{19}-1)\nQACC_H[ 19: 0] = min(max(QACC_H[ 19: 0] + qx[ 71: 64] * temp[7:0], -2^{19}), 2^{19}-1)\nQACC_H[ 39: 20] = min(max(QACC_H[ 39: 20] + qx[ 79: 72] * temp[7:0], -2^{19}), 2^{19}-1)\nQACC_H[ 59: 40] = min(max(QACC_H[ 59: 40] + qx[ 87: 80] * temp[7:0], -2^{19}), 2^{19}-1)\nQACC_H[ 79: 60] = min(max(QACC_H[ 79: 60] + qx[ 95: 88] * temp[7:0], -2^{19}), 2^{19}-1)\nQACC_H[ 99: 80] = min(max(QACC_H[ 99: 80] + qx[103: 96] * temp[7:0], -2^{19}), 2^{19}-1)\nQACC_H[119:100] = min(max(QACC_H[119:100] + qx[111:104] * temp[7:0], -2^{19}), 2^{19}-1)\nQACC_H[139:120] = min(max(QACC_H[139:120] + qx[119:112] * temp[7:0], -2^{19}), 2^{19}-1)\nQACC_H[159:140] = min(max(QACC_H[159:140] + qx[127:120] * temp[7:0], -2^{19}), 2^{19}-1)\n\nqu[127:0] = load128({as[31:4],4{0}})\nas[31:0] = as[31:0] + 16","lang":"text"}]}