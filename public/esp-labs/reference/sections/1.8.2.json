{"id":"1.8.2","doc":"T","title":"EE.BITREV","words":325,"blocks":[{"t":"p","s":[{"n":1,"c":[{"t":"b","c":[{"t":"text","v":"Instruction Word"}]},{"t":"text","v":" (bit layout, little-endian bit order)"}]}]},{"t":"table","head":[[{"t":"text","v":"11"}],[{"t":"text","v":"qa[2:1]"}],[{"t":"text","v":"1101"}],[{"t":"text","v":"qa[0]"}],[{"t":"text","v":"1111011"}],[{"t":"text","v":"as[3:0]"}],[{"t":"text","v":"0100"}]],"rows":[{"n":2,"c":[[{"t":"text","v":"2"}],[{"t":"text","v":"2"}],[{"t":"text","v":"4"}],[{"t":"text","v":"1"}],[{"t":"text","v":"7"}],[{"t":"text","v":"4"}],[{"t":"text","v":"4"}]]}]},{"t":"p","s":[{"n":3,"c":[{"t":"b","c":[{"t":"text","v":"Assembler Syntax"}]}]}]},{"t":"pre","v":"EE.BITREV qa, as","lang":"text"},{"t":"p","s":[{"n":4,"c":[{"t":"b","c":[{"t":"text","v":"Description"}]}]}]},{"t":"p","s":[{"n":5,"c":[{"t":"text","v":"This instruction swaps the bit order of data of different bit widths according to the value of special register FFT_BIT_WIDTH."}]},{"n":6,"c":[{"t":"text","v":"Then, it compares the data before and after the swap, takes the larger value, pads the higher bits with 0 until it has 16 bits, and writes the result into the corresponding data segment of register qa."}]},{"n":7,"c":[{"t":"text","v":"In the following, Switchx is a function that represents the bit inversion of the x-bit."}]},{"n":8,"c":[{"t":"text","v":"Switch5(0b10100) = 0b00101."}]},{"n":9,"c":[{"t":"text","v":"Here 0b10100 means "},{"t":"num","v":"5-bit","k":"size"},{"t":"text","v":" binary data."}]}]},{"t":"p","s":[{"n":10,"c":[{"t":"b","c":[{"t":"text","v":"Operation"}]}]}]},{"t":"pre","v":"  temp0[15:0] = as[15:0]\n  temp1[15:0] = as[15:0] + 1\n  temp2[15:0] = as[15:0] + 2\n  temp3[15:0] = as[15:0] + 3\n  temp4[15:0] = as[15:0] + 4\n  temp5[15:0] = as[15:0] + 5\n  temp6[15:0] = as[15:0] + 6\n  temp7[15:0] = as[15:0] + 7\nif FFT_BIT_WIDTH==3:\n  Switch3(X[2:0]) = X[0:2]\n  qa[ 15: 0] = {13’h0, max(tmp0[2:0], Switch3(tmp0[2:0]))}\n  qa[ 31: 16] = {13’h0, max(tmp1[2:0], Switch3(tmp1[2:0]))}\n  qa[ 47: 32] = {13’h0, max(tmp2[2:0], Switch3(tmp2[2:0]))}\n  qa[ 63: 48] = {13’h0, max(tmp3[2:0], Switch3(tmp3[2:0]))}\n  qa[ 79: 64] = {13’h0, max(tmp4[2:0], Switch3(tmp4[2:0]))}\n  qa[ 95: 80] = {13’h0, max(tmp5[2:0], Switch3(tmp5[2:0]))}\n  qa[127: 96] = 0\nif FFT_BIT_WIDTH==4:\n  Switch4(X[3:0]) = X[0:3]\n  qa[ 15: 0] = {12’h0, max(tmp0[3:0], Switch4(tmp0[3:0]))}\n  qa[ 31: 16] = {12’h0, max(tmp1[3:0], Switch4(tmp1[3:0]))}\n  qa[ 47: 32] = {12’h0, max(tmp2[3:0], Switch4(tmp2[3:0]))}\n  qa[ 63: 48] = {12’h0, max(tmp3[3:0], Switch4(tmp3[3:0]))}\n  qa[ 79: 64] = {12’h0, max(tmp4[3:0], Switch4(tmp4[3:0]))}\n  qa[ 95: 80] = {12’h0, max(tmp5[3:0], Switch4(tmp5[3:0]))}\n  qa[111: 96] = {12’h0, max(tmp6[3:0], Switch4(tmp6[3:0]))}\n  qa[127:112] = {12’h0, max(tmp7[3:0], Switch4(tmp7[3:0]))}\n  ...\nif FFT_BIT_WIDTH==10:\n  Switch10(X[9:0]) = X[0:9]\n  qa[ 15: 0] = {6’h0, max(tmp0[9:0], Switch10(tmp0[9:0]))}\n  qa[ 31: 16] = {6’h0, max(tmp1[9:0], Switch10(tmp1[9:0]))}\n  qa[ 47: 32] = {6’h0, max(tmp2[9:0], Switch10(tmp2[9:0]))}\n  qa[ 63: 48] = {6’h0, max(tmp3[9:0], Switch10(tmp3[9:0]))}\n  qa[ 79: 64] = {6’h0, max(tmp4[9:0], Switch10(tmp4[9:0]))}\n  qa[ 95: 80] = {6’h0, max(tmp5[9:0], Switch10(tmp5[9:0]))}\n  qa[111: 96] = {6’h0, max(tmp6[9:0], Switch10(tmp6[9:0]))}\n  qa[127:112] = {6’h0, max(tmp7[9:0], Switch10(tmp7[9:0]))}\n\n  as[31:0] = as[31:0] + 8","lang":"text"}]}