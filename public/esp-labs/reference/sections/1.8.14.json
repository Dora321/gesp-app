{"id":"1.8.14","doc":"T","title":"EE.FFT.R2BF.S16.ST.INCP","words":248,"blocks":[{"t":"p","s":[{"n":1,"c":[{"t":"b","c":[{"t":"text","v":"Instruction Word"}]},{"t":"text","v":" (bit layout, little-endian bit order)"}]}]},{"t":"table","head":[[{"t":"text","v":"11101000"}],[{"t":"text","v":"sar4[0]"}],[{"t":"text","v":"qy[2:0]"}],[{"t":"text","v":"1"}],[{"t":"text","v":"qa0[2:0]"}],[{"t":"text","v":"qx[1:0]"}],[{"t":"text","v":"0"}],[{"t":"text","v":"sar4[1]"}],[{"t":"text","v":"0100"}],[{"t":"text","v":"as[3:0]"}],[{"t":"text","v":"111"}],[{"t":"text","v":"qx[2]"}]],"rows":[{"n":2,"c":[[{"t":"text","v":"8"}],[{"t":"text","v":"1"}],[{"t":"text","v":"3"}],[{"t":"text","v":"1"}],[{"t":"text","v":"3"}],[{"t":"text","v":"2"}],[{"t":"text","v":"1"}],[{"t":"text","v":"1"}],[{"t":"text","v":"4"}],[{"t":"text","v":"4"}],[{"t":"text","v":"3"}],[{"t":"text","v":"1"}]]}]},{"t":"p","s":[{"n":3,"c":[{"t":"b","c":[{"t":"text","v":"Assembler Syntax"}]}]}]},{"t":"pre","v":"EE.FFT.R2BF.S16.ST.INCP qa0, qx, qy, as, 0..3","lang":"text"},{"t":"p","s":[{"n":4,"c":[{"t":"b","c":[{"t":"text","v":"Description"}]}]}]},{"t":"p","s":[{"n":5,"c":[{"t":"text","v":"This instruction performs the radix-2 butterfly operation on the 16-byte values in registers qx and qy, and the data bit width is 16 bits."}]},{"n":6,"c":[{"t":"text","v":"Some of the calculation results are written to register qa0, and others implement an arithmetic shift and are written into the memory address indicated by as."}]},{"n":7,"c":[{"t":"text","v":"After the access is completed, the value in register as is incremented by 16."}]}]},{"t":"p","s":[{"n":8,"c":[{"t":"b","c":[{"t":"text","v":"Operation"}]}]}]},{"t":"pre","v":"qa0[ 15: 0] = qx[ 15: 0] - qy[ 15: 0]\n  qa0[ 31: 16] = qx[ 31: 16] - qy[ 31: 16]\n  qa0[ 47: 32] = qx[ 47: 32] - qy[ 47: 32]\nqa0[ 63: 48] = qx[ 63: 48] - qy[ 63: 48]\n  qa0[ 79: 64] = qx[ 79: 64] - qy[ 79: 64]\n  qa0[ 95: 80] = qx[ 95: 80] - qy[ 95: 80]\nqa0[111: 96] = qx[111: 96] - qy[111: 96]\n  qa0[127:112] = qx[127:112] - qy[127:112]\n\n  {\n  (qx[127:112] + qy[127:112]) >> sar4,\n  (qx[111: 96] + qy[111: 96]) >> sar4,\n  (qx[ 95: 80] + qy[ 95: 80]) >> sar4,\n  (qx[ 79: 64] + qy[ 79: 64]) >> sar4,\n  (qx[ 63: 48] + qy[ 63: 48]) >> sar4,\n(qx[ 47: 32] + qy[ 47: 32]) >> sar4,\n  (qx[ 31: 16] + qy[ 31: 16]) >> sar4,\n  (qx[ 15: 0] + qy[ 15: 0]) >> sar4\n  } => store128({as[31:4],4{0}})\n  as[31:0] = as[31:0] + 16","lang":"text"}]}