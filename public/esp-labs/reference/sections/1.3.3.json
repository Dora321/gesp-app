{"id":"1.3.3","doc":"T","title":"QACC Accumulator Register","words":183,"blocks":[{"t":"p","s":[{"n":1,"c":[{"t":"text","v":"The QACC accumulator register is used for multiplication-accumulation operations on "},{"t":"num","v":"8-bit","k":"size"},{"t":"text","v":" or "},{"t":"num","v":"16-bit","k":"size"},{"t":"text","v":" data."}]},{"n":2,"c":[{"t":"text","v":"In the case of "},{"t":"num","v":"8-bit","k":"size"},{"t":"text","v":" data, QACC consists of 16 accumulator registers with "},{"t":"num","v":"20-bit","k":"size"},{"t":"text","v":" width."}]},{"n":3,"c":[{"t":"text","v":"In the case of "},{"t":"num","v":"16-bit","k":"size"},{"t":"text","v":" data, QACC consists of 8 accumulator registers with "},{"t":"num","v":"40-bit","k":"size"},{"t":"text","v":" width."}]},{"n":4,"c":[{"t":"text","v":"The following description reflects the case of "},{"t":"num","v":"8-bit","k":"size"},{"t":"text","v":" arithmetic."}]},{"n":5,"c":[{"t":"text","v":"For "},{"t":"num","v":"16-bit","k":"size"},{"t":"text","v":" arithmetic, the logic is similar."}]}]},{"t":"p","s":[{"n":6,"c":[{"t":"text","v":"After multiplication and accumulation on two vector QR registers, the result of 16 operations will be written to 16 "},{"t":"num","v":"20-bit","k":"size"},{"t":"text","v":" accumulator registers."}]}]},{"t":"p","s":[{"n":7,"c":[{"t":"text","v":"QACC is divided into two parts: "},{"t":"num","v":"160-bit","k":"size"},{"t":"text","v":" QACC_H and "},{"t":"num","v":"160-bit","k":"size"},{"t":"text","v":" QACC_L."}]},{"n":8,"c":[{"t":"text","v":"The former stores the higher "},{"t":"num","v":"160-bit","k":"size"},{"t":"text","v":" data of QACC, and the latter stores the lower "},{"t":"num","v":"160-bit","k":"size"},{"t":"text","v":" data."}]},{"n":9,"c":[{"t":"text","v":"To store the accumulator result in QR registers, it is possible to convert "},{"t":"num","v":"20-bit","k":"size"},{"t":"text","v":" result numbers to 8 bits by right-shifting it."}]},{"n":10,"c":[{"t":"text","v":"For "},{"t":"num","v":"16-bit","k":"size"},{"t":"text","v":" multiplication-accumulation operation, convert the "},{"t":"num","v":"40-bit","k":"size"},{"t":"text","v":" result to "},{"t":"num","v":"16-bit","k":"size"},{"t":"text","v":" by right-shifting it."}]}]},{"t":"p","s":[{"n":11,"c":[{"t":"text","v":"It is possible to load data from memory to QACC or reset the initial value to 0."}]}]}]}