{"id":"1.8.182","doc":"T","title":"EE.VPRELU.S16","words":169,"blocks":[{"t":"p","s":[{"n":1,"c":[{"t":"b","c":[{"t":"text","v":"Instruction Word"}]},{"t":"text","v":" (bit layout, little-endian bit order)"}]}]},{"t":"table","head":[[{"t":"text","v":"10"}],[{"t":"text","v":"qz[2:1]"}],[{"t":"text","v":"1100"}],[{"t":"text","v":"qz[0]"}],[{"t":"text","v":"qy[2]"}],[{"t":"text","v":"0"}],[{"t":"text","v":"qy[1:0]"}],[{"t":"text","v":"qx[2:0]"}],[{"t":"text","v":"ay[3:0]"}],[{"t":"text","v":"0100"}]],"rows":[{"n":2,"c":[[{"t":"text","v":"2"}],[{"t":"text","v":"2"}],[{"t":"text","v":"4"}],[{"t":"text","v":"1"}],[{"t":"text","v":"1"}],[{"t":"text","v":"1"}],[{"t":"text","v":"2"}],[{"t":"text","v":"3"}],[{"t":"text","v":"4"}],[{"t":"text","v":"4"}]]}]},{"t":"p","s":[{"n":3,"c":[{"t":"b","c":[{"t":"text","v":"Assembler Syntax"}]}]}]},{"t":"pre","v":"EE.VPRELU.S16 qz, qx, qy, ay","lang":"text"},{"t":"p","s":[{"n":4,"c":[{"t":"b","c":[{"t":"text","v":"Description"}]}]}]},{"t":"p","s":[{"n":5,"c":[{"t":"text","v":"This instruction divides register qx into 8 data segments by 16 bits."}]},{"n":6,"c":[{"t":"text","v":"If the value of the segment is not greater than 0, it will be multiplied by the value of the corresponding "},{"t":"num","v":"16-bit","k":"size"},{"t":"text","v":" segment in register qy right-shifted by the lower "},{"t":"num","v":"6-bit","k":"size"},{"t":"text","v":" value in register ay, and then the result obtained will be assigned to the corresponding "},{"t":"num","v":"16-bit","k":"size"},{"t":"text","v":" data segment in register qz."}]},{"n":7,"c":[{"t":"text","v":"Otherwise, the value of the segment in qx will be assigned to qz."}]}]},{"t":"p","s":[{"n":8,"c":[{"t":"b","c":[{"t":"text","v":"Operation"}]}]}]},{"t":"pre","v":"qz[ 15: 0] = (qx[ 15: 0]<=0) ? (qx[ 15: 0] * qy[ 15: 0]) >> ay[5:0] : qx[ 15: 0]\nqz[ 31: 16] = (qx[ 31: 16]<=0) ? (qx[ 31: 16] * qy[ 31: 16]) >> ay[5:0] : qx[ 31: 16]\n...\nqz[127:112] = (qx[127:112]<=0) ? (qx[127:112] * qy[127:112]) >> ay[5:0] : qx [127:112]","lang":"text"}]}