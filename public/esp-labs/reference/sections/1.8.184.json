{"id":"1.8.184","doc":"T","title":"EE.VRELU.S16","words":151,"blocks":[{"t":"p","s":[{"n":1,"c":[{"t":"b","c":[{"t":"text","v":"Instruction Word"}]},{"t":"text","v":" (bit layout, little-endian bit order)"}]}]},{"t":"table","head":[[{"t":"text","v":"11"}],[{"t":"text","v":"qs[2:1]"}],[{"t":"text","v":"1101"}],[{"t":"text","v":"qs[0]"}],[{"t":"text","v":"001"}],[{"t":"text","v":"ax[3:0]"}],[{"t":"text","v":"ay[3:0]"}],[{"t":"text","v":"0100"}]],"rows":[{"n":2,"c":[[{"t":"text","v":"2"}],[{"t":"text","v":"2"}],[{"t":"text","v":"4"}],[{"t":"text","v":"1"}],[{"t":"text","v":"3"}],[{"t":"text","v":"4"}],[{"t":"text","v":"4"}],[{"t":"text","v":"4"}]]}]},{"t":"p","s":[{"n":3,"c":[{"t":"b","c":[{"t":"text","v":"Assembler Syntax"}]}]}]},{"t":"pre","v":"EE.VRELU.S16 qs, ax, ay","lang":"text"},{"t":"p","s":[{"n":4,"c":[{"t":"b","c":[{"t":"text","v":"Description"}]}]}]},{"t":"p","s":[{"n":5,"c":[{"t":"text","v":"This instruction divides register qs into 8 data segments by 16 bits."}]},{"n":6,"c":[{"t":"text","v":"If the value of the segment is not greater than 0, it will be multiplied by the value of the lower 16 bits in register ax and right-shifted by the value of the lower 6 bits in register ay, and then the result obtained will overwrite the value of the segment."}]},{"n":7,"c":[{"t":"text","v":"Otherwise, the value of the segment will remain unchanged."}]}]},{"t":"p","s":[{"n":8,"c":[{"t":"b","c":[{"t":"text","v":"Operation"}]}]}]},{"t":"pre","v":"qs[ 15: 0] = (qs[ 15: 0]<=0) ? (qs[ 15: 0] * ax[15:0]) >> ay[5:0] : qs[ 15: 0]\nqs[ 31: 16] = (qs[ 31: 16]<=0) ? (qs[ 31: 16] * ax[15:0]) >> ay[5:0] : qs[ 31: 16]\n...\nqs[127:112] = (qs[127:112]<=0) ? (qs[127:112] * ax[15:0]) >> ay[5:0] : qs[127:112]","lang":"text"}]}