t":"text","v":"x"}]},{"t":"text","v":"_REG corresponding to GPIO pin "},{"t":"i","c":[{"t":"text","v":"X"}]},{"t":"text","v":" as follows:"}]}]},{"t":"list","ordered":false,"items":[[{"t":"p","s":[{"n":10,"c":[{"t":"text","v":"Set GPIO_PIN"},{"t":"i","c":[{"t":"text","v":"x"}]},{"t":"text","v":"_SYNC1_BYPASS to enable input signal synchronized on rising edge or on falling edge in the first clock, see Figure 6.4-1."}]}]}],[{"t":"p","s":[{"n":11,"c":[{"t":"text","v":"Set GPIO_PIN"},{"t":"i","c":[{"t":"text","v":"x"}]},{"t":"text","v":"_SYNC2_BYPASS to enable input signal synchronized on rising edge or on falling edge in the second clock, see Figure 6.4-1."}]}]}]]}],[{"t":"p","s":[{"n":12,"c":[{"t":"text","v":"Configure IO MUX register to enable pin input."}]},{"n":13,"c":[{"t":"text","v":"For this end, please set IO_MUX_"},{"t":"i","c":[{"t":"text","v":"X"}]},{"t":"text","v":"_REG corresponding to GPIO pin "},{"t":"i","c":[{"t":"text","v":"x"}]},{"t":"text","v":" as follows:"}]}]},{"t":"list","ordered":false,"items":[[{"t":"p","s":[{"n":14,"c":[{"t":"text","v":"Set "},{"t":"field","v":"IO_MUX_FUN_IE"},{"t":"text","v":" to enable input (see note 2 below)."}]}]}],[{"t":"p","s":[{"n":15,"c":[{"t":"text","v":"Set or clear "},{"t":"field","v":"IO_MUX_FUN_WPU"},{"t":"text","v":" and "},{"t":"field","v":"IO_MUX_FUN_WPD"},{"t":"text","v":", as desired, to enable or disable pull-up and pull-down resistors."}]}]}]]}]]},{"t":"p","s":[{"n":16,"c":[{"t":"text","v":"For example, to connect "},{"t":"block","v":"RMT","id":"rmt"},{"t":"text","v":" channel 0 input signal (see note 3 below) (rmt_sig_in0, signal index 81) to "},{"t":"pin","v":"GPIO40","n":40},{"t":"text","v":", please follow the steps below."}]},{"n":17,"c":[{"t":"text","v":"Note that "},{"t":"pin","v":"GPIO40","n":40},{"t":"text","v":" is also named as MTDO pin."}]}]},{"t":"list","ordered":true,"items":[[{"t":"p","s":[{"n":18,"c":[{"t":"text","v":"Set GPIO_SIG81_IN_SEL in register "},{"t":"reg","v":"GPIO_FUNC81_IN_SEL_C