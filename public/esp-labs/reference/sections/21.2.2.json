{"id":"21.2.2","doc":"T","title":"Downstream JTAG Enable Mode","words":181,"blocks":[{"t":"p","s":[{"n":1,"c":[{"t":"text","v":"There are two parameters in the "},{"t":"block","v":"eFuse","id":"efuse"},{"t":"text","v":" memory to disable JTAG debugging, namely "},{"t":"field","v":"EFUSE_DIS_PAD_JTAG"},{"t":"text","v":" and "},{"t":"field","v":"EFUSE_SOFT_DIS_JTAG"},{"t":"text","v":"."}]},{"n":2,"c":[{"t":"text","v":"Set "},{"t":"field","v":"EFUSE_DIS_PAD_JTAG"},{"t":"text","v":" to 1 can disable JTAG permanently, and set odd numbers of 1 to "},{"t":"field","v":"EFUSE_SOFT_DIS_JTAG"},{"t":"text","v":" can disable JTAG temporarily."}]},{"n":3,"c":[{"t":"text","v":"For more details, please see "},{"t":"xref","id":"5","c":[{"t":"text","v":"Chapter 5"}]},{"t":"text","v":" "},{"t":"i","c":[{"t":"text","v":"eFuse Controller (EFUSE)"}]},{"t":"text","v":"."}]}]},{"t":"p","s":[{"n":4,"c":[{"t":"text","v":"To re-enable the temporarily disabled JTAG, users can follow the steps below:"}]}]},{"t":"list","ordered":true,"items":[[{"t":"p","s":[{"n":5,"c":[{"t":"text","v":"Enable the "},{"t":"block","v":"HMAC","id":"crypto"},{"t":"text","v":" module and enter downstream JTAG enable mode."}]}]}],[{"t":"p","s":[{"n":6,"c":[{"t":"text","v":"Write 1 to the "},{"t":"reg","v":"HMAC_SOFT_JTAG_CTRL_REG"},{"t":"text","v":" register to enter JTAG re-enable compare mode."}]}]}],[{"t":"p","s":[{"n":7,"c":[{"t":"text","v":"Write the "},{"t":"num","v":"256-bit","k":"size"},{"t":"text","v":" HMAC value which is calculated locally from the 32-byte 0x00 using HMAC-SHA-256 algorithm and the pre-generated key to register "},{"t":"reg","v":"HMAC_WR_JTAG_REG"},{"t":"text","v":", in big-endian order of word."}]}]}],[{"t":"p","s":[{"n":8,"c":[{"t":"text","v":"If the HMAC internally calculated value matches the value that user programmed, then JTAG is re-enabled."}]},{"n":9,"c":[{"t":"text","v":"Otherwise, JTAG remains disabled."}]}]}],[{"t":"p","s":[{"n":10,"c":[{"t":"text","v":"JTAG remains in the status as in step 4 until the user writes 1 to register "},{"t":"reg","v":"HMAC_SET_INVALIDATE_JTAG_REG"},{"t":"text","v":" or restart JTAG."}]}]}]]},{"t":"p","s":[{"n":11,"c":[{"t":"text","v":"For detailed steps of this process, please see Section "},{"t":"xref","id":"21.2.6","c":[{"t":"text","v":"21.2.6"}]},{"t":"text","v":"."}]}]}]}