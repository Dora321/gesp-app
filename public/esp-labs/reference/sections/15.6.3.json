{"id":"15.6.3","doc":"T","title":"Interrupt upon Unauthorized Access to External Memory","words":99,"blocks":[{"t":"p","s":[{"n":1,"c":[{"t":"text","v":"ESP32-S3 can be configured to trigger Interrupt upon unauthorized access to external memory, and log the information about this unauthorized access."}]},{"n":2,"c":[{"t":"text","v":"This interrupt corresponds to the "},{"t":"field","v":"SPI_MEM_REJECT_INTR"},{"t":"text","v":" interrupt source described in Table 9.3-1 from "},{"t":"xref","id":"9","c":[{"t":"text","v":"Chapter 9"}]},{"t":"text","v":" Interrupt Matrix (INTERRUPT)."}]}]},{"t":"table","caption":"Table 15.6-3. Interrupt Registers for Unauthorized Access to External Memory","head":[[{"t":"text","v":"Registers"}],[{"t":"text","v":"Bit"}],[{"t":"text","v":"Description"}]],"rows":[{"n":3,"c":[[{"t":"reg","v":"SYSCON_SPI_MEM_PMS_CTRL_REG"}],[{"t":"text","v":"[0]"}],[{"t":"text","v":"Stores exception signal"}]]},{"n":4,"c":[[{"t":"reg","v":"SYSCON_SPI_MEM_PMS_CTRL_REG"}],[{"t":"text","v":"[1]"}],[{"t":"text","v":"Clears exception signal and logged information"}]]},{"n":5,"c":[[{"t":"reg","v":"SYSCON_SPI_MEM_PMS_CTRL_REG"}],[{"t":"text","v":"[2]"}],[{"t":"text","v":"Indicates unauthorized instruction execution"}]]},{"n":6,"c":[[{"t":"reg","v":"SYSCON_SPI_MEM_PMS_CTRL_REG"}],[{"t":"text","v":"[3]"}],[{"t":"text","v":"Indicates unauthorized read"}]]},{"n":7,"c":[[{"t":"reg","v":"SYSCON_SPI_MEM_PMS_CTRL_REG"}],[{"t":"text","v":"[4]"}],[{"t":"text","v":"Indicates unauthorized write"}]]},{"n":8,"c":[[{"t":"reg","v":"SYSCON_SPI_MEM_PMS_CTRL_REG"}],[{"t":"text","v":"[5]"}],[{"t":"text","v":"Indicates overlapping split regions"}]]},{"n":9,"c":[[{"t":"reg","v":"SYSCON_SPI_MEM_PMS_CTRL_REG"}],[{"t":"text","v":"[6]"}],[{"t":"text","v":"Indicates invalid address"}]]}]}]}