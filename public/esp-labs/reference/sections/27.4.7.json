_I2C_SCLK"}]}]}]]},{"t":"p","s":[{"n":12,"c":[{"t":"text","v":"Timing registers below are divided into two groups, depending on the mode in which these registers are active:"}]}]},{"t":"list","ordered":false,"items":[[{"t":"p","s":[{"n":13,"c":[{"t":"text","v":"Master mode only:"}]}]},{"t":"list","ordered":true,"items":[[{"t":"p","s":[{"n":14,"c":[{"t":"field","v":"I2C_SCL_START_HOLD_TIME"},{"t":"text","v":": Specifies the interval between pulling SDA low and pulling SCL low when the master generates a START condition."}]},{"n":15,"c":[{"t":"text","v":"This interval is ("},{"t":"field","v":"I2C_SCL_START_HOLD_TIME"},{"t":"text","v":" +1) in I2C_SCLK cycles."}]},{"n":16,"c":[{"t":"text","v":"This register is active only when the I2C controller works in master mode."}]}]}],[{"t":"p","s":[{"n":17,"c":[{"t":"field","v":"I2C_SCL_LOW_PERIOD"},{"t":"text","v":": Specifies the low period of SCL."}]},{"n":18,"c":[{"t":"text","v":"This period lasts ("},{"t":"field","v":"I2C_SCL_LOW_PERIOD"},{"t":"text","v":" +1) in I2C_SCLK cycles."}]},{"n":19,"c":[{"t":"text","v":"However, it could be extended when SCL is pulled low by peripheral devices or by an END command executed by the I2C controller, or when the clock is stretched."}]},{"n":20,"c":[{"t":"text","v":"This register is active only when the I2C controller works in master mode."}]}]}],[{"t":"p","s":[{"n":21,"c":[{"t":"field","v":"I2C_SCL_WAIT_HIGH_PERIOD"},{"t":"text","v":": Specifies time for SCL to go high in I2C_SCLK cycles."}]},{"n":22,"c":[{"t":"text","v":"Please make sure that SCL could be pulled high within this time period."}]},{"n":23,"c":[{"t":"text","v":"Otherwise, the high period of SCL may be incorrect."}]},{"n":24,"c":[{"t":"text","v":"This register is active only when the I2C controller works in master mode."}]}]}],[{"t":"p","s":[{"n":25,"c":[{"t":"field","v":"I2C_SCL_HIGH_PERIOD"},{"t":"text","v":": Specifies the high period of SCL in I2C_SCLK cycles."}]},{"n":26,"c":[{"t":"text","v":"This register is active only when the I2C controller works in master mode."}]},{"n":27,"c":[{"t":"text","v":"When SCL goes high within ("},{"t":"field","v":"I2C_SCL_WAIT_HIGH_PERIOD"},{"t":"text","v":" + 1) in I2C_SCLK cycles, its frequency is:"}]}]},{"t":"p","s":[{"n":28,"c":[{"t":"text","v":"f_scl = f_I2C_SCLK / ("},{"t":"field","v":"I2C_SCL_LOW_PERIOD"},{"t":"text","v":" + "},{"t":"field","v":"I2C_SCL_HIGH_PERIOD"},{"t":"text","v":" + "},{"t":"field","v":"I2C_SCL_WAIT_HIGH_PERIOD"},{"t":"text","v":" + 3)"}]}]}]]}],[{"t":"p","s":[{"n":29,"c":[{"t":"text","v":"Master mode and slave mode:"}]}]},{"t":"list","ordered":true,"items":[[{"t":"p","s":[{"n":30,"c":[{"t":"field","v":"I2C_SDA_SAMPLE_TIME"},{"t":"text","v":": Specifies the interval between the rising edge of SCL and the level sampling time of SDA."}]},{"n":31,"c":[{"t":"text","v":"It is advised to set a value in the middle of SCL's high period, so as to correctly sample the level of SCL."}]},{"n":32,"c":[{"t":"text","v":"This register is active both in master mode and slave mode."}]}]}],[{"t":"p","s":[{"n":33,"c":[{"t":"field","v":"I2C_SDA_HOLD_TIME"},{"t":"text","v":": Specifies the interval between changing the SDA output level and the falling edge of SCL."}]},{"n":34,"c":[{"t":"text","v":"This register is active both in master mode and slave mode."}]}]}]]}]]},{"t":"p","s":[{"n":35,"c":[{"t":"text","v":"Timing parameters limits corresponding register configuration."}]}]},{"t":"list","ordered":true,"items":[[{"t":"p","s":[{"n":36,"c":[{"t":"text","v":"f_I2C_SCLK / f_SCL > 20"}]}]}],[{"t":"p","s":[{"n":37,"c":[{"t":"text","v":"3 × f_I2C_SCLK ≤ ("},{"t":"field","v":"I2C_SDA_HOLD_TIME"},{"t":"text","v":" − 4) × f_APB_CLK"}]}]}],[{"t":"p","s":[{"n":38,"c":[{"t":"field","v":"I2C_SDA_HOLD_TIME"},{"t":"text","v":" + "},{"t":"field","v":"I2C_SCL_START_HOLD_TIME"},{"t":"text","v":" > SDA_FILTER_THRES + 3"}]}]}],[{"t":"p","s":[{"n":39,"c":[{"t":"field","v":"I2C_SCL_WAIT_HIGH_PERIOD"},{"t":"text","v":" < "},{"t":"field","v":"I2C_SDA_SAMPLE_TIM