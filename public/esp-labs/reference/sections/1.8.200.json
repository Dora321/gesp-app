{"id":"1.8.200","doc":"T","title":"EE.VSUBS.S16.ST.INCP","words":154,"blocks":[{"t":"p","s":[{"n":1,"c":[{"t":"b","c":[{"t":"text","v":"Instruction Word"}]},{"t":"text","v":" (bit layout, little-endian bit order)"}]}]},{"t":"table","head":[[{"t":"text","v":"11101000"}],[{"t":"text","v":"qy[0]"}],[{"t":"text","v":"qv[2:0]"}],[{"t":"text","v":"1"}],[{"t":"text","v":"qa[2:0]"}],[{"t":"text","v":"qx[1:0]"}],[{"t":"text","v":"qy[2:1]"}],[{"t":"text","v":"0001"}],[{"t":"text","v":"as[3:0]"}],[{"t":"text","v":"111"}],[{"t":"text","v":"qx[2]"}]],"rows":[{"n":2,"c":[[{"t":"text","v":"8"}],[{"t":"text","v":"1"}],[{"t":"text","v":"3"}],[{"t":"text","v":"1"}],[{"t":"text","v":"3"}],[{"t":"text","v":"2"}],[{"t":"text","v":"2"}],[{"t":"text","v":"4"}],[{"t":"text","v":"4"}],[{"t":"text","v":"3"}],[{"t":"text","v":"1"}]]}]},{"t":"p","s":[{"n":3,"c":[{"t":"b","c":[{"t":"text","v":"Assembler Syntax"}]}]}]},{"t":"pre","v":"EE.VSUBS.S16.ST.INCP qv, as, qa, qx, qy","lang":"text"},{"t":"p","s":[{"n":4,"c":[{"t":"b","c":[{"t":"text","v":"Description"}]}]}]},{"t":"p","s":[{"n":5,"c":[{"t":"text","v":"This instruction performs a vector subtraction on "},{"t":"num","v":"16-bit","k":"size"},{"t":"text","v":" data."}]},{"n":6,"c":[{"t":"text","v":"Registers qx and qy are the subtrahend and the minuend respectively."}]},{"n":7,"c":[{"t":"text","v":"Then, the 8 results obtained from the calculation are saturated and then written into register qa."}]},{"n":8,"c":[{"t":"text","v":"During the operation, the instruction forces the lower 4 bits of the access address in register as to 0 and stores the value in register qv to memory."}]},{"n":9,"c":[{"t":"text","v":"After the access, the value in register as is incremented by 16."}]}]},{"t":"p","s":[{"n":10,"c":[{"t":"b","c":[{"t":"text","v":"Operation"}]}]}]},{"t":"pre","v":"qa[ 15: 0] = min(max(qx[ 15: 0] - qy[ 15: 0], -2^{15}), 2^{15}-1)\nqa[ 31: 16] = min(max(qx[ 31: 16] - qy[ 31: 16], -2^{15}), 2^{15}-1)\n...\n\nqv[127:0] => store128({as[31:4],4{0}})\nas[31:0] = as[31:0] + 16","lang":"text"}]}