{"id":"1.8.10","doc":"T","title":"EE.FFT.AMS.S16.ST.INCP","words":274,"blocks":[{"t":"p","s":[{"n":1,"c":[{"t":"b","c":[{"t":"text","v":"Instruction Word"}]},{"t":"text","v":" (bit layout, little-endian bit order)"}]}]},{"t":"table","head":[[{"t":"text","v":"10100"}],[{"t":"text","v":"sel2[0]"}],[{"t":"text","v":"qz1[2:1]"}],[{"t":"text","v":"qm[0]"}],[{"t":"text","v":"qv[2:0]"}],[{"t":"text","v":"qz1[0]"}],[{"t":"text","v":"qx[2:0]"}],[{"t":"text","v":"qy[1:0]"}],[{"t":"text","v":"qm[2:1]"}],[{"t":"text","v":"as[3:0]"}],[{"t":"text","v":"at[3:0]"}],[{"t":"text","v":"111"}],[{"t":"text","v":"qy[2]"}]],"rows":[{"n":2,"c":[[{"t":"text","v":"5"}],[{"t":"text","v":"1"}],[{"t":"text","v":"2"}],[{"t":"text","v":"1"}],[{"t":"text","v":"3"}],[{"t":"text","v":"1"}],[{"t":"text","v":"3"}],[{"t":"text","v":"2"}],[{"t":"text","v":"2"}],[{"t":"text","v":"4"}],[{"t":"text","v":"4"}],[{"t":"text","v":"3"}],[{"t":"text","v":"1"}]]}]},{"t":"p","s":[{"n":3,"c":[{"t":"b","c":[{"t":"text","v":"Assembler Syntax"}]}]}]},{"t":"pre","v":"EE.FFT.AMS.S16.ST.INCP qv, qz1, at, as, qx, qy, qm, sel2","lang":"text"},{"t":"p","s":[{"n":4,"c":[{"t":"b","c":[{"t":"text","v":"Description"}]}]}]},{"t":"p","s":[{"n":5,"c":[{"t":"text","v":"It is a dedicated FFT instruction to perform addition, subtraction, multiplication, addition and subtraction, and shift operations on "},{"t":"num","v":"16-bit","k":"size"},{"t":"text","v":" data segments."}]}]},{"t":"p","s":[{"n":6,"c":[{"t":"text","v":"During the operation, the instruction forces the lower 4 bits of the access address in register as to 0, splices the values in registers qv and at into 16-byte data, and stores the spliced result to memory."}]},{"n":7,"c":[{"t":"text","v":"After the access is completed, the value in register as is incremented by 16."}]},{"n":8,"c":[{"t":"text","v":"Besides, the operation result is updated to register at."}]}]},{"t":"p","s":[{"n":9,"c":[{"t":"b","c":[{"t":"text","v":"Operation"}]}]}]},{"t":"pre","v":"  temp0[15:0] = qx[111: 96] + qy[111: 96]\n  temp1[15:0] = qx[127:112] - qy[127:112]\n\nif sel2==0:\n  temp2[15:0] = ((qx[111: 96] - qy[111: 96]) * qm[111: 96] - (qx[127:112] + qy [127:112]) * qm[127:112]) >> SAR[5:0]\n  temp3[15:0] = ((qx[111: 96] - qy[111: 96]) * qm[127:112] + (qx[127:112] + qy [127:112]) * qm[111: 96]) >> SAR[5:0]\n  {qv[ 95: 80] >> 1, qv[ 79: 64] >> 1, qv[ 63: 48] >> 1, qv[ 47: 32] >> 1, qv[ 31: 16] >> 1, qv[ 15: 0] >> 1, at[31: 16] >> 1, at[15:0] >> 1} => store128({as [31:4],4{0}})\nif sel2==1:\n  temp2[15:0] = ((qx[127:112] + qy[127:112]) * qm[127:112] + (qx[111: 96] - qy[111: 96]) * qm[111: 96]) >> SAR[5:0]\n  temp3[15:0] = ((qx[127:112] + qy[127:112]) * qm[111: 96] - (qx[111: 96] - qy[111: 96]) * qm[127:112]) >> SAR[5:0]\n  {qv[ 95: 64], qv[ 63: 32], qv[ 31: 0], at[31:0]} => store128({as[31:4],4{0}})\n\n  temp4[16:0] = temp1[15:0] + temp3[15:0]\n  temp5[16:0] = temp0[15:0] + temp2[15:0]\n  qz1[111: 96] = temp0[15:0] - temp2[15:0]\n  qz1[127:112] = temp3[15:0] - temp1[15:0]\n  at = {temp4[15:0], temp5[15:0]}\n  as[31:0] = as[31:0] +16","lang":"text"}]}