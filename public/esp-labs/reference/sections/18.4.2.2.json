{"id":"18.4.2.2","doc":"T","title":"DMA-SHA Mode Process","words":453,"blocks":[{"t":"p","s":[{"n":1,"c":[{"t":"text","v":"ESP32-S3 "},{"t":"block","v":"SHA","id":"crypto"},{"t":"text","v":" accelerator does not support \"interleaving\" message digest calculation when using the DMA, which means you cannot insert new calculation before the whole DMA-SHA process completes."}],"warn":true},{"n":2,"c":[{"t":"text","v":"In this case, users who need inserted calculation are recommended to divide your message blocks and perform several DMA-SHA calculation, instead of trying to compute all the messages in one go."}]}]},{"t":"p","s":[{"n":3,"c":[{"t":"text","v":"In contrast to the Typical SHA working mode, when the SHA accelerator is working under the DMA-SHA mode, all data read are completed via DMA."}]}]},{"t":"p","s":[{"n":4,"c":[{"t":"text","v":"Therefore, users are required to configure the DMA controller following the description in "},{"t":"xref","id":"3","c":[{"t":"text","v":"Chapter 3"}]},{"t":"text","v":" "},{"t":"i","c":[{"t":"block","v":"GDMA","id":"gdma"},{"t":"text","v":" Controller (GDMA)"}]},{"t":"text","v":"."}]}]},{"t":"p","s":[{"n":5,"c":[{"t":"b","c":[{"t":"text","v":"DMA-SHA process (except SHA-512/t)"}]}]}]},{"t":"list","ordered":true,"items":[[{"t":"p","s":[{"n":6,"c":[{"t":"text","v":"Select a hash algorithm."}]}]},{"t":"list","ordered":false,"items":[[{"t":"p","s":[{"n":7,"c":[{"t":"text","v":"Select a hash algorithm by configuring the "},{"t":"reg","v":"SHA_MODE_REG"},{"t":"text","v":" register."}]},{"n":8,"c":[{"t":"text","v":"For details, please refer to Table 18.3-2."}]}]}]]}],[{"t":"p","s":[{"n":9,"c":[{"t":"text","v":"Configure the "},{"t":"reg","v":"SHA_INT_ENA_REG"},{"t":"text","v":" register to enable or disable interrupt (Set 1 to enable)."}]}]}],[{"t":"p","s":[{"n":10,"c":[{"t":"text","v":"Configure the number of message blocks."}]}]},{"t":"list","ordered":false,"items":[[{"t":"p","s":[{"n":11,"c":[{"t":"text","v":"Write the number of message blocks M to the "},{"t":"reg","v":"SHA_DMA_BLOCK_NUM_REG"},{"t":"text","v":" register."}]}]}]]}],[{"t":"p","s":[{"n":12,"c":[{"t":"text","v":"Start the DMA-SHA calculation."}]}]},{"t":"list","ordered":false,"items":[[{"t":"p","s":[{"n":13,"c":[{"t":"text","v":"If the current DMA-SHA calculation follows a previous calculation, firstly write the message digest from the previous calculation to registers SHA_H_n_REG, then write 1 to register "},{"t":"reg","v":"SHA_DMA_CONTINUE_REG"},{"t":"text","v":" to start SHA accelerator;"}]}]}],[{"t":"p","s":[{"n":14,"c":[{"t":"text","v":"Otherwise, write 1 to register "},{"t":"reg","v":"SHA_DMA_START_REG"},{"t":"text","v":" to start the accelerator."}]}]}]]}],[{"t":"p","s":[{"n":15,"c":[{"t":"text","v":"Wait till the completion of the DMA-SHA calculation, which happens when:"}]}]},{"t":"list","ordered":false,"items":[[{"t":"p","s":[{"n":16,"c":[{"t":"text","v":"The content of "},{"t":"reg","v":"SHA_BUSY_REG"},{"t":"text","v":" register becomes 0, or"}]}]}],[{"t":"p","s":[{"n":17,"c":[{"t":"text","v":"An SHA interrupt occurs."}]},{"n":18,"c":[{"t":"text","v":"In this case, please clear interrupt by writing 1 to the "},{"t":"reg","v":"SHA_INT_CLEAR_REG"},{"t":"text","v":" register."}]}]}]]}],[{"t":"p","s":[{"n":19,"c":[{"t":"text","v":"Obtain the message digest:"}]}]},{"t":"list","ordered":false,"items":[[{"t":"p","s":[{"n":20,"c":[{"t":"text","v":"Read the message digest from registers SHA_H_n_REG."}]}]}]]}]]},{"t":"p","s":[{"n":21,"c":[{"t":"b","c":[{"t":"text","v":"DMA-SHA process for SHA-512/t"}]}]}]},{"t":"list","ordered":true,"items":[[{"t":"p","s":[{"n":22,"c":[{"t":"text","v":"Select a hash algorithm."}]}]},{"t":"list","ordered":false,"items":[[{"t":"p","s":[{"n":23,"c":[{"t":"text","v":"Select SHA-512/t algorithm by configuring the "},{"t":"reg","v":"SHA_MODE_REG"},{"t":"text","v":" register to 7."}]}]}]]}],[{"t":"p","s":[{"n":24,"c":[{"t":"text","v":"Configure the "},{"t":"reg","v":"SHA_INT_ENA_REG"},{"t":"text","v":" register to enable or disable interrupt (Set 1 to enable)."}]}]}],[{"t":"p","s":[{"n":25,"c":[{"t":"text","v":"Calculate the initial hash value."}]}]},{"t":"list","ordered":true,"items":[[{"t":"p","s":[{"n":26,"c":[{"t":"text","v":"Calculate t_string and t_length and initialize "},{"t":"reg","v":"SHA_T_STRING_REG"},{"t":"text","v":" and "},{"t":"reg","v":"SHA_T_LENGTH_REG"},{"t":"text","v":" with the generated t_string and t_length."}]},{"n":27,"c":[{"t":"text","v":"For details, please refer to Section "},{"t":"xref","id":"18.4.1.3","c":[{"t":"text","v":"18.4.1.3"}]},{"t":"text","v":"."}]}]}],[{"t":"p","s":[{"n":28,"c":[{"t":"text","v":"Set the "},{"t":"reg","v":"SHA_START_REG"},{"t":"text","v":" register to 1 to start the SHA accelerator."}]}]}],[{"t":"p","s":[{"n":29,"c":[{"t":"text","v":"Poll register "},{"t":"reg","v":"SHA_BUSY_REG"},{"t":"text","v":" until the content of this register becomes 0, indicating the calculation of initial hash value is completed."}]}]}]]}],[{"t":"p","s":[{"n":30,"c":[{"t":"text","v":"Configure the number of message blocks."}]}]},{"t":"list","ordered":false,"items":[[{"t":"p","s":[{"n":31,"c":[{"t":"text","v":"Write the number of message blocks M to the "},{"t":"reg","v":"SHA_DMA_BLOCK_NUM_REG"},{"t":"text","v":" register."}]}]}]]}],[{"t":"p","s":[{"n":32,"c":[{"t":"text","v":"Start the DMA-SHA calculation."}]}]},{"t":"list","ordered":false,"items":[[{"t":"p","s":[{"n":33,"c":[{"t":"text","v":"Write 1 to register "},{"t":"reg","v":"SHA_DMA_CONTINUE_REG"},{"t":"text","v":" to start the accelerator."}]}]}]]}],[{"t":"p","s":[{"n":34,"c":[{"t":"text","v":"Wait till the completion of the DMA-SHA calculation, which happens when:"}]}]},{"t":"list","ordered":false,"items":[[{"t":"p","s":[{"n":35,"c":[{"t":"text","v":"The content of "},{"t":"reg","v":"SHA_BUSY_REG"},{"t":"text","v":" register becomes 0, or"}]}]}],[{"t":"p","s":[{"n":36,"c":[{"t":"text","v":"An SHA interrupt occurs."}]},{"n":37,"c":[{"t":"text","v":"In this case, please clear i