{"id":"27.5.3.2","doc":"T","title":"Configuration Example","words":367,"blocks":[{"t":"list","ordered":true,"items":[[{"t":"p","s":[{"n":1,"c":[{"t":"text","v":"Set "},{"t":"field","v":"I2C_MS_MODE"},{"t":"text","v":" (master) to 1, and "},{"t":"field","v":"I2C_MS_MODE"},{"t":"text","v":" (slave) to 0."}]}]}],[{"t":"p","s":[{"n":2,"c":[{"t":"text","v":"Set "},{"t":"field","v":"I2C_FIFO_ADDR_CFG_EN"},{"t":"text","v":" (slave) to 1 to enable double addressing mode."}]}]}],[{"t":"p","s":[{"n":3,"c":[{"t":"text","v":"Write 1 to "},{"t":"field","v":"I2C_CONF_UPGATE"},{"t":"text","v":" (master) and "},{"t":"field","v":"I2C_CONF_UPGATE"},{"t":"text","v":" (slave) to synchronize registers."}]}]}],[{"t":"p","s":[{"n":4,"c":[{"t":"text","v":"Configure command registers of "},{"t":"block","v":"I2C","id":"i2c"},{"t":"text","v":"~master~."}]}]}]]},{"t":"table","head":[[{"t":"text","v":"Command register"}],[{"t":"text","v":"op_code"}],[{"t":"text","v":"ack_value"}],[{"t":"text","v":"ack_exp"}],[{"t":"text","v":"ack_check_en"}],[{"t":"text","v":"byte_num"}]],"rows":[{"n":5,"c":[[{"t":"field","v":"I2C_COMMAND0"},{"t":"text","v":" (master)"}],[{"t":"text","v":"RSTART"}],[{"t":"text","v":"—"}],[{"t":"text","v":"—"}],[{"t":"text","v":"—"}],[{"t":"text","v":"—"}]]},{"n":6,"c":[[{"t":"field","v":"I2C_COMMAND1"},{"t":"text","v":" (master)"}],[{"t":"text","v":"WRITE"}],[{"t":"text","v":"ack_value"}],[{"t":"text","v":"ack_exp"}],[{"t":"text","v":"1"}],[{"t":"text","v":"N+2"}]]},{"n":7,"c":[[{"t":"field","v":"I2C_COMMAND2"},{"t":"text","v":" (master)"}],[{"t":"text","v":"STOP"}],[{"t":"text","v":"—"}],[{"t":"text","v":"—"}],[{"t":"text","v":"—"}],[{"t":"text","v":"—"}]]}]},{"t":"list","ordered":true,"start":5,"items":[[{"t":"p","s":[{"n":8,"c":[{"t":"text","v":"Write the address of I2C~slave~ and data to be sent to TX RAM of I2C~master~ in FIFO or non-FIFO mode."}]}]}],[{"t":"p","s":[{"n":9,"c":[{"t":"text","v":"Write the address of I2C~slave~ to "},{"t":"field","v":"I2C_SLAVE_ADDR"},{"t":"text","v":" (slave) in "},{"t":"reg","v":"I2C_SLAVE_ADDR_REG"},{"t":"text","v":" (slave) register."}]}]}],[{"t":"p","s":[{"n":10,"c":[{"t":"text","v":"Write 1 to "},{"t":"field","v":"I2C_CONF_UPGATE"},{"t":"text","v":" (master) and "},{"t":"field","v":"I2C_CONF_UPGATE"},{"t":"text","v":" (slave) to synchronize registers."}]}]}],[{"t":"p","s":[{"n":11,"c":[{"t":"text","v":"Write 1 to "},{"t":"field","v":"I2C_TRANS_START"},{"t":"text","v":" (master) and "},{"t":"field","v":"I2C_TRANS_START"},{"t":"text","v":" (slave) to start transfer."}]}]}],[{"t":"p","s":[{"n":12,"c":[{"t":"text","v":"I2C~slave~ compares the slave address sent by I2C~master~ with its own address in "},{"t":"field","v":"I2C_SLAVE_ADDR"},{"t":"text","v":" (slave)."}]},{"n":13,"c":[{"t":"text","v":"When ack_check_en (master) in I2C~master~'s WRITE command is 1, I2C~master~ checks ACK value each time it sends a byte."}]},{"n":14,"c":[{"t":"text","v":"When ack_check_en (master) is 0, I2C~master~ does not check ACK value and take I2C~slave~ as matching slave by default."}]}]},{"t":"list","ordered":false,"items":[[{"t":"p","s":[{"n":15,"c":[{"t":"text","v":"Match: If the received ACK value matches ack_exp (master) (the expected ACK value), I2C~master~ continues data transfer."}]}]}],[{"t":"p","s":[{"n":16,"c":[{"t":"text","v":"Not match: If the received ACK value does not match ack_exp, I2C~master~ generates an I2C_NACK_INT (master) interrupt and stops data transfer."}]}]}]]}],[{"t":"p","s":[{"n":17,"c":[{"t":"text","v":"I2C~slave~ receives the RX RAM address sent by I2C~master~ and adds the offset."}]}]}],[{"t":"p","s":[{"n":18,"c":[{"t":"text","v":"I2C~master~ sends data, and checks ACK value or not according to ack_check_en (master)."}]}]}],[{"t":"p","s":[{"n":19,"c":[{"t":"text","v":"If data to be sent is larger than "},{"t":"num","v":"32 bytes","k":"size"},{"t":"text","v":", TX RAM of I2C~master~ may wrap around in FIFO mode."}]},{"n":20,"c":[{"t":"text","v":"For details, please refer to "},{"t":"xref","id":"27.4.10","c":[{"t":"text","v":"Section 27.4.10"}]},{"t":"text","v":"."}]}]}],[{"t":"p","s":[{"n":21,"c":[{"t":"text","v":"If data to be received is larger than "},{"t":"num","v":"32 bytes","k":"size"},{"t":"text","v":", you may enable clock stretching by setting "},{"t":"field","v":"I2C_SLAVE_SCL_STRETCH_EN"},{"t":"text","v":" (slave), and clearing "},{"t":"field","v":"I2C_RX_FULL_ACK_LEVEL"},{"t":"text","v":" to 0."}]},{"n":22,"c":[{"t":"text","v":"When RX RAM is full, an I2C_SLAVE_STRETCH_INT (slave) interrupt is generated."}]},{"n":23,"c":[{"t":"text","v":"In this way, I2C~slave~ can hold SCL low, in exchange for more time to read data."}]},{"n":24,"c":[{"t":"text","v":"After software has finished reading, you can set "},{"t":"field","v":"I2C_SLAVE_STRETCH_INT_CLR"},{"t":"text","v":" (slave) to 1 to clear interrupt, and set "},{"t":"field","v":"I2C_SLAVE_SCL_STRETCH_CLR"},{"t":"text","v":" (slave) to release the SCL line."}]}]}],[{"t":"p","s":[{"n":25,"c":[{"t":"text","v":"After data transfer completes, I2C~master~ executes the STOP command, and generates an I2C_TRANS_COMPLETE_INT (master) interrupt."}]}]}]]}]}