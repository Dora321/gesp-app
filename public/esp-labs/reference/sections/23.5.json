{"id":"23.5","doc":"T","title":"Software Process","words":239,"blocks":[{"t":"p","s":[{"n":1,"c":[{"t":"text","v":"When the Manual Encryption block operates, software needs to be involved in the process."}]},{"n":2,"c":[{"t":"text","v":"The steps are as follows:"}]}]},{"t":"list","ordered":true,"items":[[{"t":"p","s":[{"n":3,"c":[{"t":"text","v":"Configure XTS_AES:"}]}]},{"t":"list","ordered":false,"items":[[{"t":"p","s":[{"n":4,"c":[{"t":"text","v":"Set register "},{"t":"reg","v":"XTS_AES_DESTINATION_REG"},{"t":"text","v":" to type = 0."}]}]}],[{"t":"p","s":[{"n":5,"c":[{"t":"text","v":"Set register "},{"t":"reg","v":"XTS_AES_PHYSICAL_ADDRESS_REG"},{"t":"text","v":" to base_addr."}]}]}],[{"t":"p","s":[{"n":6,"c":[{"t":"text","v":"Set register "},{"t":"reg","v":"XTS_AES_LINESIZE_REG"},{"t":"text","v":" to size/32."}]}]}]]},{"t":"p","s":[{"n":7,"c":[{"t":"text","v":"For definitions of type, base_addr and size, please refer to Section "},{"t":"xref","id":"23.4.3","c":[{"t":"text","v":"23.4.3"}]},{"t":"text","v":"."}]}]}],[{"t":"p","s":[{"n":8,"c":[{"t":"text","v":"Pad plaintext data to the registers block XTS_AES_PLAIN_n_REG (n: 0-15)."}]},{"n":9,"c":[{"t":"text","v":"For detailed information, please refer to Section "},{"t":"xref","id":"23.4.4","c":[{"t":"text","v":"23.4.4"}]},{"t":"text","v":"."}]}]},{"t":"p","s":[{"n":10,"c":[{"t":"text","v":"Please pad data to registers according to your actual needs, and the unused ones could be set to arbitrary values."}]}]}],[{"t":"p","s":[{"n":11,"c":[{"t":"text","v":"Wait for Manual Encrypt block to be idle."}]},{"n":12,"c":[{"t":"text","v":"Poll register "},{"t":"reg","v":"XTS_AES_STATE_REG"},{"t":"text","v":" until the software reads 0."}]}]}],[{"t":"p","s":[{"n":13,"c":[{"t":"text","v":"Trigger manual encryption by writing 1 to register "},{"t":"reg","v":"XTS_AES_TRIGGER_REG"},{"t":"text","v":"."}]}]}],[{"t":"p","s":[{"n":14,"c":[{"t":"text","v":"Wait for the encryption process."}]},{"n":15,"c":[{"t":"text","v":"Poll register "},{"t":"reg","v":"XTS_AES_STATE_REG"},{"t":"text","v":" until the software reads 2."}]}]},{"t":"p","s":[{"n":16,"c":[{"t":"text","v":"Step 1 to 5 are the steps of encrypting plaintext instructions with the Manual Encryption block using the Key."}]}]}],[{"t":"p","s":[{"n":17,"c":[{"t":"text","v":"Grant the ciphertext access to "},{"t":"block","v":"SPI1","id":"spi"},{"t":"text","v":"."}]},{"n":18,"c":[{"t":"text","v":"Write 1 to register "},{"t":"reg","v":"XTS_AES_RELEASE_REG"},{"t":"text","v":" to grant SPI1 the access to the encrypted ciphertext."}]},{"n":19,"c":[{"t":"text","v":"After this, the value of register "},{"t":"reg","v":"XTS_AES_STATE_REG"},{"t":"text","v":" will become 3."}]}]}],[{"t":"p","s":[{"n":20,"c":[{"t":"text","v":"Call SPI1 to write the ciphertext in the external flash (see "},{"t":"xref","id":"30","c":[{"t":"text","v":"Chapter 30"}]},{"t":"text","v":" "},{"t":"i","c":[{"t":"text","v":"SPI Controller (SPI)"}]},{"t":"text","v":")."}]}]}],[{"t":"p","s":[{"n":21,"c":[{"t":"text","v":"Destroy the ciphertext."}]},{"n":22,"c":[{"t":"text","v":"Write 1 to register "},{"t":"reg","v":"XTS_AES_DESTROY_REG"},{"t":"text","v":"."}]},{"n":23,"c":[{"t":"text","v":"After this, the value of register "},{"t":"reg","v":"XTS_AES_STATE_REG"},{"t":"text","v":" will become 0."}]}]}]]},{"t":"p","s":[{"n":24,"c":[{"t":"text","v":"Repeat above steps to meet plaintext instructions/data encryption demands."}]}]}]}