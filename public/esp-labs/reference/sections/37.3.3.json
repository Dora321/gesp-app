{"id":"37.3.3","doc":"T","title":"Clock","words":136,"blocks":[{"t":"p","s":[{"n":1,"c":[{"t":"text","v":"The clock source of "},{"t":"block","v":"RMT","id":"rmt"},{"t":"text","v":" can be APB_CLK, "},{"t":"field","v":"RC_FAST_CLK"},{"t":"text","v":", or "},{"t":"field","v":"XTAL_CLK"},{"t":"text","v":", depending on the configuration of "},{"t":"field","v":"RMT_SCLK_SEL"},{"t":"text","v":"."}]},{"n":2,"c":[{"t":"text","v":"RMT clock can be enabled by setting "},{"t":"field","v":"RMT_SCLK_ACTIVE"},{"t":"text","v":"."}]},{"n":3,"c":[{"t":"text","v":"RMT working clock is obtained by dividing the selected clock source with a fractional divider, see Figure 37.3-1."}]},{"n":4,"c":[{"t":"text","v":"The divider is:"}]}]},{"t":"p","s":[{"n":5,"c":[{"t":"field","v":"RMT_SCLK_DIV_NUM"},{"t":"text","v":" + 1 + "},{"t":"field","v":"RMT_SCLK_DIV_A"},{"t":"text","v":" / "},{"t":"field","v":"RMT_SCLK_DIV_B"}]}]},{"t":"p","s":[{"n":6,"c":[{"t":"text","v":"For more information, see "},{"t":"xref","id":"7","c":[{"t":"text","v":"Chapter 7"}]},{"t":"text","v":" "},{"t":"i","c":[{"t":"text","v":"Reset and Clock"}]},{"t":"text","v":"."}]},{"n":7,"c":[{"t":"text","v":"RMT_DIV_CNT_CH"},{"t":"i","c":[{"t":"text","v":"n"}]},{"t":"text","v":"/"},{"t":"i","c":[{"t":"text","v":"m"}]},{"t":"text","v":" is used to configure the divider coefficient of internal clock divider for RMT channels."}]},{"n":8,"c":[{"t":"text","v":"The coefficient is normally equal to the value of RMT_DIV_CNT_CH"},{"t":"i","c":[{"t":"text","v":"n"}]},{"t":"text","v":"/"},{"t":"i","c":[{"t":"text","v":"m"}]},{"t":"text","v":", except value 0 that represents divider 256."}]},{"n":9,"c":[{"t":"text","v":"The clock divider can be reset by setting RMT_REF_CNT_RST_CH"},{"t":"i","c":[{"t":"text","v":"n"}]},{"t":"text","v":"/"},{"t":"i","c":[{"t":"text","v":"m"}]},{"t":"text","v":"."}]},{"n":10,"c":[{"t":"text","v":"The clock generated from the divider can be used by the counter (see Figure 37.3-1)."}]}]}]}