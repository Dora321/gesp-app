text","v":"0x3FCD_4000"}],[{"t":"text","v":"0x3FCD_FFFF"}],[{"t":"text","v":"Bit7"}]]},{"n":30,"c":[[{"t":"text","v":"SRAM Block8"}],[{"t":"text","v":"0x403D_0000"}],[{"t":"text","v":"0x403D_BFFF"}],[{"t":"text","v":"0x3FCE_8000"}],[{"t":"text","v":"0x3FCE_FFFF"}],[{"t":"text","v":"Bit8"}]]},{"n":31,"c":[[{"t":"text","v":"SRAM Block9"}],[{"t":"text","v":"-"}],[{"t":"text","v":"-"}],[{"t":"text","v":"0x3FCF_0000"}],[{"t":"text","v":"0x3FCF_7FFF"}],[{"t":"text","v":"Bit9"}]]},{"n":32,"c":[[{"t":"text","v":"SRAM Block10"}],[{"t":"text","v":"-"}],[{"t":"text","v":"-"}],[{"t":"text","v":"0x3FCF_8000"}],[{"t":"text","v":"0x3FCF_FFFF"}],[{"t":"text","v":"Bit10"}]]}]}]}