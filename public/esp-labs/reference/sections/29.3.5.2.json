{"id":"29.3.5.2","doc":"T","title":"Camera Data Format Control","words":281,"blocks":[{"t":"p","s":[{"n":1,"c":[{"t":"text","v":"When the camera module is used to receive data, the bit/byte order of the data to DMA can be adjusted by configuring"}]}]},{"t":"list","ordered":false,"items":[[{"t":"p","s":[{"n":2,"c":[{"t":"field","v":"LCD_CAM_CAM_2BYTE_EN"}]}]},{"t":"list","ordered":false,"items":[[{"t":"p","s":[{"n":3,"c":[{"t":"text","v":"1: Camera input data is in "},{"t":"num","v":"16-bit","k":"size"},{"t":"text","v":" mode."}]}]}],[{"t":"p","s":[{"n":4,"c":[{"t":"text","v":"0: Camera input data is in "},{"t":"num","v":"8-bit","k":"size"},{"t":"text","v":" mode."}]}]}]]}],[{"t":"p","s":[{"n":5,"c":[{"t":"field","v":"LCD_CAM_CAM_BIT_ORDER"}]}]},{"t":"list","ordered":false,"items":[[{"t":"p","s":[{"n":6,"c":[{"t":"text","v":"1: Change data bit order."}]}]},{"t":"list","ordered":false,"items":[[{"t":"p","s":[{"n":7,"c":[{"t":"text","v":"Change CAM_DATA_in[7:0] to CAM_DATA_in[0:7] in "},{"t":"num","v":"8-bit","k":"size"},{"t":"text","v":" mode."}]}]}],[{"t":"p","s":[{"n":8,"c":[{"t":"text","v":"Change CAM_DATA_in[15:0] to CAM_DATA_in[0:15] in "},{"t":"num","v":"16-bit","k":"size"},{"t":"text","v":" mode."}]}]}]]}],[{"t":"p","s":[{"n":9,"c":[{"t":"text","v":"0: Do not change the bit order."}],"warn":true}]}]]}],[{"t":"p","s":[{"n":10,"c":[{"t":"field","v":"LCD_CAM_CAM_BYTE_ORDER"}]}]},{"t":"list","ordered":false,"items":[[{"t":"p","s":[{"n":11,"c":[{"t":"text","v":"1: Invert data byte order, only valid in "},{"t":"num","v":"16-bit","k":"size"},{"t":"text","v":" mode."}]}]}],[{"t":"p","s":[{"n":12,"c":[{"t":"text","v":"0: Do not invert."}],"warn":true}]}]]}]]},{"t":"p","s":[{"n":13,"c":[{"t":"text","v":"For the detailed configuration, see Table 29.3-3."}]}]},{"t":"table","caption":"Table 29.3-3. CAM Data Format Control","head":[[{"t":"text","v":"RX Data (1)"}],[{"t":"text","v":"LCD_CAM_CAM_2BYTE_EN"}],[{"t":"text","v":"LCD_CAM_CAM_BIT_ORDER (2)"}],[{"t":"text","v":"LCD_CAM_CAM_BYTE_ORDER (2)"}],[{"t":"text","v":"Data to DMA (3)(4)"}]],"rows":[{"n":14,"c":[[{"t":"text","v":"{B0}{B1}{B2}{B3}"}],[{"t":"text","v":"0"}],[{"t":"text","v":"0"}],[{"t":"text","v":"0"}],[{"t":"text","v":"B0,B1,B2,B3"}]]},{"n":15,"c":[[{"t":"text","v":"{B0}{B1}{B2}{B3}"}],[{"t":"text","v":"0"}],[{"t":"text","v":"1"}],[{"t":"text","v":"0"}],[{"t":"text","v":"B0',B1',B2',B3'"}]]},{"n":16,"c":[[{"t":"text","v":"{B1,B0}{B3,B2}"}],[{"t":"text","v":"1"}],[{"t":"text","v":"0"}],[{"t":"text","v":"0"}],[{"t":"text","v":"B0,B1,B2,B3"}]]},{"n":17,"c":[[{"t":"text","v":"{B1,B0}{B3,B2}"}],[{"t":"text","v":"1"}],[{"t":"text","v":"0"}],[{"t":"text","v":"1"}],[{"t":"text","v":"B1,B0,B3,B2"}]]},{"n":18,"c":[[{"t":"text","v":"{B1,B0}{B3,B2}"}],[{"t":"text","v":"1"}],[{"t":"text","v":"1"}],[{"t":"text","v":"0"}],[{"t":"text","v":"B0',B1',B2',B3'"}]]},{"n":19,"c":[[{"t":"text","v":"{B1,B0}{B3,B2}"}],[{"t":"text","v":"1"}],[{"t":"text","v":"1"}],[{"t":"text","v":"1"}],[{"t":"text","v":"B1',B0',B3',B2'"}]]}]},{"t":"p","s":[{"n":20,"c":[{"t":"text","v":"(1) In RX data, the bits in {} are in big-endian, and are in parallel with each other, while the data of {} is in serial with the data of other {}."}]},{"n":21,"c":[{"t":"text","v":"Data is received from left to right."}]},{"n":22,"c":[{"t":"text","v":"Take {B0}{B1}{B2}{B3} as an example."}]},{"n":23,"c":[{"t":"text","v":"The bits in {B0} are in parallel with each other, but are in serial with the bits in {B1}{B2}{B3}. {B0} is received first."}]},{"n":24,"c":[{"t":"text","v":"(2) Only the configuration listed in the table is valid."}]},{"n":25,"c":[{"t":"text","v":"Other configuration may cause unexpected data errors."}]},{"n":26,"c":[{"t":"text","v":"(3) B0 ~ B3 represent the bytes of the data to DMA, from low address to high address."}]},{"n":27,"c":[{"t":"text","v":"(4) In the data to DMA, Bn'[7:0] = Bn[0:7] (n = 0,1,2,3)."}]}]},{"t":"p","s":[{"n":28,"c":[{"t":"text","v":"Note: If only one byte is received each time, CAM_Data_in[7:0] is valid data."}],"warn":true},{"n":29,"c":[{"t":"text","v":"For such case, users must connect CAM_Data_in[7:0] with the master."}],"warn":true}]}]}