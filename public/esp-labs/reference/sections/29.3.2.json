{"id":"29.3.2","doc":"T","title":"Signal Description","words":369,"blocks":[{"t":"table","caption":"Table 29.3-1. Signal Description","head":[[{"t":"text","v":"Operation Mode"}],[{"t":"text","v":"Signal (1)"}],[{"t":"text","v":"Direction"}],[{"t":"text","v":"Function"}]],"rows":[{"n":1,"c":[[{"t":"text","v":"Camera Slave RX Mode"}],[{"t":"field","v":"CAM_PCLK"}],[{"t":"text","v":"Input"}],[{"t":"text","v":"Camera pixel clock signal"}]]},{"n":2,"c":[[{"t":"text","v":"Camera Slave RX Mode"}],[{"t":"field","v":"CAM_V_SYNC"}],[{"t":"text","v":"Input"}],[{"t":"text","v":"Vertical synchronization signal (VSYNC) (3)"}]]},{"n":3,"c":[[{"t":"text","v":"Camera Slave RX Mode"}],[{"t":"field","v":"CAM_H_SYNC"}],[{"t":"text","v":"Input"}],[{"t":"text","v":"Horizontal synchronization signal (HSYNC) (3)"}]]},{"n":4,"c":[[{"t":"text","v":"Camera Slave RX Mode"}],[{"t":"field","v":"CAM_H_ENABLE"}],[{"t":"text","v":"Input"}],[{"t":"text","v":"Horizontal enable signal (DE) (3)"}]]},{"n":5,"c":[[{"t":"text","v":"Camera Slave RX Mode"}],[{"t":"text","v":"CAM_Data_in[N:0] (2)"}],[{"t":"text","v":"Input"}],[{"t":"text","v":"Camera parallel input data bus, 8-/"},{"t":"num","v":"16-bit","k":"size"},{"t":"text","v":" supported"}]]},{"n":6,"c":[[{"t":"text","v":"Camera Master RX Mode"}],[{"t":"field","v":"CAM_PCLK"}],[{"t":"text","v":"Input"}],[{"t":"text","v":"Camera pixel clock input signal"}]]},{"n":7,"c":[[{"t":"text","v":"Camera Master RX Mode"}],[{"t":"text","v":"CAM_CLK"}],[{"t":"text","v":"Output"}],[{"t":"text","v":"Camera master clock output signal"}]]},{"n":8,"c":[[{"t":"text","v":"Camera Master RX Mode"}],[{"t":"field","v":"CAM_V_SYNC"}],[{"t":"text","v":"Input"}],[{"t":"text","v":"Vertical synchronization signal (3)"}]]},{"n":9,"c":[[{"t":"text","v":"Camera Master RX Mode"}],[{"t":"field","v":"CAM_H_SYNC"}],[{"t":"text","v":"Input"}],[{"t":"text","v":"Horizontal synchronization signal (3)"}]]},{"n":10,"c":[[{"t":"text","v":"Camera Master RX Mode"}],[{"t":"field","v":"CAM_H_ENABLE"}],[{"t":"text","v":"Input"}],[{"t":"text","v":"Horizontal enable signal (3)"}]]},{"n":11,"c":[[{"t":"text","v":"Camera Master RX Mode"}],[{"t":"text","v":"CAM_Data_in[N:0] (2)"}],[{"t":"text","v":"Input"}],[{"t":"text","v":"Camera parallel input data bus, 8-/"},{"t":"num","v":"16-bit","k":"size"},{"t":"text","v":" supported"}]]},{"n":12,"c":[[{"t":"text","v":"LCD Master TX Mode"}],[{"t":"text","v":"LCD_PCLK"}],[{"t":"text","v":"Output"}],[{"t":"text","v":"LCD pixel clock signal"}]]},{"n":13,"c":[[{"t":"text","v":"LCD Master TX Mode"}],[{"t":"text","v":"LCD_H_SYNC"}],[{"t":"text","v":"Output"}],[{"t":"text","v":"Horizontal synchronization signal in RGB format"}]]},{"n":14,"c":[[{"t":"text","v":"LCD Master TX Mode"}],[{"t":"text","v":"LCD_V_SYNC"}],[{"t":"text","v":"Output"}],[{"t":"text","v":"Vertical synchronization signal in RGB mode"}]]},{"n":15,"c":[[{"t":"text","v":"LCD Master TX Mode"}],[{"t":"text","v":"LCD_H_ENABLE"}],[{"t":"text","v":"Output"}],[{"t":"text","v":"Horizontal enable signal in RGB format"}]]},{"n":16,"c":[[{"t":"text","v":"LCD Master TX Mode"}],[{"t":"text","v":"LCD_CD"}],[{"t":"text","v":"Output"}],[{"t":"text","v":"Command and data (CD) signal in I8080 format"}]]},{"n":17,"c":[[{"t":"text","v":"LCD Master TX Mode"}],[{"t":"text","v":"LCD_CS"}],[{"t":"text","v":"Output"}],[{"t":"text","v":"Chip select (CS) signal in I8080/MOTO6800 format"}]]},{"n":18,"c":[[{"t":"text","v":"LCD Master TX Mode"}],[{"t":"text","v":"LCD_Data_out[N:0] (2)"}],[{"t":"text","v":"Output"}],[{"t":"text","v":"LCD parallel output data bus, 8-/"},{"t":"num","v":"16-bit","k":"size"},{"t":"text","v":" supported"}]]}]},{"t":"p","s":[{"n":19,"c":[{"t":"text","v":"(1) All signals of "},{"t":"block","v":"LCD_CAM","id":"lcd-cam"},{"t":"text","v":" must be mapped to the chip's pin via GPIO matrix."}],"warn":true},{"n":20,"c":[{"t":"text","v":"For more information, see "},{"t":"xref","id":"6","c":[{"t":"text","v":"Chapter 6"}]},{"t":"text","v":" "},{"t":"i","c":[{"t":"text","v":"IO MUX and GPIO Matrix (GPIO, IO MUX)"}]},{"t":"text","v":"."}]},{"n":21,"c":[{"t":"text","v":"(2) For the input/output signals with 8 or 16 bit width, N = 7 or 15 respectively."}]},{"n":22,"c":[{"t":"text","v":"(3) If "},{"t":"field","v":"LCD_CAM_CAM_VH_DE_MODE_EN"},{"t":"text","v":" is set, i.e., VSYNC + HSYNC mode is selected, in this mode, the signals of VSYNC, HSYNC and DE are used to control the data."}]},{"n":23,"c":[{"t":"text","v":"For this case, users need to wire the three signal lines."}]},{"n":24,"c":[{"t":"text","v":"If "},{"t":"field","v":"LCD_CAM_CAM_VH_DE_MODE_EN"},{"t":"text","v":" is cleared, i.e., DE mode is selected, the signals of VSYNC and DE are used to control the data."}]},{"n":25,"c":[{"t":"text","v":"For this case, wiring HSYNC signal line is not a must."}],"warn":true},{"n":26,"c":[{"t":"text","v":"But in this case, the YUV-RGB conversion function of camera module is not available."}]}]}]}